---
// Site-wide footer.
---
<footer class="border-t border-[color:var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-wrap items-center justify-between gap-6 text-sm text-[color:var(--color-text-muted)]">
    <div class="flex items-center gap-2">
      <img src="/favicon.svg" alt="" class="w-5 h-5" />
      <span>AgentPKI &middot; v0.1 alpha &middot; Apache 2.0 &middot; 2026</span>
    </div>
    <div class="flex items-center gap-5 flex-wrap">
      <a href="/problem" class="hover:text-[color:var(--color-text)] transition">Problem / Solution</a>
      <a href="/demo" class="hover:text-[color:var(--color-text)] transition">Demo</a>
      <a href="/pricing" class="hover:text-[color:var(--color-text)] transition">Pricing</a>
      <a href="/spec" class="hover:text-[color:var(--color-text)] transition">Spec</a>
      <a href="/check" class="hover:text-[color:var(--color-text)] transition">Verify check</a>
      <a href="/how-verification-works" class="hover:text-[color:var(--color-text)] transition">How it works</a>
      <a href="/privacy" class="hover:text-[color:var(--color-text)] transition">Privacy</a>
      <a href="https://github.com/agentpki" class="hover:text-[color:var(--color-text)] transition">GitHub</a>
      <a href="mailto:hello@agentpki.dev" class="hover:text-[color:var(--color-text)] transition">hello@agentpki.dev</a>
    </div>
  </div>
</footer>
