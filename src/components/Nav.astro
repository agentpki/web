---
// Site-wide sticky nav. The "Sign up free" CTA pill on the right fades in
// once the visitor scrolls past the hero (see scroll handler at the bottom
// of this component).
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header id="site-nav" class="border-b border-[color:var(--color-border)] bg-[color:var(--color-bg)]/70 backdrop-blur-xl sticky top-0 z-50 transition-all">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-medium tracking-tight">
      <img src="/favicon.svg" alt="" class="w-7 h-7" />
      <span>AgentPKI</span>
    </a>
    <nav class="flex items-center gap-3 sm:gap-6 text-sm">
      <a href="/demo" class={`hidden sm:inline transition ${isActive('/demo') ? 'text-[color:var(--color-text)]' : 'text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)]'}`}>Demo</a>
      <a href="/pricing" class={`hidden sm:inline transition ${isActive('/pricing') ? 'text-[color:var(--color-text)]' : 'text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)]'}`}>Pricing</a>
      <a href="/spec/v0.1" class={`transition ${isActive('/spec') ? 'text-[color:var(--color-text)]' : 'text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)]'}`}>Spec</a>
      <a href="https://github.com/agentpki" class="hidden md:inline text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)] transition">GitHub</a>
      <a href="https://dashboard.agentpki.dev"
         class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md border border-[color:var(--color-accent)]/40 text-[color:var(--color-accent-bright)] hover:bg-[color:var(--color-accent)]/10 transition">
        Sign in
      </a>
      <a id="nav-signup-cta"
         href="https://dashboard.agentpki.dev"
         class="opacity-0 pointer-events-none translate-y-1 transition inline-flex items-center gap-1 px-3 py-1.5 rounded-md bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition">
        Sign up free &rarr;
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  // Sticky nav: reveal the "Sign up free" pill once user scrolls past the hero
  (function () {
    const navCta = document.getElementById('nav-signup-cta');
    if (!navCta) return;
    const onScroll = () => {
      const past = window.scrollY > 480;
      navCta.style.opacity = past ? '1' : '0';
      navCta.style.transform = past ? 'translateY(0)' : 'translateY(4px)';
      navCta.style.pointerEvents = past ? 'auto' : 'none';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
