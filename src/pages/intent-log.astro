---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Intent audit log — AgentPKI"
  description="Hash-chained, append-only public ledger of every intent declaration the verifier observes. Witness-friendly, RFC 6962-inspired. Live feed updates every 10 seconds."
>
  <Nav />

  <section class="max-w-none px-2 sm:px-3 lg:px-4 pt-14 pb-6">
    <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">
      v0.3-intent &middot; §6 audit log &middot; live
    </p>
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
      Public intent declarations, hash-chained.
    </h1>
    <p class="text-base sm:text-lg text-[color:var(--color-text-muted)] max-w-3xl mb-3 leading-relaxed">
      Every time an agent declares an intent to the verifier and a site policy is consulted, the verifier writes an entry to this append-only log. Each entry's <code>prev_hash</code> chains back to its predecessor (SHA-256 of canonical JSON, RFC 8785-lite) — anyone can mirror the log and detect tampering.
    </p>
    <p class="text-sm text-[color:var(--color-text-muted)]">
      Inspired by Certificate Transparency (RFC 6962). Witness model: <a href="/spec/v0.3-intent#65-witness-model" class="underline text-[color:var(--color-accent-bright)]">spec §6.5</a>. Privacy: <a href="/spec/v0.3-intent#66-privacy" class="underline text-[color:var(--color-accent-bright)]">§6.6</a> — no tokens, no body content, no IPs, no UAs.
    </p>
  </section>

  <!-- Checkpoint card -->
  <section class="max-w-none px-2 sm:px-3 lg:px-4 pb-6">
    <div class="grid sm:grid-cols-4 gap-4">
      <div class="il-stat">
        <div class="il-stat-key">total entries</div>
        <div id="il-count" class="il-stat-val">—</div>
      </div>
      <div class="il-stat">
        <div class="il-stat-key">last entry</div>
        <div id="il-last-ts" class="il-stat-val">—</div>
      </div>
      <div class="il-stat" style="grid-column: span 2;">
        <div class="il-stat-key">head hash</div>
        <div id="il-head-hash" class="il-stat-val il-stat-val-mono">—</div>
      </div>
    </div>
    <p class="text-xs text-[color:var(--color-text-muted)] mt-2">
      Source: <a href="https://verify.agentpki.dev/v1/intent-log/checkpoint" class="underline">/v1/intent-log/checkpoint</a> &middot;
      raw: <a href="https://verify.agentpki.dev/v1/intent-log" class="underline">/v1/intent-log</a>
    </p>
  </section>

  <!-- Live feed -->
  <section class="max-w-none px-2 sm:px-3 lg:px-4 pb-16">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="text-2xl font-semibold">Recent entries</h2>
      <p class="text-xs text-[color:var(--color-text-muted)]">Auto-refresh every 10s. <button id="il-refresh" class="underline hover:text-[color:var(--color-text)]">refresh now</button></p>
    </div>
    <div id="il-entries" class="space-y-3">
      <div class="il-entry il-entry-loading">Loading entries…</div>
    </div>
  </section>

  <Footer />

  <style is:global>
    .il-stat {
      border: 1px solid var(--color-border);
      border-radius: 0.55rem;
      padding: 0.7rem 0.85rem;
      background: rgba(20,20,30,0.4);
    }
    .il-stat-key {
      font-size: 0.7rem;
      font-family: ui-monospace, monospace;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .il-stat-val {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--color-text);
      margin-top: 0.15rem;
    }
    .il-stat-val-mono {
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      font-weight: 600;
      word-break: break-all;
      line-height: 1.3;
    }

    .il-entry {
      border: 1px solid var(--color-border);
      border-radius: 0.55rem;
      padding: 0.85rem 1rem;
      background: rgba(20,20,30,0.4);
      font-size: 0.85rem;
    }
    .il-entry-loading { color: var(--color-text-muted); font-style: italic; }
    .il-entry-head {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 0.5rem; margin-bottom: 0.4rem; flex-wrap: wrap;
    }
    .il-entry-seq {
      font-family: ui-monospace, monospace;
      color: var(--color-accent-bright);
      font-weight: 700;
    }
    .il-entry-ts {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      font-family: ui-monospace, monospace;
    }
    .il-entry-body { font-family: ui-monospace, monospace; font-size: 0.82rem; color: var(--color-text); }
    .il-entry-body .key { color: var(--color-text-muted); }
    .il-entry-body .val { color: var(--color-text); }
    .il-entry-verdict { padding: 0.1rem 0.4rem; border-radius: 0.25rem; font-size: 0.72rem; font-weight: 700; }
    .il-entry-verdict-allow     { background: rgba(34,197,94,0.18);  color: #4ade80; }
    .il-entry-verdict-deny      { background: rgba(239,68,68,0.18);  color: #f87171; }
    .il-entry-verdict-throttle  { background: rgba(251,191,36,0.18); color: #fbbf24; }
    .il-entry-verdict-other     { background: rgba(167,139,250,0.18); color: var(--color-accent-bright); }
    .il-entry-prev {
      font-family: ui-monospace, monospace;
      font-size: 0.7rem;
      color: var(--color-text-muted);
      margin-top: 0.4rem;
      word-break: break-all;
    }
  </style>

  <script is:inline>
    (function () {
      var REFRESH_MS = 10000;

      function fmtTs(t) {
        if (!t) return '—';
        var d = new Date(t * 1000);
        return d.toLocaleString();
      }

      function verdictClass(v) {
        if (v === 'allow') return 'il-entry-verdict-allow';
        if (v === 'deny') return 'il-entry-verdict-deny';
        if (v === 'throttle') return 'il-entry-verdict-throttle';
        return 'il-entry-verdict-other';
      }

      function escape(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      }

      function render(data) {
        document.getElementById('il-count').textContent = data.head.count;
        document.getElementById('il-last-ts').textContent = fmtTs(data.head.last_ts);
        document.getElementById('il-head-hash').textContent = data.head.head_hash;

        var box = document.getElementById('il-entries');
        if (!data.entries || data.entries.length === 0) {
          box.innerHTML = '<div class="il-entry il-entry-loading">No entries yet. Try minting a token with <code>?intent=monitor</code> and verifying it against <code>agentpki.dev</code>.</div>';
          return;
        }
        // Show newest first
        var sorted = data.entries.slice().sort(function (a, b) { return b.seq - a.seq; });
        box.innerHTML = sorted.map(function (e) {
          return (
            '<div class="il-entry">' +
              '<div class="il-entry-head">' +
                '<span class="il-entry-seq">#' + e.seq + '</span>' +
                '<span class="il-entry-ts">' + fmtTs(e.ts) + '</span>' +
              '</div>' +
              '<div class="il-entry-body">' +
                '<span class="key">agent:</span> <span class="val">' + escape(e.agent_id) + '</span><br>' +
                '<span class="key">issuer:</span> <span class="val">' + escape(e.issuer) + '</span>' +
                '&nbsp; <span class="key">site:</span> <span class="val">' + escape(e.site) + '</span>' +
                '<br><span class="key">declared:</span> <span class="val">[' + (e.intent || []).map(escape).join(', ') + ']</span>' +
                '&nbsp; <span class="il-entry-verdict ' + verdictClass(e.verdict) + '">' + escape(e.verdict) + '</span>' +
                '&nbsp; <span class="key">overall:</span> <span class="val">' + escape(e.intent_overall) + '</span>' +
              '</div>' +
              '<div class="il-entry-prev">prev: ' + escape(e.prev_hash) + '</div>' +
            '</div>'
          );
        }).join('');
      }

      function tick() {
        fetch('https://verify.agentpki.dev/v1/intent-log?limit=50', { cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .then(render)
          .catch(function (e) {
            document.getElementById('il-entries').innerHTML =
              '<div class="il-entry">Failed to load: ' + escape(e.message || 'unknown') + '</div>';
          });
      }

      document.getElementById('il-refresh').addEventListener('click', function (ev) { ev.preventDefault(); tick(); });
      tick();
      setInterval(tick, REFRESH_MS);
    })();
  </script>
</Base>
