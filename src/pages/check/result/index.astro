---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

// One static page serves every /check/result/<id> permalink, via the
// _redirects rule `/check/result/*  /check/result/  200`. The JS at the
// bottom parses the last URL segment as the verification ID and fetches
// the snapshot from verify.agentpki.dev/v1/verification/<id>.
---
<Base>
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <main class="max-w-3xl mx-auto px-6 pt-16 pb-24">

    <div class="back-link">
      <a href="/check" class="text-[color:var(--color-text-muted)] hover:text-[color:var(--color-text)] text-sm">&larr; Check another</a>
    </div>

    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">Shared verification result</h1>
    <p class="text-sm text-[color:var(--color-text-muted)] mb-6">
      This is a snapshot of a verification that was run earlier. Results expire 24 hours after they were stored.
    </p>

    <div id="resultArea" aria-live="polite">
      <div class="skeleton">
        <div class="skel"></div><div class="skel"></div><div class="skel"></div><div class="skel"></div>
      </div>
    </div>

    <p class="text-center mt-12 text-xs text-[color:var(--color-text-dim)]">
      Want to verify something yourself? <a href="/check" class="underline">agentpki.dev/check</a>
    </p>

  </main>

  <Footer />
</Base>

<style>
  .back-link { margin-bottom: 0.75rem; }

  /* Identical card design as /check (kept in sync manually for now) */
  .result-card { border-radius: 12px; border: 2px solid; overflow: hidden; }
  .result-card.verified   { border-color: #4ade80; background: #052e16; }
  .result-card.revoked    { border-color: #f87171; background: #450a0a; }
  .result-card.unverified { border-color: #fbbf24; background: #3a2a05; }
  .result-card.error      { border-color: #f87171; background: #450a0a; }

  .result-header { display: flex; align-items: center; gap: 0.85rem; padding: 1.1rem 1.4rem; border-bottom: 2px solid; font-family: ui-monospace, monospace; }
  .result-card.verified   .result-header { background: rgba(74, 222, 128, 0.18); border-bottom-color: #4ade80; }
  .result-card.revoked    .result-header { background: rgba(248, 113, 113, 0.20); border-bottom-color: #f87171; }
  .result-card.unverified .result-header { background: rgba(251, 191, 36, 0.18); border-bottom-color: #fbbf24; }
  .result-card.error      .result-header { background: rgba(248, 113, 113, 0.18); border-bottom-color: #f87171; }
  .result-icon { font-size: 1.85rem; line-height: 1; flex-shrink: 0; }
  .result-card.verified   .result-icon { color: #86efac; }
  .result-card.revoked    .result-icon { color: #fca5a5; }
  .result-card.unverified .result-icon { color: #fcd34d; }
  .result-card.error      .result-icon { color: #fca5a5; }
  .result-title { margin: 0; font-size: 1.5rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.1; }
  .result-card.verified   .result-title { color: #bbf7d0; }
  .result-card.revoked    .result-title { color: #fecaca; }
  .result-card.unverified .result-title { color: #fde68a; }
  .result-card.error      .result-title { color: #fecaca; }

  .result-body { padding: 1.25rem 1.4rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .result-field { background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 0.7rem 0.95rem 0.8rem; }
  .result-field-label { display: block; font-family: ui-monospace, monospace; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: #c4b5fd; margin-bottom: 0.35rem; }
  .result-field-value { display: block; font-size: 0.95rem; color: #f3f4f6; font-weight: 500; line-height: 1.45; word-break: break-word; overflow-wrap: anywhere; }
  .result-field-value strong { font-weight: 700; }
  .result-field-value code { color: #c4b5fd; background: rgba(167, 139, 250, 0.18); padding: 0.15em 0.5em; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 0.88em; }
  .result-prose { background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 0.85rem 1rem; color: #f3f4f6; font-size: 0.92rem; line-height: 1.55; }
  .result-prose p { margin: 0; }

  .result-card a, .result-footer a {
    color: #c4b5fd !important; text-decoration: underline !important;
    text-decoration-thickness: 2px !important; text-underline-offset: 3px !important;
    font-weight: 600; cursor: pointer !important;
  }
  .result-card a:hover, .result-footer a:hover { color: #ffffff !important; }

  .result-footer { padding: 1rem 1.4rem 1.1rem; background: rgba(0, 0, 0, 0.4); border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.82rem; color: #d1d5db; line-height: 1.6; }
  .result-footer p { margin: 0; }

  .stored-at { margin-top: 1.5rem; font-size: 0.7rem; color: var(--color-text-dim); text-align: center; }

  .skeleton { background: rgba(15,15,18,0.6); border-radius: 0.85rem; padding: 1.5rem; border: 1px solid var(--color-border-bright); }
  .skeleton .skel {
    background: linear-gradient(90deg, rgba(255,255,255,0.04) 25%, rgba(255,255,255,0.08) 50%, rgba(255,255,255,0.04) 75%);
    background-size: 200% 100%; animation: shimmer 1.4s ease-in-out infinite;
    border-radius: 4px; height: 0.85rem; margin: 0.5rem 0;
  }
  .skeleton .skel:nth-child(1) { width: 35%; height: 1.4rem; }
  .skeleton .skel:nth-child(2) { width: 70%; }
  .skeleton .skel:nth-child(3) { width: 55%; }
  .skeleton .skel:nth-child(4) { width: 65%; }
  @keyframes shimmer { to { background-position: -200% 0; } }
</style>

<script is:inline>
(function () {
  const VERIFIER = 'https://verify.agentpki.dev';
  const $ = (id) => document.getElementById(id);

  function escape(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  }
  function fmt(n) { return typeof n === 'number' ? n.toFixed(2) : String(n); }
  function formatTs(s) { if (!s) return '—'; try { return new Date(s * 1000).toLocaleString(); } catch { return '—'; } }
  function field(k, v) { return '<div class="result-field"><span class="result-field-label">' + escape(k) + '</span><span class="result-field-value">' + v + '</span></div>'; }
  function header(icon, title) { return '<header class="result-header"><span class="result-icon" aria-hidden="true">' + icon + '</span><h2 class="result-title">' + escape(title) + '</h2></header>'; }

  function classifyResult(result) {
    if (!result) return 'unverified';
    if (result.verdict === 'allow') return 'verified';
    if (result.verdict === 'deny') {
      const r = result.failure_reason || '';
      if (/revok|expired|malformed|signature_invalid|sig_invalid|no_issuer_key/i.test(r)) return 'revoked';
      return 'unverified';
    }
    return 'unverified';
  }

  function renderResult(snap) {
    const r = snap.result || {};
    const kind = classifyResult(r);
    const p = r.passport || {};
    let inner = '';
    if (kind === 'verified') {
      const scopes = Array.isArray(p.scopes) && p.scopes.length ? p.scopes.join(', ') : '(none declared)';
      inner =
        header('&#9989;', 'Verified') +
        '<div class="result-body">' +
          field('Issuer', '<code>' + escape(p.issuer || '—') + '</code>' + (p.issuer_name ? ' &middot; ' + escape(p.issuer_name) : '')) +
          field('Tier', escape(String(p.tier || '—'))) +
          field('Identity', '<code>' + escape(p.agent_id || '—') + '</code>') +
          field('Scopes', '<code>' + escape(scopes) + '</code>') +
          field('Reputation', 'abuse score: <strong>' + escape(fmt(r.abuse_score || 0)) + '</strong>' + (p.expires_at ? ' &middot; expires ' + formatTs(p.expires_at) : '')) +
          field('Captured', formatTs(snap.stored_at)) +
        '</div>' +
        '<div class="result-footer"><p>Verified means the agent operator has cryptographically proven its identity to AgentPKI. It does <strong>not</strong> mean the agent is endorsed or recommended. <a href="/how-verification-works">Learn more →</a></p></div>';
    } else if (kind === 'revoked') {
      inner =
        header('&#9940;', 'Do Not Trust') +
        '<div class="result-body">' +
          field('Status', '<strong>REVOKED</strong>') +
          field('Reason', '<code>' + escape(r.failure_reason || 'unknown') + '</code>' + (r.failure_detail ? ' &middot; ' + escape(r.failure_detail) : '')) +
          (p.issuer ? field('Issuer', '<code>' + escape(p.issuer) + '</code>') : '') +
          (p.agent_id ? field('Identity', '<code>' + escape(p.agent_id) + '</code>') : '') +
          field('What to do', 'Do not share information with this agent. If you have already interacted, review your account activity.') +
          field('Captured', formatTs(snap.stored_at)) +
        '</div>' +
        '<div class="result-footer"><p>Revocation means a previously verified identity has been canceled. <a href="/how-verification-works">Learn more →</a></p></div>';
    } else {
      inner =
        header('&#9888;', 'Unverified') +
        '<div class="result-body">' +
          '<div class="result-prose"><p>No AgentPKI passport was found for this identifier when the check was performed.</p></div>' +
          field('Input', '<code>' + escape(snap.input || '(unavailable)') + '</code>') +
          field('Captured', formatTs(snap.stored_at)) +
        '</div>' +
        '<div class="result-footer"><p>Most AI agents have not yet registered with AgentPKI. <a href="/how-verification-works">Learn more →</a></p></div>';
    }
    $('resultArea').innerHTML = '<div class="result-card ' + kind + '">' + inner + '</div>' +
      '<p class="stored-at">Stored at ' + formatTs(snap.stored_at) + ' · expires within 24 hours of that time.</p>';
  }

  function renderError(msg) {
    $('resultArea').innerHTML = '<div class="result-card error">' +
      header('&#10006;', 'Not Found') +
      '<div class="result-body"><div class="result-prose"><p>' + escape(msg) + '</p></div></div>' +
      '</div>';
  }

  async function load() {
    const parts = window.location.pathname.split('/').filter(Boolean);
    const id = parts[parts.length - 1];
    if (!id || id === 'result' || !/^[0-9a-f]{8,16}$/i.test(id)) {
      renderError('No verification ID in URL. Use a link of the form /check/result/<id>.');
      return;
    }
    try {
      const res = await fetch(VERIFIER + '/v1/verification/' + encodeURIComponent(id));
      if (res.status === 404) { renderError('This verification result has expired or never existed. Verifications are stored for 24 hours.'); return; }
      if (!res.ok) { renderError('Server returned HTTP ' + res.status); return; }
      const snap = await res.json();
      renderResult(snap);
    } catch (e) {
      renderError("Couldn't reach verify.agentpki.dev: " + (e && e.message ? e.message : e));
    }
  }
  load();
})();
</script>
