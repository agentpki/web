---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Revocation notifications — AgentPKI"
  description="Get pushed the moment any AgentPKI issuer revokes a signing key. Subscribe via webhook (POST) or RSS feed reader (Atom). Real-time fanout from the verifier, debounced 24h per (issuer, kid)."
>
  <Nav />

  <section class="max-w-5xl mx-auto px-6 pt-14 pb-6">
    <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">
      Revocation notifications &middot; v0.2.1
    </p>
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
      Get pushed the moment a key gets revoked.
    </h1>
    <p class="text-base sm:text-lg text-[color:var(--color-text-muted)] max-w-3xl leading-relaxed">
      Two delivery shapes. Either subscribe an HTTP <strong class="text-[color:var(--color-text)]">webhook</strong> and the verifier POSTs you the event seconds after it observes the first revoked-key deny — or point your <strong class="text-[color:var(--color-text)]">RSS/Atom reader</strong> at any issuer's CRL feed. Same data, your pick of push or pull. Debounced per (issuer, kid) for 24 hours so you don't get spammed.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       Webhook subscribe
       ═══════════════════════════════════════════════════════════════ -->
  <section class="max-w-5xl mx-auto px-6 pb-10">
    <div class="grid lg:grid-cols-2 gap-6">
      <div>
        <h2 class="text-2xl font-semibold mb-3">Webhook push</h2>
        <p class="text-[color:var(--color-text-muted)] mb-4 max-w-prose">
          Drop your URL below — we'll POST a JSON event to it every time the verifier sees a previously-unseen revoked_key verdict.
          You get a <code>sub_token</code> back; use it to unsubscribe or trigger a one-off test delivery.
        </p>
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 p-5 mb-4">
          <label for="webhook-url" class="block text-sm text-[color:var(--color-text-muted)] mb-1">Your webhook URL</label>
          <input id="webhook-url" type="url"
            placeholder="https://your-app.example.com/agentpki-revoke"
            class="w-full px-3 py-2 rounded bg-[color:var(--color-bg)] border border-[color:var(--color-border)] text-sm font-mono text-[color:var(--color-text)] focus:outline-none focus:border-[color:var(--color-accent)]" />
          <p class="text-xs text-[color:var(--color-text-muted)] mt-1">https:// only. No localhost / private IPs (SSRF guard).</p>
          <div class="flex flex-wrap gap-2 mt-3">
            <button id="btn-subscribe" class="nt-btn nt-btn-primary">Subscribe</button>
            <button id="btn-test" class="nt-btn nt-btn-secondary" disabled>Send test event</button>
            <button id="btn-unsubscribe" class="nt-btn nt-btn-ghost" disabled>Unsubscribe</button>
          </div>
          <div id="sub-state" class="mt-3 text-xs font-mono text-[color:var(--color-text-muted)]">Not subscribed.</div>
        </div>

        <div class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/30 p-4">
          <p class="text-xs font-mono uppercase text-[color:var(--color-text-muted)] mb-2">Sample event payload</p>
          <pre class="text-xs overflow-x-auto text-[color:var(--color-text)] font-mono">{`{
  "event": "revoked_key",
  "issuer": "demo.agentpki.dev",
  "kid": "demo-2026-q1-rotated",
  "failure_detail": "kid=\\"demo-2026-q1-rotated\\" revoked at 1748390400 (planned_rotation)",
  "observed_at": "2026-06-08T17:19:50Z",
  "verifier_id": "agentpki-verifier-edge"
}`}</pre>
          <p class="text-xs text-[color:var(--color-text-muted)] mt-2">
            Headers: <code>X-AgentPKI-Event</code>, <code>X-AgentPKI-Sub-Token</code>, <code>User-Agent: agentpki-verifier-webhook/0.1</code>
          </p>
        </div>
      </div>

      <!-- ═══════════════════════════════════════════════════════════════
           Atom feed pull
           ═══════════════════════════════════════════════════════════════ -->
      <div>
        <h2 class="text-2xl font-semibold mb-3">Atom feed pull</h2>
        <p class="text-[color:var(--color-text-muted)] mb-4 max-w-prose">
          Add the feed to Feedly, NetNewsWire, your IFTTT chain, or any RSS reader. Each issuer publishes its own CRL feed — subscribe to as many as you care about. Polls are free; no subscription state on our side.
        </p>
        <div class="space-y-3">
          <div class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 p-4">
            <p class="text-sm font-semibold text-[color:var(--color-text)] mb-1">demo.agentpki.dev</p>
            <code class="text-xs font-mono text-[color:var(--color-text-muted)] break-all">https://demo.agentpki.dev/.well-known/agentpki-crl.atom</code>
            <div class="mt-3 flex gap-2">
              <a href="https://demo.agentpki.dev/.well-known/agentpki-crl.atom" target="_blank" rel="noreferrer" class="nt-btn nt-btn-secondary">Subscribe →</a>
              <a href="feed:https://demo.agentpki.dev/.well-known/agentpki-crl.atom" class="nt-btn nt-btn-ghost">Open in reader</a>
            </div>
          </div>
          <div class="rounded-lg border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 p-4">
            <p class="text-sm font-semibold text-[color:var(--color-text)] mb-1">agentpki.dev</p>
            <code class="text-xs font-mono text-[color:var(--color-text-muted)] break-all">https://agentpki.dev/.well-known/agentpki-crl.atom</code>
            <div class="mt-3 flex gap-2">
              <a href="https://agentpki.dev/.well-known/agentpki-crl.atom" target="_blank" rel="noreferrer" class="nt-btn nt-btn-secondary">Subscribe →</a>
              <a href="feed:https://agentpki.dev/.well-known/agentpki-crl.atom" class="nt-btn nt-btn-ghost">Open in reader</a>
            </div>
          </div>
        </div>
        <p class="text-xs text-[color:var(--color-text-muted)] mt-4">
          New issuer comes online? It'll appear in <a href="/issuer-directory" class="underline text-[color:var(--color-accent-bright)]">/issuer-directory</a> with its own feed URL.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       API reference
       ═══════════════════════════════════════════════════════════════ -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <h2 class="text-2xl font-semibold mb-3">API reference</h2>
    <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 p-5">
      <pre class="text-xs sm:text-sm overflow-x-auto"><code class="text-[color:var(--color-text)] font-mono">{`# Subscribe
curl -X POST https://verify.agentpki.dev/v1/notify/subscribe \\
  -H 'content-type: application/json' \\
  -d '{"webhook_url":"https://example.com/hook","events":["revoked_key"]}'

# Fire a test event to confirm your endpoint is wired
curl -X POST https://verify.agentpki.dev/v1/notify/test/<sub_token>

# Unsubscribe
curl -X DELETE https://verify.agentpki.dev/v1/notify/subscribe/<sub_token>

# How many subscribers? (no URLs exposed)
curl https://verify.agentpki.dev/v1/notify/subscribers`}</code></pre>
    </div>
    <p class="text-xs text-[color:var(--color-text-muted)] mt-3">
      Want to filter to only one issuer? Add <code>"issuer":"demo.agentpki.dev"</code> to the subscribe body. Fanout is debounced per (issuer, kid) for 24h.
    </p>
  </section>

  <Footer />

  <style is:global>
    .nt-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.5rem 0.9rem;
      border-radius: 0.45rem;
      font-weight: 600; font-size: 0.85rem;
      border: 1px solid;
      cursor: pointer;
      text-decoration: none;
      transition: opacity 0.15s, transform 0.15s, background 0.15s;
    }
    .nt-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .nt-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .nt-btn-primary {
      background: var(--color-accent); color: white; border-color: var(--color-accent);
    }
    .nt-btn-secondary {
      background: rgba(167,139,250,0.12); color: var(--color-accent-bright); border-color: rgba(167,139,250,0.4);
    }
    .nt-btn-ghost {
      background: transparent; color: var(--color-text-muted); border-color: var(--color-border-bright);
    }
  </style>

  <script is:inline>
    (function () {
      var subToken = null;
      var stateEl = document.getElementById('sub-state');
      var urlEl = document.getElementById('webhook-url');
      var btnSub = document.getElementById('btn-subscribe');
      var btnTest = document.getElementById('btn-test');
      var btnUnsub = document.getElementById('btn-unsubscribe');

      function setState(msg) { stateEl.textContent = msg; }

      btnSub.addEventListener('click', function () {
        var url = urlEl.value.trim();
        if (!url) { setState('Enter a webhook URL first.'); return; }
        setState('Subscribing…');
        fetch('https://verify.agentpki.dev/v1/notify/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ webhook_url: url, events: ['revoked_key'] }),
        })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, body: j }; }); })
          .then(function (res) {
            if (!res.ok) { setState('Error: ' + (res.body.error || 'unknown') + (res.body.detail ? ' · ' + res.body.detail : '')); return; }
            subToken = res.body.sub_token;
            setState('Subscribed · sub_token=' + subToken);
            btnTest.disabled = false;
            btnUnsub.disabled = false;
          })
          .catch(function (e) { setState('Network error: ' + e.message); });
      });

      btnTest.addEventListener('click', function () {
        if (!subToken) return;
        setState('Firing test event to your URL…');
        fetch('https://verify.agentpki.dev/v1/notify/test/' + subToken, { method: 'POST' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            var d = j.delivery || {};
            if (d.ok) {
              setState('Test delivered · ' + d.status + ' in ' + d.duration_ms + 'ms');
            } else {
              setState('Delivery failed: ' + (d.error || 'HTTP ' + d.status) + ' (' + d.duration_ms + 'ms)');
            }
          })
          .catch(function (e) { setState('Test error: ' + e.message); });
      });

      btnUnsub.addEventListener('click', function () {
        if (!subToken) return;
        var t = subToken;
        setState('Unsubscribing ' + t + '…');
        fetch('https://verify.agentpki.dev/v1/notify/subscribe/' + t, { method: 'DELETE' })
          .then(function (r) { return r.json(); })
          .then(function (j) {
            if (j.deleted) {
              subToken = null;
              btnTest.disabled = true;
              btnUnsub.disabled = true;
              setState('Unsubscribed.');
            } else {
              setState('Unsubscribe failed: ' + (j.error || 'unknown'));
            }
          })
          .catch(function (e) { setState('Unsubscribe error: ' + e.message); });
      });
    })();
  </script>
</Base>
