  <script is:inline>
    (function () {
      const DEMO_ISSUER = 'https://demo.agentpki.dev';
      const VERIFIER    = 'https://verify.agentpki.dev';

      // ─── Scenario metadata (text/translation copy mirrors demo-v2-preview.html)
      const scenarios = {
        anthropic: {
          mintPath: '/mint?sub=' + encodeURIComponent('agent:browser-demo/visitor') + '&scope=read:articles&lifetime=300',
          tamper: false,
          translation: 'A site using AgentPKI <b>lets this agent through</b>. The site logs <b>demo.agentpki.dev</b> as the issuer, sees <b>scope: read:articles</b>, grants <b>tier-based trust</b>. Reuters serves the article; Cloudflare\'s bot-defense drops the risk_score from 0.65 to 0.02. Anthropic gets attributed; Reuters gets confidence; the user gets the answer they wanted from Claude.',
          steps: [
            'Issuer SDK signs a PASETO v4 token with its Ed25519 key…',
            'Token attached as an Authorization header on the outbound request to reuters.com/api/article/123',
            'Cloudflare edge at reuters.com forwarded the token to verify.agentpki.dev/v1/verify',
            'Verifier fetched demo.agentpki.dev/.well-known/agentpki-issuer.json (cached), validated signature, checked CRL (fresh)',
            'Verifier returned: verdict ALLOW',
          ],
        },
        tampered: {
          mintPath: '/mint?sub=' + encodeURIComponent('agent:browser-demo/visitor') + '&scope=read:articles&lifetime=300',
          tamper: true,
          translation: 'A site using AgentPKI <b>rejects this request</b>. The signature on the passport is mathematically invalid — the token claims to be from the issuer but the cryptography says otherwise. Cloudflare\'s bot-defense treats this as a strong negative signal: someone is trying to impersonate the issuer. Reuters either serves a CAPTCHA or outright blocks. The imposter learns nothing about Reuters\' content.',
          steps: [
            'Imposter took a real issuer-issued token and flipped one character in the base64 signature…',
            'Sent the modified token to reuters.com (same path as the real bot)',
            'Cloudflare forwarded to verify.agentpki.dev',
            'Verifier fetched issuer\'s public key, ran Ed25519 verify(signature, payload, pubkey)…',
            'verify() returned false. Verdict: NOT_ALLOWED. Reason: signature_invalid.',
          ],
        },
        revoked: {
          mintPath: '/mint?sub=' + encodeURIComponent('agent:browser-demo/visitor') + '&scope=read:articles&lifetime=300&revoked=1',
          tamper: false,
          translation: 'A site using AgentPKI <b>rejects this request</b> even though the signature is mathematically valid. The issuer rotated keys (maybe an employee left, maybe an audit caught something) and listed the old <code>kid</code> in the directory\'s <code>revoked_keys</code> list. The signature on the old token still verifies — Ed25519 doesn\'t care that the key is "supposed to be" retired — but AgentPKI verifiers check the revoked-keys list on every request. The token gets rejected without the issuer having to coordinate with every verifier on the web. This is why short lifetimes + a CRL matter.',
          steps: [
            'Issuer signed a token with a <code>kid</code> it has listed in its <code>revoked_keys</code> directory entry…',
            'Token attached to a fresh request to reuters.com',
            'Cloudflare forwarded to verify.agentpki.dev',
            'Verifier fetched the issuer directory, selected key by kid — found it in <code>revoked_keys</code>',
            'Verdict: NOT_ALLOWED. Reason: revoked_key. Signature was valid — the directory killed it.',
          ],
        },
      };

      // ─── Scenario picker (highlights when clicked)
      document.querySelectorAll('.scenario').forEach(el => {
        el.addEventListener('click', () => {
          document.querySelectorAll('.scenario').forEach(c => c.classList.remove('active'));
          el.classList.add('active');
        });
      });

      // ─── Run button handlers
      const btns = document.querySelectorAll('button[data-run]');
      btns.forEach(btn => {
        btn.addEventListener('click', () => run(btn.dataset.run));
      });

      // Tamper a PASETO token by flipping a char in part-3 (payload+signature).
      const tamperToken = (token) => {
        const parts = token.split('.');
        if (parts.length < 3) return token;
        const p = parts[2];
        if (p.length < 4) return token;
        const idx = p.length - 4;
        const orig = p[idx];
        const swap = orig === 'A' ? 'B' : 'A';
        parts[2] = p.slice(0, idx) + swap + p.slice(idx + 1);
        return parts.join('.');
      };

      const $ = (id) => document.getElementById(id);

      async function run(scenarioId) {
        const s = scenarios[scenarioId];
        if (!s) return;

        // Highlight scenario card
        document.querySelectorAll('.scenario').forEach(c => {
          c.classList.toggle('active', c.dataset.id === scenarioId);
        });

        // Disable all buttons
        btns.forEach(b => b.disabled = true);

        const statusEl = $('status');
        const stepListEl = $('step-list');
        const verdictEl = $('verdict');
        const verdictSvg = $('verdict-svg');
        const translationEl = $('translation');
        statusEl.classList.remove('demo-hidden');
        verdictEl.classList.add('demo-hidden');
        translationEl.classList.add('demo-hidden');
        stepListEl.innerHTML = '';

        try {
          // Pre-step animations for the 3 lead-in steps (visual narrative)
          for (let i = 0; i < 3; i++) {
            const li = document.createElement('li');
            li.innerHTML = '<svg class="step-icon pending" viewBox="0 0 24 24"></svg><span>' + s.steps[i] + '</span>';
            stepListEl.appendChild(li);
            await sleep(180 + Math.random() * 220);
            const icon = li.querySelector('.step-icon');
            icon.outerHTML = '<svg class="step-icon done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
          }

          // ── REAL CALL: mint
          const t0 = performance.now();
          const mintRes = await fetch(DEMO_ISSUER + s.mintPath);
          if (!mintRes.ok) throw new Error('mint failed: HTTP ' + mintRes.status);
          const minted = await mintRes.json();
          const t1 = performance.now();

          // ── REAL CALL: verify
          let tokenToVerify = minted.token;
          if (s.tamper) tokenToVerify = tamperToken(minted.token);

          const verifyRes = await fetch(VERIFIER + '/v1/verify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token: tokenToVerify }),
          });
          const verdict = await verifyRes.json();
          const t2 = performance.now();
          const workerMs = verdict.elapsed_ms ?? '?';
          const wallMs = Math.round(t2 - t0);

          const isAllow = verdict.verdict === 'allow';

          // Final 2 steps (verify + verdict)
          for (let i = 3; i < s.steps.length; i++) {
            const li = document.createElement('li');
            li.innerHTML = '<svg class="step-icon pending" viewBox="0 0 24 24"></svg><span>' + s.steps[i] + '</span>';
            stepListEl.appendChild(li);
            await sleep(160 + Math.random() * 180);
            const icon = li.querySelector('.step-icon');
            const isLast = i === s.steps.length - 1;
            const fail = isLast && !isAllow;
            if (fail) {
              icon.outerHTML = '<svg class="step-icon fail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
            } else {
              icon.outerHTML = '<svg class="step-icon done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
            }
          }

          // Verdict badge
          verdictEl.classList.remove('demo-hidden', 'allow', 'deny');
          verdictEl.classList.add(isAllow ? 'allow' : 'deny');
          $('verdict-text').textContent =
            'VERDICT: ' + (verdict.verdict || 'unknown') + (verdict.failure_reason ? ' · ' + verdict.failure_reason : '');
          $('verdict-time').textContent =
            workerMs + 'ms edge compute · ' + wallMs + 'ms wall-clock';
          verdictSvg.innerHTML = isAllow
            ? '<circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2 4-4"></path>'
            : '<circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>';

          // Translation
          translationEl.classList.remove('demo-hidden');
          $('translation-text').innerHTML = ' ' + s.translation;
        } catch (e) {
          const li = document.createElement('li');
          li.innerHTML = '<svg class="step-icon fail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg><span style="color:#f87171;">Error: ' + ((e && e.message) || String(e)) + '</span>';
          stepListEl.appendChild(li);
        } finally {
          btns.forEach(b => b.disabled = false);
        }
      }

      function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

      // Strip ?run=1 to prevent refresh-loop self-clicks
      const params = new URLSearchParams(window.location.search);
      if (params.get('run') === '1') {
        params.delete('run');
        const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
        window.history.replaceState(null, '', newUrl);
        setTimeout(() => $('btn-anthropic')?.click(), 800);
      }
    })();
  </script>

  <Footer />
  <ContactModal />
