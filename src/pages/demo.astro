---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Base title="Live demo — AgentPKI" description="Mint and verify a real AgentPKI passport in your browser. Runs against our production-deployed Cloudflare Workers.">
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <!-- ─────────── HEADER ─────────── -->
  <section class="border-b border-[color:var(--color-border)]">
    <div class="max-w-4xl mx-auto px-6 pt-16 pb-12 lg:pt-20 lg:pb-16 text-center">
      <p class="inline-flex items-center gap-2 px-3 py-1 mb-5 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur text-xs text-[color:var(--color-text-muted)]">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-green-400"></span>
        </span>
        live on production infrastructure
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-balance">Try AgentPKI <span class="text-green-400">live.</span></h1>
      <p class="mt-5 text-lg text-[color:var(--color-text-muted)] max-w-2xl mx-auto leading-relaxed">
        Click <strong class="text-[color:var(--color-text)]">Run mint → verify</strong>. The button calls our demo issuer to sign a fresh passport, then ships that passport to our edge verifier. Both are real production Cloudflare Workers — no mock, no replay.
      </p>
    </div>
  </section>

  <!-- ─────────── DEMO CARD ─────────── -->
  <section>
    <div class="max-w-3xl mx-auto px-6 py-12">
      <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur-sm p-6 sm:p-8">
        <!-- Header row -->
        <div class="flex flex-col gap-4">
          <div class="text-xs sm:text-sm text-[color:var(--color-text-muted)] font-mono break-all">
            <code>demo.agentpki.dev/mint</code>
            <span class="mx-2 text-[color:var(--color-text-dim)]">&rarr;</span>
            <code>verify.agentpki.dev/v1/verify</code>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button id="try-run"
                    class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition disabled:opacity-60 disabled:cursor-not-allowed shrink-0">
              <svg id="try-icon-play" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4l10 6-10 6z"/></svg>
              <svg id="try-icon-spin" class="w-4 h-4 hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                <circle cx="10" cy="10" r="7" stroke-width="2.5" stroke-dasharray="44" stroke-dashoffset="22" stroke-linecap="round" class="origin-center">
                  <animateTransform attributeName="transform" type="rotate" from="0 10 10" to="360 10 10" dur="0.9s" repeatCount="indefinite"/>
                </circle>
              </svg>
              <span id="try-label">Run mint &rarr; verify</span>
            </button>
            <button id="try-tamper"
                    class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-red-500/40 text-red-300 bg-red-500/5 hover:bg-red-500/10 hover:border-red-500/60 transition disabled:opacity-60 disabled:cursor-not-allowed shrink-0 text-sm">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
              <span id="try-tamper-label">Try with tampered token</span>
            </button>
          </div>
          <p class="text-xs text-[color:var(--color-text-dim)]">
            <strong class="text-[color:var(--color-text-muted)]">Tampered token</strong>: we mint a valid passport, then flip a character in the signature before sending it to the verifier. Demonstrates the <em>not allowed</em> path with a real rejection.
          </p>
        </div>

        <!-- Live step status — populated by JS as the demo runs -->
        <div id="try-steps" class="hidden mt-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/40 p-4">
          <div class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-2">Live status</div>
          <ul id="try-steps-list" class="space-y-1.5 text-sm font-mono"></ul>
        </div>

        <div id="try-results" class="mt-6 space-y-4 hidden">
          <!-- Step 1: mint result -->
          <div id="try-mint" class="hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/80 p-5">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold">01</span>
                <span class="font-semibold text-sm tracking-tight">Issuer minted a passport</span>
              </div>
              <span id="try-mint-time" class="text-xs font-mono text-[color:var(--color-text-dim)]"></span>
            </div>
            <p id="try-mint-narrative" class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3"></p>
            <details class="group">
              <summary class="cursor-pointer text-xs font-mono text-[color:var(--color-text-dim)] hover:text-[color:var(--color-accent)] transition select-none inline-flex items-center gap-1">
                <svg class="w-3 h-3 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l4 4-4 4z"/></svg>
                Show signed token &amp; payload
              </summary>
              <pre id="try-mint-output" class="mt-3 text-xs font-mono text-[color:var(--color-text-muted)] overflow-x-auto leading-relaxed"></pre>
            </details>
          </div>

          <!-- Step 2: verify result -->
          <div id="try-verify" class="hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/80 p-5">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold">02</span>
                <span class="font-semibold text-sm tracking-tight">Verifier validated it</span>
              </div>
              <span id="try-verify-time" class="text-xs font-mono text-[color:var(--color-text-dim)]"></span>
            </div>
            <div id="try-verdict-badge" class="mb-4 hidden"></div>
            <p id="try-verify-narrative" class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3"></p>
            <details class="group">
              <summary class="cursor-pointer text-xs font-mono text-[color:var(--color-text-dim)] hover:text-[color:var(--color-accent)] transition select-none inline-flex items-center gap-1">
                <svg class="w-3 h-3 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l4 4-4 4z"/></svg>
                Show full verifier response
              </summary>
              <pre id="try-verify-output" class="mt-3 text-xs font-mono text-[color:var(--color-text-muted)] overflow-x-auto leading-relaxed"></pre>
            </details>
          </div>

          <!-- Final summary - shown after both steps -->
          <div id="try-summary" class="hidden rounded-xl border border-[color:var(--color-accent)]/30 bg-gradient-to-br from-[color:var(--color-accent)]/10 to-transparent p-5">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-[color:var(--color-accent-bright)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="font-semibold text-sm tracking-tight">What just happened?</span>
            </div>
            <ul class="space-y-2 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
              <li class="flex gap-2"><span class="text-[color:var(--color-accent)]">→</span>The demo issuer signed a fresh <strong class="text-[color:var(--color-text)]">PASETO v4.public</strong> token with its Ed25519 private key, scoped to <code class="text-xs">read:articles</code>.</li>
              <li class="flex gap-2"><span class="text-[color:var(--color-accent)]">→</span>The verifier fetched the issuer's public key from its <code class="text-xs">/.well-known/agentpki-issuer.json</code> directory, validated the signature, consulted the CRL, and returned a verdict.</li>
              <li class="flex gap-2"><span class="text-[color:var(--color-accent)]">→</span>No shared secrets. No blockchain. No callout to a vendor's API. All cryptographic, stateless, &lt; 50 ms at the edge — globally.</li>
            </ul>
            <div class="mt-5 pt-5 border-t border-[color:var(--color-border)]">
              <p class="text-sm text-[color:var(--color-text-muted)] mb-3">
                In production, you replace <code class="text-xs">demo.agentpki.dev</code> with your own issuer.
              </p>
              <a href="https://dashboard.agentpki.dev"
                 class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition text-base">
                Spin up your own issuer
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none">
                  <path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Error state -->
          <div id="try-error" class="hidden rounded-xl border border-red-500/40 bg-red-500/5 p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="font-mono text-xs uppercase tracking-widest text-red-400">demo error</span>
            </div>
            <pre id="try-error-output" class="text-xs font-mono text-red-300 overflow-x-auto"></pre>
          </div>
        </div>
      </div>

      <p class="mt-6 text-center text-xs text-[color:var(--color-text-dim)] max-w-2xl mx-auto">
        Runs entirely in your browser. CORS-enabled on both Workers — the page itself has no backend. The demo issuer uses a hardcoded keypair clearly labeled DEMO-ONLY in source; production issuers use HSM-resident keys per spec §5.3.
      </p>
    </div>
  </section>

  <!-- ─────────── WHAT HAPPENS UNDER THE HOOD ─────────── -->
  <section class="border-t border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/20">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-3">Under the hood</h2>
      <p class="text-[color:var(--color-text-muted)] mb-10 max-w-2xl">A click of <em>Run</em> kicks off three real network calls — to two different production-deployed Cloudflare Workers.</p>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-6">
          <div class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-2">step 1</div>
          <h3 class="font-semibold tracking-tight mb-2">Mint request</h3>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">Your browser GETs <code class="text-xs">demo.agentpki.dev/mint</code> with a sub, scope, and lifetime. The issuer Worker signs a PASETO v4.public token with its Ed25519 private key.</p>
        </div>
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-6">
          <div class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-2">step 2</div>
          <h3 class="font-semibold tracking-tight mb-2">Verify request</h3>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">Your browser POSTs the token to <code class="text-xs">verify.agentpki.dev/v1/verify</code>. The verifier Worker fetches the issuer's public key from <code class="text-xs">/.well-known/agentpki-issuer.json</code>, validates the Ed25519 signature, consults the CRL, and returns a verdict.</p>
        </div>
        <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-6">
          <div class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-2">step 3</div>
          <h3 class="font-semibold tracking-tight mb-2">Verdict</h3>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">Returned as JSON: <code class="text-xs">&#123;"verdict":"allow", ...&#125;</code> with elapsed Worker compute time. In a real deployment this verdict tells your edge whether to serve the request.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ──────────── CODE ──────────── -->
  <section class="border-t border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/20">
    <div class="max-w-6xl mx-auto px-6 py-24">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight">Drop-in on every side.</h2>
      <p class="mt-3 text-[color:var(--color-text-muted)] text-lg max-w-2xl">
        Agents sign with the SDK. Sites verify with one POST. Bot-defense vendors slot in 30 lines of middleware.
      </p>

      <!-- Equal-height cards (grid-stretch + flex-column).
           Outer card has a subtle violet tint that pops on the dark page;
           inner body uses the page bg so the code block sits in the darkest layer. -->
      <div class="mt-10 grid lg:grid-cols-3 gap-5 items-stretch">
        <div class="code-card">
          <div class="code-card-header">
            <span class="code-card-dot"></span>
            <span>Agent side &middot; TypeScript</span>
            <span class="code-card-badge">npm: @agentpki/sdk</span>
          </div>
          <div class="code-card-body">
            <pre class="astro-code"><code>{`import { AgentPKI } from '@agentpki/sdk';

const agent = new AgentPKI({
  issuer: 'anthropic.com',
  agentId: 'agent:anthropic.com/research-bot-v3',
  scope: ['read:articles', 'read:public-data'],
});

// Auto-signs every outbound request
// (RFC 9421 Mode B by default)
const res = await agent.fetch(
  'https://reuters.com/api/article/123'
);`}</code></pre>
          </div>
        </div>

        <div class="code-card">
          <div class="code-card-header">
            <span class="code-card-dot"></span>
            <span>Site side &middot; POST to verifier</span>
            <span class="code-card-badge">verify.agentpki.dev</span>
          </div>
          <div class="code-card-body">
            <pre class="astro-code"><code>{`POST https://verify.agentpki.dev/v1/verify
Content-Type: application/json

{
  "token": "v4.public.eyJpc3M...",
  "mode": "B",
  "request": {
    "method": "GET",
    "url": "https://reuters.com/..."
  }
}

→ HTTP 200  (21ms warm · 50ms cold)
{
  "verdict": "allow",
  "passport": {
    "issuer": "anthropic.com",
    "tier": 2,
    "scopes": ["read:articles"]
  },
  "abuse_score": 0.02,
  "crl_fresh": true,
  "replay_checked": true
}`}</code></pre>
          </div>
        </div>

        <div class="code-card">
          <div class="code-card-header">
            <span class="code-card-dot"></span>
            <span>Bot-defense middleware</span>
            <span class="code-card-badge">~30 LOC drop-in</span>
          </div>
          <div class="code-card-body">
            <pre class="astro-code"><code>{`// Slot into Cloudflare / DataDome /
// hCaptcha / Arkose decision pipelines.
// SIGNAL-only — never overrides yours.

const apkiSignal = async (req) => {
  const token = req.headers
    .get('AgentPKI-Token');
  if (!token) return null;

  const r = await fetch(
    'https://verify.agentpki.dev/v1/verify',
    { method: 'POST',
      body: JSON.stringify({ token }) }
  );
  const v = await r.json();
  return { verdict: v.verdict,
           tier: v.passport?.tier };
};

// → feeds your existing score
score -= (await apkiSignal(req))
  ?.verdict === 'allow' ? 30 : 0;`}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ─────────── ADJACENT CTAs ─────────── -->
  <section class="border-t border-[color:var(--color-border)]">
    <div class="max-w-4xl mx-auto px-6 py-20 text-center">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Want to mint passports from your own domain?</h2>
      <p class="mt-5 text-lg text-[color:var(--color-text-muted)] max-w-2xl mx-auto">
        The demo's the easy part. Get your own DNS-verified issuer up in 3 minutes via the dashboard, or fork the production-grade real-issuer Worker template.
      </p>
      <div class="mt-10 flex flex-wrap gap-3 justify-center">
        <a href="https://dashboard.agentpki.dev" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-[color:var(--color-accent)] text-black font-medium text-base hover:bg-[color:var(--color-accent-bright)] transition">
          Spin up your own issuer &mdash; free
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://github.com/agentpki/real-issuer" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Fork the Worker template
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const DEMO_ISSUER = 'https://demo.agentpki.dev';
      const VERIFIER    = 'https://verify.agentpki.dev';

      const $ = (id) => document.getElementById(id);
      const button         = $('try-run');
      const tamperButton   = $('try-tamper');
      const label          = $('try-label');
      const tamperLabel    = $('try-tamper-label');
      const iconPlay       = $('try-icon-play');
      const iconSpin       = $('try-icon-spin');
      const results        = $('try-results');
      const stepsContainer = $('try-steps');
      const stepsList      = $('try-steps-list');
      const mintBlock      = $('try-mint');
      const mintOutput     = $('try-mint-output');
      const mintNarrative  = $('try-mint-narrative');
      const mintTime       = $('try-mint-time');
      const verifyBlock    = $('try-verify');
      const verifyOutput   = $('try-verify-output');
      const verifyNarrative = $('try-verify-narrative');
      const verifyTime     = $('try-verify-time');
      const verdictBadge   = $('try-verdict-badge');
      const summaryBlock   = $('try-summary');
      const errorBlock     = $('try-error');
      const errorOutput    = $('try-error-output');

      if (!button) return;

      const setLoading = (loading, mode) => {
        button.disabled = loading;
        tamperButton.disabled = loading;
        iconPlay.classList.toggle('hidden', loading && mode === 'clean');
        iconSpin.classList.toggle('hidden', !(loading && mode === 'clean'));
        label.textContent = loading && mode === 'clean' ? 'Running…' : 'Run mint → verify';
        tamperLabel.textContent = loading && mode === 'tamper' ? 'Tampering…' : 'Try with tampered token';
      };

      // Append a live status line. status: 'pending' | 'done' | 'fail'
      const addStep = (text, status) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2';
        const color = status === 'done'
          ? 'text-green-400'
          : status === 'fail'
            ? 'text-red-400'
            : 'text-[color:var(--color-accent-bright)]';
        const icon = status === 'done'
          ? '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
          : status === 'fail'
            ? '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
            : '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 animate-spin ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round"/></svg>';
        li.innerHTML = icon + '<span class="text-[color:var(--color-text-muted)] leading-snug">' + text + '</span>';
        stepsList.appendChild(li);
        return li;
      };
      const markLastStep = (status, newText) => {
        const li = stepsList.lastElementChild;
        if (!li) return;
        const color = status === 'done' ? 'text-green-400' : 'text-red-400';
        const icon = status === 'done'
          ? '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
          : '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
        const textSpan = li.lastElementChild;
        li.innerHTML = icon + (textSpan ? textSpan.outerHTML : '');
        if (newText) {
          li.lastElementChild.innerHTML = newText;
        }
      };
      const resetSteps = () => {
        stepsList.innerHTML = '';
        stepsContainer.classList.remove('hidden');
      };

      // Tamper helper: PASETO tokens have 4 dot-separated parts.
      // The 3rd part is base64url(payload || signature) — flipping a single char
      // in the last 8 chars of part 3 lands inside the signature with very high
      // probability, producing a `verdict: not_allowed` with reason `signature_invalid`.
      const tamperToken = (token) => {
        const parts = token.split('.');
        if (parts.length < 3) return token; // unexpected shape; pass through
        const p = parts[2];
        if (p.length < 4) return token;
        // Flip a char near the end (signature is at the end of part 3).
        const idx = p.length - 4;
        const orig = p[idx];
        // Swap to a different alphanumeric so we don't accidentally land on '=' (padding).
        const swap = orig === 'A' ? 'B' : 'A';
        parts[2] = p.slice(0, idx) + swap + p.slice(idx + 1);
        return parts.join('.');
      };

      const run = async (mode) => {
        setLoading(true, mode);
        resetSteps();
        results.classList.remove('hidden');
        mintBlock.classList.add('hidden');
        verifyBlock.classList.add('hidden');
        summaryBlock.classList.add('hidden');
        errorBlock.classList.add('hidden');
        verdictBadge.classList.add('hidden');

        try {
          // ── Step 1: mint a passport
          addStep('Calling <code>demo.agentpki.dev/mint</code> — issuer Worker signs a fresh PASETO v4.public token with its Ed25519 key…', 'pending');
          const t0 = performance.now();
          const mintRes = await fetch(
            DEMO_ISSUER + '/mint?sub=' +
              encodeURIComponent('agent:browser-demo/visitor') +
              '&scope=read:articles,read:public-data&lifetime=300'
          );
          if (!mintRes.ok) {
            markLastStep('fail');
            throw new Error('mint failed: HTTP ' + mintRes.status + ' ' + (await mintRes.text()));
          }
          const minted = await mintRes.json();
          const t1 = performance.now();
          const mintMs = Math.round(t1 - t0);
          markLastStep('done', 'Mint succeeded in ' + mintMs + 'ms — got back a signed PASETO v4.public token (passport payload + Ed25519 signature, encoded as one string).');

          mintTime.textContent = mintMs + 'ms';
          mintNarrative.innerHTML =
            '<code class="text-[color:var(--color-accent-bright)]">demo.agentpki.dev</code> just signed a fresh <strong class="text-[color:var(--color-text)]">PASETO v4.public</strong> token for an agent called <code class="text-xs">' +
            minted.passport.sub +
            '</code>, scoped to <code class="text-xs">' +
            (minted.passport.scope || []).join(', ') +
            '</code>. Token signed with Ed25519 key <code class="text-[10px]">' +
            minted.passport.kid +
            '</code>, valid for ' +
            minted.expires_in +
            ' seconds.';
          mintOutput.textContent = JSON.stringify(
            {
              token: minted.token.slice(0, 64) + '…',
              passport: {
                iss: minted.passport.iss,
                sub: minted.passport.sub,
                scope: minted.passport.scope,
                tier: minted.passport.tier,
                kid: minted.passport.kid,
                expires_in: minted.expires_in + 's',
              },
            },
            null,
            2
          );
          mintBlock.classList.remove('hidden');

          await new Promise((r) => setTimeout(r, 350));

          // ── Tamper step (only in tampered mode)
          let tokenToVerify = minted.token;
          if (mode === 'tamper') {
            addStep('Tampering with the signature — flipping one character in the base64-encoded Ed25519 signature portion of the token…', 'pending');
            tokenToVerify = tamperToken(minted.token);
            markLastStep('done', 'Tampered. The payload is intact but the Ed25519 signature no longer matches. A standards-compliant verifier MUST reject this.');
            await new Promise((r) => setTimeout(r, 300));
          }

          // ── Step 2: verify
          addStep(
            mode === 'tamper'
              ? 'POSTing the <strong class="text-red-300">tampered</strong> token to <code>verify.agentpki.dev/v1/verify</code>…'
              : 'POSTing token to <code>verify.agentpki.dev/v1/verify</code> — verifier fetches issuer pubkey from <code>/.well-known/agentpki-issuer.json</code>, checks signature, consults CRL…',
            'pending'
          );
          const verifyRes = await fetch(VERIFIER + '/v1/verify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token: tokenToVerify }),
          });
          const verdict = await verifyRes.json();
          const t2 = performance.now();
          const workerMs = verdict.elapsed_ms ?? '?';
          const wallMs = Math.round(t2 - t1);
          const isAllow = verdict.verdict === 'allow';
          markLastStep(
            isAllow ? 'done' : 'fail',
            (isAllow
              ? '<strong class="text-green-300">Verifier returned allow</strong>'
              : '<strong class="text-red-300">Verifier returned ' + (verdict.verdict || 'not_allowed') + '</strong>' +
                (verdict.failure_reason ? ' — reason: <code class="text-xs">' + verdict.failure_reason + '</code>' : '')
            ) + ' in ' + workerMs + 'ms (edge compute), ' + wallMs + 'ms wall-clock.'
          );

          verifyTime.textContent = 'worker ' + workerMs + 'ms · wall ' + wallMs + 'ms';

          const verdictColor = isAllow
            ? { fg: 'text-green-300', bg: 'bg-green-500/10', border: 'border-green-500/40', icon: 'text-green-400' }
            : { fg: 'text-red-300',   bg: 'bg-red-500/10',   border: 'border-red-500/40',   icon: 'text-red-400'   };
          const checkSvg = isAllow
            ? '<svg class="w-7 h-7 ' + verdictColor.icon + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>'
            : '<svg class="w-7 h-7 ' + verdictColor.icon + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
          verdictBadge.className =
            'mb-4 flex items-center gap-3 px-4 py-3 rounded-lg border ' +
            verdictColor.bg + ' ' + verdictColor.border;
          verdictBadge.innerHTML =
            checkSvg +
            '<div class="flex-1">' +
            '<div class="font-mono text-xl font-semibold ' + verdictColor.fg + ' uppercase tracking-wide">verdict: ' + (verdict.verdict || 'unknown') + '</div>' +
            '<div class="text-xs ' + verdictColor.fg + '/70 font-mono mt-0.5">' + workerMs + 'ms edge compute · ' + wallMs + 'ms wall-clock</div>' +
            '</div>';
          verdictBadge.classList.remove('hidden');

          verifyNarrative.innerHTML = isAllow
            ? '<code class="text-[color:var(--color-accent-bright)]">verify.agentpki.dev</code> fetched the issuer\'s public key from <code class="text-xs">/.well-known/agentpki-issuer.json</code>, verified the Ed25519 signature against the passport payload, confirmed the token is not expired and not revoked (CRL fresh: <code class="text-xs">' +
              (verdict.crl_fresh ? 'true' : 'false') +
              '</code>), then returned <strong class="text-green-300">allow</strong>.'
            : '<code class="text-[color:var(--color-accent-bright)]">verify.agentpki.dev</code> received the token but rejected it. Reason: <code class="text-xs">' +
              (verdict.failure_reason || 'unknown') +
              '</code>. ' + (verdict.failure_detail ? '<br><span class="text-[color:var(--color-text-dim)] text-xs">' + verdict.failure_detail + '</span>' : '') +
              (mode === 'tamper' ? '<br><span class="text-[color:var(--color-text-dim)] text-xs">Exactly the outcome you want: a tampered token is mathematically impossible to validate without the issuer\'s private key.</span>' : '');

          verifyOutput.textContent = JSON.stringify(verdict, null, 2);
          verifyBlock.classList.remove('hidden');

          await new Promise((r) => setTimeout(r, 200));
          if (isAllow) summaryBlock.classList.remove('hidden');
        } catch (e) {
          errorOutput.textContent = (e && e.message) || String(e);
          errorBlock.classList.remove('hidden');
        } finally {
          setLoading(false, mode);
        }
      };

      button.addEventListener('click', () => run('clean'));
      tamperButton.addEventListener('click', () => run('tamper'));

      // Auto-run on page load if ?run=1 is in URL (used by landing's hero CTA)
      const params = new URLSearchParams(window.location.search);
      if (params.get('run') === '1') {
        setTimeout(() => button.click(), 800);
      }
    })();
  </script>

  <Footer />
  <ContactModal />
</Base>
