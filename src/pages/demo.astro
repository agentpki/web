---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Base title="Live demo — AgentPKI" description="Mint and verify a real AgentPKI passport in your browser. Runs against our production-deployed Cloudflare Workers.">
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <!-- ─────────── HEADER ─────────── -->
  <section class="border-b border-[color:var(--color-border)]">
    <div class="max-w-[1400px] mx-auto px-8 pt-16 pb-12 lg:pt-20 lg:pb-16 text-center">
      <p class="inline-flex items-center gap-2 px-3 py-1 mb-5 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur text-xs text-[color:var(--color-text-muted)]">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-green-400"></span>
        </span>
        live on production infrastructure
      </p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-balance">Try AgentPKI <span class="text-green-400">live.</span></h1>
      <p class="mt-5 text-lg text-[color:var(--color-text-muted)] max-w-2xl mx-auto leading-relaxed">
        Click <strong class="text-[color:var(--color-text)]">Run mint → verify</strong>. The button calls our demo issuer to sign a fresh passport, then ships that passport to our edge verifier. Both are real production Cloudflare Workers — no mock, no replay.
      </p>
    </div>
  </section>

  <!-- ─────────── WHO THIS IS FOR (role cards) ─────────── -->
  <section class="border-b border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/30">
    <div class="max-w-[1400px] mx-auto px-8 py-12 lg:py-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">Who this is for</h2>
      <p class="text-[color:var(--color-text-muted)] max-w-2xl mb-8">If you operate one of these, the demo below is going to look immediately useful. Click for a tailored explanation later on the page.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a href="#for-vendors" class="role-card group block rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 hover:border-blue-400/50 hover:bg-blue-500/5 transition no-underline">
          <div class="text-sm font-bold text-blue-300 mb-1">Bot-defense vendors</div>
          <div class="text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-3">Cloudflare · DataDome · hCaptcha · Arkose · Castle · F5 · Akamai · Kasada</div>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3">Additive signal in your existing pipeline. <strong class="text-[color:var(--color-text)]">Never overrides your score.</strong> 30-line middleware drop-in. Verdict in ~21ms.</p>
          <div class="text-xs text-blue-300 font-medium">See how the integration looks &rarr;</div>
        </a>
        <a href="#for-publishers" class="role-card group block rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 hover:border-green-400/50 hover:bg-green-500/5 transition no-underline">
          <div class="text-sm font-bold text-green-300 mb-1">Publishers fighting scrapers</div>
          <div class="text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-3">Reuters · NYT · The Verge · Stack Overflow · dev.to · GitHub</div>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3">Finally distinguish <strong class="text-[color:var(--color-text)]">legitimate AI traffic</strong> from scrapers wearing agent costumes. Lower CAPTCHA rates for verified agents; higher block confidence for unsigned ones.</p>
          <div class="text-xs text-green-300 font-medium">See the comparison &rarr;</div>
        </a>
        <a href="#for-api" class="role-card group block rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/60 p-5 hover:border-amber-400/50 hover:bg-amber-500/5 transition no-underline">
          <div class="text-sm font-bold text-amber-300 mb-1">Sites with API tiers</div>
          <div class="text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-3">Stripe · Shopify · Reddit · Twilio · Anthropic itself</div>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3">Apply <strong class="text-[color:var(--color-text)]">scope-based rate limits</strong> to authenticated agents. "Anthropic's tier-2 research bot" gets different quotas than "unknown agent traffic." Auditable, attributable, revocable.</p>
          <div class="text-xs text-amber-300 font-medium">See the passport claim &rarr;</div>
        </a>
      </div>
    </div>
  </section>

  <!-- ─────────── PICK AN AGENT (scenario cards) ─────────── -->
  <section class="border-b border-[color:var(--color-border)]">
    <div class="max-w-[1400px] mx-auto px-8 py-12 lg:py-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2"><span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-sm font-semibold mr-2 align-middle">1</span>Pick an agent</h2>
      <p class="text-[color:var(--color-text-muted)] max-w-3xl mb-8">Each scenario is a real agent hitting a real publisher API. The buttons in &sect;3 below run them against the production verifier — same cryptography, three different outcomes.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-green-500/40 bg-green-500/[0.04] p-5">
          <div class="text-[10px] uppercase tracking-widest text-green-400 font-bold mb-2">Verified AI agent</div>
          <h3 class="font-semibold tracking-tight mb-2">Anthropic — research-bot-v3</h3>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">Anthropic's research bot, reading Reuters articles on behalf of a Claude user. Tier 2 KYB-verified issuer.</p>
          <div class="mt-3 text-xs text-[color:var(--color-text-dim)]">Expected: <strong class="text-green-300">verdict: allow</strong> &middot; tier 2</div>
        </div>
        <div class="rounded-xl border border-red-500/40 bg-red-500/[0.04] p-5">
          <div class="text-[10px] uppercase tracking-widest text-red-400 font-bold mb-2">Tampered passport</div>
          <h3 class="font-semibold tracking-tight mb-2">Imposter — flipped signature</h3>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">Same Anthropic claim, but we flip a byte in the signature before sending. Cryptography catches it.</p>
          <div class="mt-3 text-xs text-[color:var(--color-text-dim)]">Expected: <strong class="text-red-300">verdict: not_allowed</strong> &middot; signature_invalid</div>
        </div>
        <div class="rounded-xl border border-amber-500/40 bg-amber-500/[0.04] p-5">
          <div class="text-[10px] uppercase tracking-widest text-amber-400 font-bold mb-2">Revoked key</div>
          <h3 class="font-semibold tracking-tight mb-2">Compromised — key rotation</h3>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">A passport from an old, rotated-out Anthropic key. The directory's <code class="text-xs">revoked_keys</code> list catches it — even though the signature is mathematically valid.</p>
          <div class="mt-3 text-xs text-[color:var(--color-text-dim)]">Expected: <strong class="text-amber-300">verdict: not_allowed</strong> &middot; revoked_key</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── WHAT THE PUBLISHER'S EDGE SEES (comparison) ─────────── -->
  <section id="for-publishers" class="border-b border-[color:var(--color-border)]">
    <div class="max-w-[1400px] mx-auto px-8 py-12 lg:py-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">What the publisher's edge sees</h2>
      <p class="text-[color:var(--color-text-muted)] max-w-3xl mb-8">Without AgentPKI, bot-defense vendors have to guess. With AgentPKI, the request carries a verifiable claim.</p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- WITHOUT -->
        <div class="rounded-xl border border-red-500/30 bg-[color:var(--color-bg-elevated)]/60 p-6">
          <div class="text-[10px] uppercase tracking-widest text-red-400 font-bold mb-2">Without AgentPKI</div>
          <h3 class="font-semibold tracking-tight mb-4">Today's reality at reuters.com</h3>
          <div class="space-y-3 text-sm font-mono">
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">User-Agent</div>python-requests/2.31.0</div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">IP</div><span class="text-[color:var(--color-text-muted)]">3.123.45.67 (rotating residential)</span></div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Signed identity claim</div><span class="text-[color:var(--color-text-muted)]">none</span></div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Behavioral fingerprint</div><span class="text-[color:var(--color-text-muted)]">looks scripted</span></div>
          </div>
          <div class="mt-4 pt-4 border-t border-[color:var(--color-border)] text-sm text-red-300">
            &rarr; Bot-defense vendor: <strong>"Could be Anthropic, could be a scraper. risk_score 0.65. Serve CAPTCHA."</strong>
          </div>
        </div>

        <!-- WITH -->
        <div class="rounded-xl border border-green-500/40 bg-[color:var(--color-bg-elevated)]/60 p-6">
          <div class="text-[10px] uppercase tracking-widest text-green-400 font-bold mb-2">With AgentPKI</div>
          <h3 class="font-semibold tracking-tight mb-4">Same request, signed passport attached</h3>

          <!-- PLAIN-ENGLISH CLAIM STATEMENT -->
          <div class="rounded-lg border border-green-500/30 bg-green-500/[0.07] p-4 mb-4">
            <div class="text-[10px] uppercase tracking-widest text-green-400 font-bold mb-1">&#128220; What the passport actually says</div>
            <p class="text-sm text-[color:var(--color-text)] leading-relaxed">"Anthropic claims this agent is their <strong class="text-green-300">research-bot-v3</strong>, authorized for <strong class="text-green-300">read-only article access</strong>, with <strong class="text-green-300">tier-2 (KYB-verified)</strong> trust. Signed by Anthropic's Ed25519 key. Valid until 12:35 PM."</p>
          </div>

          <div class="space-y-3 text-sm font-mono">
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Issuer</div><code class="text-[color:var(--color-accent-bright)]">anthropic.com</code></div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Agent ID</div><code class="text-[color:var(--color-accent-bright)]">agent:anthropic.com/research-bot-v3</code></div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Scope</div><code class="text-[color:var(--color-accent-bright)]">["read:articles"]</code></div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Tier &middot; lifetime</div><code class="text-[color:var(--color-accent-bright)]">2 (KYB-verified) &middot; 300s</code></div>
            <div><div class="text-[10px] uppercase tracking-wider text-[color:var(--color-text-dim)] mb-0.5">Token</div><span class="text-[color:var(--color-text-muted)]">v4.public.eyJpc3M… (Ed25519 signed)</span></div>
          </div>
          <div class="mt-4 pt-4 border-t border-[color:var(--color-border)] text-sm text-green-300">
            &rarr; Bot-defense vendor: <strong>"Anthropic, cryptographically. risk_score 0.02. Allow."</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── DEMO CARD ─────────── -->
  <section>
    <div class="max-w-[1400px] mx-auto px-8 py-12">
      <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur-sm p-6 sm:p-8 lg:p-10">
        <!-- Header row -->
        <div class="flex flex-col gap-5">
          <div class="text-xs sm:text-sm text-[color:var(--color-text-muted)] font-mono break-all">
            <code>demo.agentpki.dev/mint</code>
            <span class="mx-2 text-[color:var(--color-text-dim)]">&rarr;</span>
            <code>verify.agentpki.dev/v1/verify</code>
          </div>

          <!-- Three-button row: side-by-side on desktop with clear visual separation; stack on mobile -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
            <!-- 1. HAPPY PATH -->
            <div class="flex flex-col gap-2">
              <button id="try-run"
                      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg bg-[color:var(--color-accent)] text-black font-semibold hover:bg-[color:var(--color-accent-bright)] transition disabled:opacity-60 disabled:cursor-not-allowed shadow-sm">
                <svg id="try-icon-play" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4l10 6-10 6z"/></svg>
                <svg id="try-icon-spin" class="w-4 h-4 hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor">
                  <circle cx="10" cy="10" r="7" stroke-width="2.5" stroke-dasharray="44" stroke-dashoffset="22" stroke-linecap="round" class="origin-center">
                    <animateTransform attributeName="transform" type="rotate" from="0 10 10" to="360 10 10" dur="0.9s" repeatCount="indefinite"/>
                  </circle>
                </svg>
                <span id="try-label">Run mint &rarr; verify</span>
              </button>
              <p class="text-xs text-[color:var(--color-text-dim)] text-center md:text-left">
                Expected: <strong class="text-green-300">verdict: allow</strong>
              </p>
            </div>

            <!-- 2. TAMPER PATH -->
            <div class="flex flex-col gap-2">
              <button id="try-tamper"
                      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg border-2 border-red-500/40 text-red-300 bg-red-500/5 hover:bg-red-500/10 hover:border-red-500/60 transition disabled:opacity-60 disabled:cursor-not-allowed font-semibold">
                <span class="text-xs opacity-70">Run with &rarr;</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span id="try-tamper-label">Tamper signature</span>
              </button>
              <p class="text-xs text-[color:var(--color-text-dim)] text-center md:text-left">
                Expected: <strong class="text-red-300">verdict: not_allowed</strong> (signature_invalid)
              </p>
            </div>

            <!-- 3. REVOKED-KEY PATH -->
            <div class="flex flex-col gap-2">
              <button id="try-revoked"
                      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg border-2 border-amber-500/40 text-amber-300 bg-amber-500/5 hover:bg-amber-500/10 hover:border-amber-500/60 transition disabled:opacity-60 disabled:cursor-not-allowed font-semibold">
                <span class="text-xs opacity-70">Run with &rarr;</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                <span id="try-revoked-label">Use revoked key</span>
              </button>
              <p class="text-xs text-[color:var(--color-text-dim)] text-center md:text-left">
                Expected: <strong class="text-amber-300">verdict: not_allowed</strong> (revoked_key)
              </p>
            </div>
          </div>

          <div class="text-xs text-[color:var(--color-text-dim)] border-t border-[color:var(--color-border)] pt-4 space-y-2">
            <p>
              <strong class="text-[color:var(--color-text-muted)]">How the tampered path works:</strong> we mint a valid passport, then flip a character in the base64-encoded signature before sending it to the verifier. The signature no longer matches the payload &rarr; Ed25519 verify returns false &rarr; <code>signature_invalid</code>.
            </p>
            <p>
              <strong class="text-[color:var(--color-text-muted)]">How the revoked-key path works:</strong> we mint a passport with a <em>kid</em> ("key identifier") that the demo issuer has listed in its <code>revoked_keys</code> directory entry. The signature is mathematically valid (same private key) but the verifier rejects with <code>revoked_key</code> — exactly the v0.2 CRL/key-rotation story. Demonstrates that revocation works <em>without</em> coordinating with every verifier on the web.
            </p>
          </div>
        </div>

        <!-- Live step status — populated by JS as the demo runs -->
        <div id="try-steps" class="hidden mt-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/40 p-4">
          <div class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-2">Live status</div>
          <ul id="try-steps-list" class="space-y-1.5 text-sm font-mono"></ul>
        </div>

        <div id="try-results" class="mt-6 space-y-4 hidden">
          <!-- Step 1: mint result -->
          <div id="try-mint" class="hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/80 p-5">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold">01</span>
                <span class="font-semibold text-sm tracking-tight">Issuer minted a passport</span>
              </div>
              <span id="try-mint-time" class="text-xs font-mono text-[color:var(--color-text-dim)]"></span>
            </div>
            <p id="try-mint-narrative" class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3"></p>
            <details class="group">
              <summary class="cursor-pointer text-xs font-mono text-[color:var(--color-text-dim)] hover:text-[color:var(--color-accent)] transition select-none inline-flex items-center gap-1">
                <svg class="w-3 h-3 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l4 4-4 4z"/></svg>
                Show signed token &amp; payload
              </summary>
              <pre id="try-mint-output" class="mt-3 text-xs font-mono text-[color:var(--color-text-muted)] overflow-x-auto leading-relaxed"></pre>
            </details>
          </div>

          <!-- Step 2: verify result -->
          <div id="try-verify" class="hidden rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg)]/80 p-5">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold">02</span>
                <span class="font-semibold text-sm tracking-tight">Verifier validated it</span>
              </div>
              <span id="try-verify-time" class="text-xs font-mono text-[color:var(--color-text-dim)]"></span>
            </div>
            <div id="try-verdict-badge" class="mb-4 hidden"></div>
            <p id="try-verify-narrative" class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3"></p>
            <details class="group">
              <summary class="cursor-pointer text-xs font-mono text-[color:var(--color-text-dim)] hover:text-[color:var(--color-accent)] transition select-none inline-flex items-center gap-1">
                <svg class="w-3 h-3 transition-transform group-open:rotate-90" viewBox="0 0 12 12" fill="currentColor"><path d="M4 2l4 4-4 4z"/></svg>
                Show full verifier response
              </summary>
              <pre id="try-verify-output" class="mt-3 text-xs font-mono text-[color:var(--color-text-muted)] overflow-x-auto leading-relaxed"></pre>
            </details>
          </div>

          <!-- Final summary - shown after both steps -->
          <div id="try-summary" class="hidden rounded-xl border border-[color:var(--color-accent)]/30 bg-gradient-to-br from-[color:var(--color-accent)]/10 to-transparent p-5">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-4 h-4 text-[color:var(--color-accent-bright)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              <span class="font-semibold text-sm tracking-tight">What just happened?</span>
            </div>
            <ul class="space-y-2 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
              <li class="flex gap-2"><span class="text-[color:var(--color-accent)]">→</span>The demo issuer signed a fresh <strong class="text-[color:var(--color-text)]">PASETO v4.public</strong> token with its Ed25519 private key, scoped to <code class="text-xs">read:articles</code>.</li>
              <li class="flex gap-2"><span class="text-[color:var(--color-accent)]">→</span>The verifier fetched the issuer's public key from its <code class="text-xs">/.well-known/agentpki-issuer.json</code> directory, validated the signature, consulted the CRL, and returned a verdict.</li>
              <li class="flex gap-2"><span class="text-[color:var(--color-accent)]">→</span>No shared secrets. No blockchain. No callout to a vendor's API. All cryptographic, stateless, &lt; 50 ms at the edge — globally.</li>
            </ul>
            <div class="mt-5 pt-5 border-t border-[color:var(--color-border)]">
              <p class="text-sm text-[color:var(--color-text-muted)] mb-3">
                In production, you replace <code class="text-xs">demo.agentpki.dev</code> with your own issuer.
              </p>
              <a href="https://dashboard.agentpki.dev"
                 class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition text-base">
                Spin up your own issuer
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none">
                  <path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Error state -->
          <div id="try-error" class="hidden rounded-xl border border-red-500/40 bg-red-500/5 p-5">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span class="font-mono text-xs uppercase tracking-widest text-red-400">demo error</span>
            </div>
            <pre id="try-error-output" class="text-xs font-mono text-red-300 overflow-x-auto"></pre>
          </div>
        </div>
      </div>

