  <script is:inline>
    (function () {
      const DEMO_ISSUER = 'https://demo.agentpki.dev';
      const VERIFIER    = 'https://verify.agentpki.dev';

      const $ = (id) => document.getElementById(id);
      const button         = $('try-run');
      const tamperButton   = $('try-tamper');
      const revokedButton  = $('try-revoked');
      const label          = $('try-label');
      const tamperLabel    = $('try-tamper-label');
      const revokedLabel   = $('try-revoked-label');
      const iconPlay       = $('try-icon-play');
      const iconSpin       = $('try-icon-spin');
      const results        = $('try-results');
      const stepsContainer = $('try-steps');
      const stepsList      = $('try-steps-list');
      const mintBlock      = $('try-mint');
      const mintOutput     = $('try-mint-output');
      const mintNarrative  = $('try-mint-narrative');
      const mintTime       = $('try-mint-time');
      const verifyBlock    = $('try-verify');
      const verifyOutput   = $('try-verify-output');
      const verifyNarrative = $('try-verify-narrative');
      const verifyTime     = $('try-verify-time');
      const verdictBadge   = $('try-verdict-badge');
      const summaryBlock   = $('try-summary');
      const errorBlock     = $('try-error');
      const errorOutput    = $('try-error-output');

      if (!button) return;

      const setLoading = (loading, mode) => {
        button.disabled = loading;
        tamperButton.disabled = loading;
        if (revokedButton) revokedButton.disabled = loading;
        iconPlay.classList.toggle('hidden', loading && mode === 'clean');
        iconSpin.classList.toggle('hidden', !(loading && mode === 'clean'));
        label.textContent = loading && mode === 'clean' ? 'Running…' : 'Run mint → verify';
        tamperLabel.textContent = loading && mode === 'tamper' ? 'Tampering…' : 'Tamper signature';
        if (revokedLabel) {
          revokedLabel.textContent = loading && mode === 'revoked' ? 'Minting w/ revoked kid…' : 'Use revoked key';
        }
      };

      // Append a live status line. status: 'pending' | 'done' | 'fail'
      const addStep = (text, status) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2';
        const color = status === 'done'
          ? 'text-green-400'
          : status === 'fail'
            ? 'text-red-400'
            : 'text-[color:var(--color-accent-bright)]';
        const icon = status === 'done'
          ? '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
          : status === 'fail'
            ? '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
            : '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 animate-spin ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-6.219-8.56" stroke-linecap="round"/></svg>';
        li.innerHTML = icon + '<span class="text-[color:var(--color-text-muted)] leading-snug">' + text + '</span>';
        stepsList.appendChild(li);
        return li;
      };
      const markLastStep = (status, newText) => {
        const li = stepsList.lastElementChild;
        if (!li) return;
        const color = status === 'done' ? 'text-green-400' : 'text-red-400';
        const icon = status === 'done'
          ? '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>'
          : '<svg class="w-3.5 h-3.5 mt-0.5 shrink-0 ' + color + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
        const textSpan = li.lastElementChild;
        li.innerHTML = icon + (textSpan ? textSpan.outerHTML : '');
        if (newText) {
          li.lastElementChild.innerHTML = newText;
        }
      };
      const resetSteps = () => {
        stepsList.innerHTML = '';
        stepsContainer.classList.remove('hidden');
      };

      // Tamper helper: PASETO tokens have 4 dot-separated parts.
      // The 3rd part is base64url(payload || signature) — flipping a single char
      // in the last 8 chars of part 3 lands inside the signature with very high
      // probability, producing a `verdict: not_allowed` with reason `signature_invalid`.
      const tamperToken = (token) => {
        const parts = token.split('.');
        if (parts.length < 3) return token; // unexpected shape; pass through
        const p = parts[2];
        if (p.length < 4) return token;
        // Flip a char near the end (signature is at the end of part 3).
        const idx = p.length - 4;
        const orig = p[idx];
        // Swap to a different alphanumeric so we don't accidentally land on '=' (padding).
        const swap = orig === 'A' ? 'B' : 'A';
        parts[2] = p.slice(0, idx) + swap + p.slice(idx + 1);
        return parts.join('.');
      };

      const run = async (mode) => {
        setLoading(true, mode);
        resetSteps();
        results.classList.remove('hidden');
        mintBlock.classList.add('hidden');
        verifyBlock.classList.add('hidden');
        summaryBlock.classList.add('hidden');
        errorBlock.classList.add('hidden');
        verdictBadge.classList.add('hidden');

        try {
          // ── Step 1: mint a passport
          // For mode === 'revoked', ask the issuer to sign with a kid that
          // it has listed in revoked_keys — real cryptography, real CRL story.
          const mintStepText =
            mode === 'revoked'
              ? 'Calling <code>demo.agentpki.dev/mint?revoked=1</code> — issuer signs with a deliberately-rotated <em>kid</em> that\'s in its <code>revoked_keys</code> directory entry…'
              : 'Calling <code>demo.agentpki.dev/mint</code> — issuer Worker signs a fresh PASETO v4.public token with its Ed25519 key…';
          addStep(mintStepText, 'pending');
          const t0 = performance.now();
          const mintUrl =
            DEMO_ISSUER + '/mint?sub=' +
            encodeURIComponent('agent:browser-demo/visitor') +
            '&scope=read:articles,read:public-data&lifetime=300' +
            (mode === 'revoked' ? '&revoked=1' : '');
          const mintRes = await fetch(mintUrl);
          if (!mintRes.ok) {
            markLastStep('fail');
            throw new Error('mint failed: HTTP ' + mintRes.status + ' ' + (await mintRes.text()));
          }
          const minted = await mintRes.json();
          const t1 = performance.now();
          const mintMs = Math.round(t1 - t0);
          const mintDoneText =
            mode === 'revoked'
              ? 'Mint succeeded in ' + mintMs + 'ms. Token signed by kid <code>' + minted.passport.kid + '</code> — listed as revoked in the issuer\'s directory.'
              : 'Mint succeeded in ' + mintMs + 'ms — got back a signed PASETO v4.public token (passport payload + Ed25519 signature, encoded as one string).';
          markLastStep('done', mintDoneText);

          mintTime.textContent = mintMs + 'ms';
          mintNarrative.innerHTML =
            '<code class="text-[color:var(--color-accent-bright)]">demo.agentpki.dev</code> just signed a fresh <strong class="text-[color:var(--color-text)]">PASETO v4.public</strong> token for an agent called <code class="text-xs">' +
            minted.passport.sub +
            '</code>, scoped to <code class="text-xs">' +
            (minted.passport.scope || []).join(', ') +
            '</code>. Token signed with Ed25519 key <code class="text-[10px]">' +
            minted.passport.kid +
            '</code>, valid for ' +
            minted.expires_in +
            ' seconds.';
          mintOutput.textContent = JSON.stringify(
            {
              token: minted.token.slice(0, 64) + '…',
              passport: {
                iss: minted.passport.iss,
                sub: minted.passport.sub,
                scope: minted.passport.scope,
                tier: minted.passport.tier,
                kid: minted.passport.kid,
                expires_in: minted.expires_in + 's',
              },
            },
            null,
            2
          );
          mintBlock.classList.remove('hidden');

          await new Promise((r) => setTimeout(r, 350));

          // ── Tamper step (only in tampered mode)
          let tokenToVerify = minted.token;
          if (mode === 'tamper') {
            addStep('Tampering with the signature — flipping one character in the base64-encoded Ed25519 signature portion of the token…', 'pending');
            tokenToVerify = tamperToken(minted.token);
            markLastStep('done', 'Tampered. The payload is intact but the Ed25519 signature no longer matches. A standards-compliant verifier MUST reject this.');
            await new Promise((r) => setTimeout(r, 300));
          }

          // ── Step 2: verify
          const verifyStepText =
            mode === 'tamper'
              ? 'POSTing the <strong class="text-red-300">tampered</strong> token to <code>verify.agentpki.dev/v1/verify</code>…'
              : mode === 'revoked'
                ? 'POSTing token (signed by <strong class="text-amber-300">revoked kid</strong>) to <code>verify.agentpki.dev/v1/verify</code> — verifier will fetch the issuer\'s directory, find the kid in <code>revoked_keys</code>, and reject…'
                : 'POSTing token to <code>verify.agentpki.dev/v1/verify</code> — verifier fetches issuer pubkey from <code>/.well-known/agentpki-issuer.json</code>, checks signature, consults CRL…';
          addStep(verifyStepText, 'pending');
          const verifyRes = await fetch(VERIFIER + '/v1/verify', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token: tokenToVerify }),
          });
          const verdict = await verifyRes.json();
          const t2 = performance.now();
          const workerMs = verdict.elapsed_ms ?? '?';
          const wallMs = Math.round(t2 - t1);
          const isAllow = verdict.verdict === 'allow';
          markLastStep(
            isAllow ? 'done' : 'fail',
            (isAllow
              ? '<strong class="text-green-300">Verifier returned allow</strong>'
              : '<strong class="text-red-300">Verifier returned ' + (verdict.verdict || 'not_allowed') + '</strong>' +
                (verdict.failure_reason ? ' — reason: <code class="text-xs">' + verdict.failure_reason + '</code>' : '')
            ) + ' in ' + workerMs + 'ms (edge compute), ' + wallMs + 'ms wall-clock.'
          );

          verifyTime.textContent = 'worker ' + workerMs + 'ms · wall ' + wallMs + 'ms';

          const verdictColor = isAllow
            ? { fg: 'text-green-300', bg: 'bg-green-500/10', border: 'border-green-500/40', icon: 'text-green-400' }
            : { fg: 'text-red-300',   bg: 'bg-red-500/10',   border: 'border-red-500/40',   icon: 'text-red-400'   };
          const checkSvg = isAllow
            ? '<svg class="w-7 h-7 ' + verdictColor.icon + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>'
            : '<svg class="w-7 h-7 ' + verdictColor.icon + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>';
          verdictBadge.className =
            'mb-4 flex items-center gap-3 px-4 py-3 rounded-lg border ' +
            verdictColor.bg + ' ' + verdictColor.border;
          verdictBadge.innerHTML =
            checkSvg +
            '<div class="flex-1">' +
            '<div class="font-mono text-xl font-semibold ' + verdictColor.fg + ' uppercase tracking-wide">verdict: ' + (verdict.verdict || 'unknown') + '</div>' +
            '<div class="text-xs ' + verdictColor.fg + '/70 font-mono mt-0.5">' + workerMs + 'ms edge compute · ' + wallMs + 'ms wall-clock</div>' +
            '</div>';
          verdictBadge.classList.remove('hidden');

          verifyNarrative.innerHTML = isAllow
            ? '<code class="text-[color:var(--color-accent-bright)]">verify.agentpki.dev</code> fetched the issuer\'s public key from <code class="text-xs">/.well-known/agentpki-issuer.json</code>, verified the Ed25519 signature against the passport payload, confirmed the token is not expired and not revoked (CRL fresh: <code class="text-xs">' +
              (verdict.crl_fresh ? 'true' : 'false') +
              '</code>), then returned <strong class="text-green-300">allow</strong>.'
            : '<code class="text-[color:var(--color-accent-bright)]">verify.agentpki.dev</code> received the token but rejected it. Reason: <code class="text-xs">' +
              (verdict.failure_reason || 'unknown') +
              '</code>. ' + (verdict.failure_detail ? '<br><span class="text-[color:var(--color-text-dim)] text-xs">' + verdict.failure_detail + '</span>' : '') +
              (mode === 'tamper' ? '<br><span class="text-[color:var(--color-text-dim)] text-xs">Exactly the outcome you want: a tampered token is mathematically impossible to validate without the issuer\'s private key.</span>' : '') +
              (mode === 'revoked' ? '<br><span class="text-[color:var(--color-text-dim)] text-xs">Even though the Ed25519 signature is mathematically valid, the verifier checked the issuer\'s directory and found the <em>kid</em> listed in <code>revoked_keys</code>. This is why short lifetimes + CRL matter — Anthropic can rotate a key and every verifier on the web honors it without coordinating with anyone.</span>' : '');

          verifyOutput.textContent = JSON.stringify(verdict, null, 2);
          verifyBlock.classList.remove('hidden');

          await new Promise((r) => setTimeout(r, 200));
          if (isAllow) summaryBlock.classList.remove('hidden');
        } catch (e) {
          errorOutput.textContent = (e && e.message) || String(e);
          errorBlock.classList.remove('hidden');
        } finally {
          setLoading(false, mode);
        }
      };

      button.addEventListener('click', () => run('clean'));
      tamperButton.addEventListener('click', () => run('tamper'));
      if (revokedButton) revokedButton.addEventListener('click', () => run('revoked'));

      // Auto-run on page load if ?run=1 is in URL (used by landing's hero CTA).
      // Strip the param from the URL immediately so a subsequent refresh
      // doesn't re-trigger the run — common annoyance: user navigates here
      // from the hero CTA, demo runs, they refresh to try again, and it
      // self-clicks before they can press anything.
      const params = new URLSearchParams(window.location.search);
      if (params.get('run') === '1') {
        params.delete('run');
        const newUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '') + window.location.hash;
        window.history.replaceState(null, '', newUrl);
        setTimeout(() => button.click(), 800);
      }
    })();
  </script>

  <Footer />
  <ContactModal />
</Base>
