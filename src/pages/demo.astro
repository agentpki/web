      <!-- CTAs at bottom -->
      <section class="demo-section">
        <h2>Want to run your own?</h2>
        <p class="lead">Two paths, both walked through in the dashboard:</p>
        <div class="btn-row" style="grid-template-columns: 1fr 1fr;">
          <a class="demo-btn primary" href="https://dashboard.agentpki.dev" style="text-decoration: none;">Spin up your own issuer &rarr;</a>
          <a class="demo-btn" href="https://github.com/agentpki/real-issuer" style="text-decoration: none; border-color: var(--demo-border-bright); color: var(--demo-text);">Fork the Worker template</a>
        </div>
