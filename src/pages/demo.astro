      <!-- STEP 3: trigger -->
      <section class="demo-section">
        <h2><span class="step">3</span>Run the demo</h2>
        <p class="lead">Each button mints + sends to the production verifier. Verdicts come back in ~150ms.</p>
        <div class="btn-row">
          <div>
            <button class="demo-btn primary" data-run="anthropic" id="btn-anthropic">&#9654; Run as Anthropic bot</button>
