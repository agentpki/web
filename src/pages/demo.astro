---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Base title="Live demo — AgentPKI" description="Mint and verify a real AgentPKI passport in your browser. Runs against our production-deployed Cloudflare Workers.">
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>
  <Nav />

  <style is:global>
    /* ─── Demo-page-scoped design tokens (mirrors demo-v2-preview.html) ─── */
    :root {
      --demo-bg: #08080b;
      --demo-bg-elev: #111114;
      --demo-bg-card: #15151a;
      --demo-border: #1f1f25;
      --demo-border-bright: #2a2a33;
      --demo-text: #f2f2f5;
      --demo-text-muted: #b8b8c4;
      --demo-text-dim: #6b6b78;
      --demo-accent: #a78bfa;
      --demo-accent-bright: #c4b5fd;
      --demo-success: #4ade80;
      --demo-success-bright: #6ee7a3;
      --demo-danger: #f87171;
      --demo-warn: #fbbf24;
      --demo-info: #60a5fa;
    }

    .demo-page code, .demo-page pre { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
    .demo-page code { font-size: 0.875em; color: var(--demo-accent-bright); }

    .demo-page .wrap {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Hero */
    .demo-page .demo-hero { padding: 4rem 0 3rem; text-align: center; }
    .demo-page .demo-hero h1 { font-size: clamp(2.25rem, 5vw, 3.5rem); margin: 0 0 1rem; font-weight: 600; letter-spacing: -0.02em; color: var(--demo-text); }
    .demo-page .demo-hero h1 .accent { color: var(--demo-success); }
    .demo-page .demo-hero p { font-size: 1.125rem; color: var(--demo-text-muted); max-width: 42rem; margin: 0 auto; }

    /* Sections */
    .demo-page .demo-section { padding: 2.5rem 0; border-top: 1px solid var(--demo-border); }
    .demo-page .demo-section.no-border { border-top: none; }
    .demo-page .demo-section h2 {
      font-size: 1.5rem;
      margin: 0 0 0.5rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: var(--demo-text);
    }
    .demo-page .demo-section h2 .step {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 0.5rem;
      background: rgba(167, 139, 250, 0.15);
      color: var(--demo-accent-bright);
      font-size: 0.875rem;
      font-weight: 600;
      margin-right: 0.625rem;
      vertical-align: 2px;
    }
    .demo-page .demo-section .lead { color: var(--demo-text-muted); margin: 0 0 1.5rem; max-width: 50rem; }

    /* Role cards (Who this is for) */
    .demo-page .roles {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }
    .demo-page .role {
      background: var(--demo-bg-card);
      border: 1.5px solid var(--demo-border-bright);
      border-radius: 0.875rem;
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: border-color 150ms, background 150ms;
      display: flex;
      flex-direction: column;
    }
    .demo-page .role:hover { border-color: var(--demo-accent); background: rgba(167, 139, 250, 0.05); }
    .demo-page .role[data-role="vendors"]:hover { border-color: var(--demo-info); background: rgba(96, 165, 250, 0.05); }
    .demo-page .role[data-role="publishers"]:hover { border-color: var(--demo-success); background: rgba(74, 222, 128, 0.05); }
    .demo-page .role[data-role="api"]:hover { border-color: var(--demo-warn); background: rgba(251, 191, 36, 0.05); }
    .demo-page .role-label {
      font-size: 0.875rem;
      font-weight: 700;
      color: var(--demo-text);
      margin-bottom: 0.375rem;
    }
    .demo-page .role[data-role="vendors"] .role-label { color: var(--demo-info); }
    .demo-page .role[data-role="publishers"] .role-label { color: var(--demo-success-bright); }
    .demo-page .role[data-role="api"] .role-label { color: var(--demo-warn); }
    .demo-page .role-names {
      font-size: 0.6875rem;
      color: var(--demo-text-dim);
      letter-spacing: 0.02em;
      margin-bottom: 0.75rem;
    }
    .demo-page .role-pitch {
      font-size: 0.875rem;
      color: var(--demo-text-muted);
      line-height: 1.5;
      margin: 0 0 0.875rem;
      flex: 1;
    }
    .demo-page .role-pitch b { color: var(--demo-text); font-weight: 600; }
    .demo-page .role-cta {
      font-size: 0.75rem;
      color: var(--demo-accent-bright);
      font-weight: 500;
    }
    .demo-page .role[data-role="vendors"] .role-cta { color: var(--demo-info); }
    .demo-page .role[data-role="publishers"] .role-cta { color: var(--demo-success-bright); }
    .demo-page .role[data-role="api"] .role-cta { color: var(--demo-warn); }

    /* Scenario picker */
    .demo-page .scenarios {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
    }
    .demo-page .scenario {
      background: var(--demo-bg-card);
      border: 1.5px solid var(--demo-border-bright);
      border-radius: 0.875rem;
      padding: 1.25rem;
      cursor: pointer;
      transition: border-color 150ms, background 150ms, transform 150ms;
    }
    .demo-page .scenario:hover { border-color: var(--demo-accent); }
    .demo-page .scenario.active {
      border-color: var(--demo-accent);
      background: rgba(167, 139, 250, 0.07);
    }
    .demo-page .scenario .role-tag {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--demo-text-dim);
      margin-bottom: 0.5rem;
    }
    .demo-page .scenario .title { font-weight: 600; font-size: 1rem; margin-bottom: 0.375rem; color: var(--demo-text); }
    .demo-page .scenario .desc { font-size: 0.8125rem; color: var(--demo-text-muted); margin: 0; }
    .demo-page .scenario .expected {
      margin-top: 0.75rem;
      font-size: 0.75rem;
      color: var(--demo-text-dim);
    }
    .demo-page .scenario .expected b { color: inherit; font-weight: 500; }
    .demo-page .scenario.success .expected b { color: var(--demo-success); }
    .demo-page .scenario.danger .expected b { color: var(--demo-danger); }
    .demo-page .scenario.warn .expected b { color: var(--demo-warn); }

    /* Side-by-side comparison */
    .demo-page .compare {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    @media (max-width: 760px) { .demo-page .compare { grid-template-columns: 1fr; } }
    .demo-page .col {
      background: var(--demo-bg-card);
      border: 1.5px solid var(--demo-border-bright);
      border-radius: 0.875rem;
      padding: 1.25rem;
    }
    .demo-page .col.bad { border-color: rgba(248, 113, 113, 0.35); }
    .demo-page .col.good { border-color: rgba(74, 222, 128, 0.35); }
    .demo-page .col .col-label {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.5rem;
      font-weight: 600;
    }
    .demo-page .col.bad .col-label { color: var(--demo-danger); }
    .demo-page .col.good .col-label { color: var(--demo-success); }
    .demo-page .col .col-title { font-weight: 600; font-size: 1rem; margin-bottom: 1rem; color: var(--demo-text); }
    .demo-page .field { margin-bottom: 0.75rem; }
    .demo-page .field:last-child { margin-bottom: 0; }
    .demo-page .field .k {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--demo-text-dim);
      margin-bottom: 0.125rem;
    }
    .demo-page .field .v { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.8125rem; color: var(--demo-text); word-break: break-all; }
    .demo-page .field .v.muted { color: var(--demo-text-muted); }
    .demo-page .claim-statement {
      margin-bottom: 1rem;
      padding: 0.875rem 1rem;
      background: rgba(74, 222, 128, 0.07);
      border: 1px solid rgba(74, 222, 128, 0.3);
      border-radius: 0.625rem;
      font-size: 0.875rem;
      line-height: 1.55;
    }
    .demo-page .claim-statement .claim-label {
      display: block;
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--demo-success);
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    .demo-page .claim-statement em {
      font-style: normal;
      color: var(--demo-text);
    }
    .demo-page .claim-statement em b {
      color: var(--demo-success-bright);
      font-weight: 600;
    }
    .demo-page .col .verdict-line {
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--demo-border);
      font-size: 0.8125rem;
    }
    .demo-page .col.bad .verdict-line { color: var(--demo-danger); }
    .demo-page .col.good .verdict-line { color: var(--demo-success-bright); }

    /* Buttons */
    .demo-page .btn-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.875rem;
    }
    @media (max-width: 760px) { .demo-page .btn-row { grid-template-columns: 1fr; } }
    .demo-page .demo-btn {
      padding: 0.875rem 1rem;
      border-radius: 0.625rem;
      font-size: 0.9375rem;
      font-weight: 600;
      cursor: pointer;
      border: 2px solid;
      background: transparent;
      transition: background 150ms, border-color 150ms, transform 80ms;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      color: var(--demo-text);
      width: 100%;
    }
    .demo-page .demo-btn:active { transform: translateY(1px); }
    .demo-page .demo-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .demo-page .demo-btn.primary {
      background: var(--demo-accent);
      color: #08080b;
      border-color: var(--demo-accent);
    }
    .demo-page .demo-btn.primary:hover:not(:disabled) { background: var(--demo-accent-bright); border-color: var(--demo-accent-bright); }
    .demo-page .demo-btn.danger {
      color: var(--demo-danger);
      border-color: rgba(248, 113, 113, 0.45);
      background: rgba(248, 113, 113, 0.06);
    }
    .demo-page .demo-btn.danger:hover:not(:disabled) { background: rgba(248, 113, 113, 0.14); border-color: rgba(248, 113, 113, 0.7); }
    .demo-page .demo-btn.warn {
      color: var(--demo-warn);
      border-color: rgba(251, 191, 36, 0.45);
      background: rgba(251, 191, 36, 0.06);
    }
    .demo-page .demo-btn.warn:hover:not(:disabled) { background: rgba(251, 191, 36, 0.14); border-color: rgba(251, 191, 36, 0.7); }
    .demo-page .btn-sub {
      margin-top: 0.5rem;
      font-size: 0.75rem;
      color: var(--demo-text-dim);
      text-align: center;
    }
    .demo-page .btn-sub b { color: inherit; font-weight: 500; }

    /* Status panel */
    .demo-page .status {
      background: var(--demo-bg-card);
      border: 1.5px solid var(--demo-border-bright);
      border-radius: 0.875rem;
      padding: 1.25rem;
      margin-top: 1.5rem;
    }
    .demo-page .status .head {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--demo-text-dim);
      margin-bottom: 0.75rem;
    }
    .demo-page .step-list { list-style: none; margin: 0; padding: 0; }
    .demo-page .step-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.625rem;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.8125rem;
      color: var(--demo-text-muted);
      margin-bottom: 0.5rem;
      line-height: 1.45;
    }
    .demo-page .step-list li:last-child { margin-bottom: 0; }
    .demo-page .step-list .step-icon {
      flex-shrink: 0;
      margin-top: 2px;
      width: 0.875rem;
      height: 0.875rem;
    }
    .demo-page .step-list .step-icon.pending {
      border: 2px solid var(--demo-accent-bright);
      border-top-color: transparent;
      border-radius: 50%;
      animation: demoSpin 0.9s linear infinite;
    }
    .demo-page .step-list .step-icon.done { color: var(--demo-success); }
    .demo-page .step-list .step-icon.fail { color: var(--demo-danger); }
    @keyframes demoSpin { to { transform: rotate(360deg); } }

    /* Verdict badge */
    .demo-page .verdict {
      margin-top: 1.5rem;
      border-radius: 0.875rem;
      padding: 1.25rem;
      display: flex;
      gap: 1rem;
      align-items: center;
      border: 1.5px solid;
    }
    .demo-page .verdict.allow {
      background: rgba(74, 222, 128, 0.08);
      border-color: rgba(74, 222, 128, 0.4);
    }
    .demo-page .verdict.deny {
      background: rgba(248, 113, 113, 0.08);
      border-color: rgba(248, 113, 113, 0.4);
    }
    .demo-page .verdict .verdict-icon { width: 2.5rem; height: 2.5rem; flex-shrink: 0; }
    .demo-page .verdict.allow .verdict-icon { color: var(--demo-success); }
    .demo-page .verdict.deny .verdict-icon { color: var(--demo-danger); }
    .demo-page .verdict .row1 {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .demo-page .verdict.allow .row1 { color: var(--demo-success-bright); }
    .demo-page .verdict.deny .row1 { color: var(--demo-danger); }
    .demo-page .verdict .row2 {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.75rem;
      margin-top: 0.25rem;
      opacity: 0.7;
    }

    /* Translation */
    .demo-page .translation {
      margin-top: 0.875rem;
      padding: 1rem 1.125rem;
      background: rgba(96, 165, 250, 0.06);
      border-left: 4px solid var(--demo-info);
      border-radius: 0 0.5rem 0.5rem 0;
      font-size: 0.9375rem;
      color: var(--demo-text);
    }
    .demo-page .translation b { color: var(--demo-info); }

    /* Vendor integration */
    .demo-page .integration { display: flex; flex-direction: column; gap: 1rem; }
    .demo-page .integration-row {
      background: var(--demo-bg-card);
      border-radius: 0.875rem;
      border: 1.5px solid var(--demo-border-bright);
      padding: 1rem 1.25rem;
    }
    .demo-page .integration-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
      margin-bottom: 0.625rem;
    }
    .demo-page .integration-label .dot {
      width: 0.625rem;
      height: 0.625rem;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .demo-page .integration-label.before { color: var(--demo-text-dim); }
    .demo-page .integration-label.before .dot { background: var(--demo-text-dim); }
    .demo-page .integration-label.add { color: var(--demo-accent-bright); }
    .demo-page .integration-label.add .dot { background: var(--demo-accent); }
    .demo-page .integration-label.after { color: var(--demo-success-bright); }
    .demo-page .integration-label.after .dot { background: var(--demo-success); }
    .demo-page .demo-code {
      background: rgba(0,0,0,0.4);
      padding: 0.875rem 1rem;
      border-radius: 0.5rem;
      margin: 0;
      overflow-x: auto;
      font-size: 0.8125rem;
      line-height: 1.6;
      color: var(--demo-text-muted);
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      white-space: pre;
    }

    /* Lifecycle trace */
    .demo-page .lifecycle ol { padding-left: 1.5rem; margin: 0.75rem 0 0; color: var(--demo-text-muted); }
    .demo-page .lifecycle ol li { margin-bottom: 0.5rem; }
    .demo-page .lifecycle ol li b { color: var(--demo-text); }
    .demo-page .lifecycle ol li code { color: var(--demo-accent-bright); }

    /* Details */
    .demo-page details summary { cursor: pointer; color: var(--demo-text-dim); font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: 0.75rem; user-select: none; }
    .demo-page details summary:hover { color: var(--demo-accent); }
    .demo-page details pre { background: rgba(0,0,0,0.4); padding: 1rem; border-radius: 0.5rem; overflow-x: auto; font-size: 0.75rem; color: var(--demo-text-muted); margin: 0.75rem 0 0; }

    .demo-page .demo-hidden { display: none !important; }
    .demo-page .demo-muted { color: var(--demo-text-muted); }
  </style>

  <div class="demo-page">
    <div class="wrap">

      <!-- HERO -->
      <section class="demo-section no-border demo-hero">
        <h1>Try AgentPKI <span class="accent">live</span>.</h1>
        <p>Three different agents hit a publisher's API. See what happens with and without AgentPKI. Real cryptography, real production Workers, ~150ms end-to-end.</p>
      </section>

      <!-- WHO THIS IS FOR — role cards -->
      <section class="demo-section">
        <h2>Who this is for</h2>
        <p class="lead">If you operate one of these, the demo below is going to look immediately useful. Click your role to jump to a tailored explanation later in the page.</p>
        <div class="roles" id="roles">
          <a class="role" href="#for-vendors" data-role="vendors">
            <div class="role-label">Bot-defense vendors</div>
            <div class="role-names">Cloudflare · DataDome · hCaptcha · Arkose · Castle · F5 · Akamai · Kasada</div>
            <p class="role-pitch">Additive signal in your existing pipeline. <b>Never overrides your score.</b> 30-line middleware drop-in. Verdict comes back in ~21ms at the edge.</p>
            <div class="role-cta">See how the integration looks &rarr;</div>
          </a>
          <a class="role" href="#for-publishers" data-role="publishers">
            <div class="role-label">Publishers fighting scrapers</div>
            <div class="role-names">Reuters · NYT · The Verge · Stack Overflow · dev.to · GitHub</div>
            <p class="role-pitch">Finally distinguish <b>legitimate AI traffic</b> from scrapers wearing agent costumes. Lower CAPTCHA rates for verified agents; higher block confidence for unsigned ones.</p>
            <div class="role-cta">See the comparison &rarr;</div>
          </a>
          <a class="role" href="#for-api" data-role="api">
            <div class="role-label">Sites with API tiers</div>
            <div class="role-names">Stripe · Shopify · Reddit · Twilio · Anthropic itself</div>
            <p class="role-pitch">Apply <b>scope-based rate limits</b> to authenticated agents. "Anthropic's tier-2 research bot" gets different quotas than "unknown agent traffic." Auditable, attributable, revocable.</p>
            <div class="role-cta">See the passport claim &rarr;</div>
          </a>
        </div>
      </section>

      <!-- STEP 1: pick a scenario -->
      <section class="demo-section">
        <h2><span class="step">1</span>Pick an agent</h2>
        <p class="lead">Each scenario is a real agent that hits a real publisher API (Reuters in the example). Click one to highlight it; the matching button in step 3 will run it.</p>
        <div class="scenarios" id="scenarios">
          <div class="scenario success active" data-id="anthropic">
            <div class="role-tag">Verified AI agent</div>
            <div class="title">Anthropic — research-bot-v3</div>
            <p class="desc">Anthropic's research bot, reading Reuters articles on behalf of a Claude user.</p>
            <div class="expected">Expected: <b>verdict: allow</b> &middot; tier 2</div>
          </div>
          <div class="scenario danger" data-id="tampered">
            <div class="role-tag">Tampered passport</div>
            <div class="title">Imposter — flipped signature</div>
            <p class="desc">Same Anthropic claim, but we flip a byte in the signature before sending. Cryptography catches it.</p>
            <div class="expected">Expected: <b>verdict: not_allowed</b> &middot; signature_invalid</div>
          </div>
          <div class="scenario warn" data-id="revoked">
            <div class="role-tag">Revoked key</div>
            <div class="title">Compromised — key rotation</div>
            <p class="desc">A passport from an old, revoked Anthropic key. The CRL says no — even though the signature is mathematically valid.</p>
            <div class="expected">Expected: <b>verdict: not_allowed</b> &middot; revoked_key</div>
          </div>
        </div>
      </section>

      <!-- STEP 2: comparison -->
      <section class="demo-section">
        <h2><span class="step">2</span>What the publisher's edge sees</h2>
        <p class="lead">Without AgentPKI, bot-defense vendors have to guess. With AgentPKI, the request carries a verifiable claim.</p>
        <div class="compare">
          <div class="col bad">
            <div class="col-label">Without AgentPKI</div>
            <div class="col-title">Today's reality at reuters.com</div>
            <div class="field">
              <div class="k">User-Agent</div>
              <div class="v">python-requests/2.31.0</div>
            </div>
            <div class="field">
              <div class="k">IP</div>
              <div class="v muted">3.123.45.67 (rotating residential)</div>
            </div>
            <div class="field">
              <div class="k">Signed identity claim</div>
              <div class="v muted">none</div>
            </div>
            <div class="field">
              <div class="k">Behavioral fingerprint</div>
              <div class="v muted">looks scripted</div>
            </div>
            <div class="verdict-line">
              &rarr; Bot-defense vendor: <b>"Could be Anthropic, could be a scraper. risk_score 0.65. Serve CAPTCHA."</b>
            </div>
          </div>
          <div class="col good" id="for-publishers">
            <div class="col-label">With AgentPKI</div>
            <div class="col-title">Same request, signed passport attached</div>
            <div class="claim-statement">
              <span class="claim-label">&#128220; What the passport actually says:</span>
              <em>"Anthropic claims this agent is their <b>research-bot-v3</b>, authorized for <b>read-only article access</b>, with <b>tier-2 (KYB-verified)</b> trust. Signed by Anthropic's Ed25519 key. Valid until 12:35 PM."</em>
            </div>
            <div class="field">
              <div class="k">Issuer</div>
              <div class="v"><code>anthropic.com</code></div>
            </div>
            <div class="field">
              <div class="k">Agent ID</div>
              <div class="v"><code>agent:anthropic.com/research-bot-v3</code></div>
            </div>
            <div class="field">
