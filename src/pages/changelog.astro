        body: 'Next.js + Postgres + magic-link auth via Resend. Bring a domain → verify via DNS TXT → generate Ed25519 signing keys (one-time reveal) → mint production passports. Full self-serve flow, including delete-issuer.',
        links: [{ label: 'dashboard.agentpki.dev', href: 'https://dashboard.agentpki.dev' }],
      },
      {
        tag: 'infra', title: 'Real-issuer Worker deployed at agentpki.dev',
        body: 'Production-grade Cloudflare Worker template. Real-issuer with full wrangler.toml coverage and static-directory Path B fallback. We are our own first issuer.',
        links: [{ label: 'github.com/agentpki/real-issuer', href: 'https://github.com/agentpki/real-issuer' }],
      },
    ],
  },
  {
    date: '2026-05-20',
    ships: [
      {
        tag: 'sdk', title: 'TypeScript SDK published — @agentpki/sdk on npm',
        body: 'Exports signPassport, verifyPassport, AgentPKI client (drop-in fetch wrapper that attaches PASETO + RFC 9421 Content-Digest + Signature). 21/21 tests passing. Initial 0.1.0-alpha.1, then 0.2.0-alpha.1 with v0.2 features.',
        links: [
          { label: 'github.com/agentpki/sdk-typescript', href: 'https://github.com/agentpki/sdk-typescript' },
          { label: 'npmjs.com/package/@agentpki/sdk', href: 'https://www.npmjs.com/package/@agentpki/sdk' },
        ],
      },
      {
        tag: 'sdk', title: 'Python SDK published — agentpki on PyPI',
        body: 'Byte-compatible wire format with the TypeScript SDK. 21/21 tests passing.',
        links: [
          { label: 'github.com/agentpki/sdk-python', href: 'https://github.com/agentpki/sdk-python' },
          { label: 'pypi.org/project/agentpki', href: 'https://pypi.org/project/agentpki/' },
        ],
      },
      {
        tag: 'infra', title: 'Reference verifier deployed at verify.agentpki.dev',
        body: 'Cloudflare Worker. Sub-50ms p99 globally. KV-backed issuer-pubkey cache. Durable Object replay detection. CRL revocation checking.',
        links: [{ label: 'github.com/agentpki/verifier', href: 'https://github.com/agentpki/verifier' }],
      },
      {
        tag: 'protocol', title: 'v0.1 protocol spec',
        body: 'RFC-style document at /spec/v0.1. PASETO v4 + Ed25519. Apache 2.0.',
        links: [{ label: 'agentpki.dev/spec/v0.1', href: '/spec/v0.1' }],
      },
    ],
  },
];

// Sort by date desc so the page never drifts even if entries are added out of order
log.sort((a, b) => b.date.localeCompare(a.date));

// Pre-format date for display
function fmtDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
}

// Tag color stripe
const tagStyles: Record<string, { color: string; label: string }> = {
  'protocol':  { color: '#a78bfa', label: 'PROTOCOL' },
  'sdk':       { color: '#6ee7b7', label: 'SDK' },
  'dev-tool':  { color: '#93c5fd', label: 'DEV TOOL' },
  'page':      { color: '#fbbf24', label: 'PAGE' },
  'extension': { color: '#fca5a5', label: 'EXTENSION' },
  'infra':     { color: '#67e8f9', label: 'INFRA' },
};
---
<Base
  title="Changelog — AgentPKI"
  description="Everything we've shipped, with dates. Reverse-chronological log of protocol updates, SDKs, dev tools, marketing pages, and infrastructure."
>
  <Nav />

  <section class="max-w-5xl mx-auto px-6 pt-12 pb-6">
    <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">Changelog &middot; newest first</p>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight mb-3">
      What shipped, when.
    </h1>
    <p class="text-[color:var(--color-text-muted)] max-w-3xl text-base sm:text-lg leading-relaxed">
      Permanent record of every public release. The homepage&rsquo;s &ldquo;Just shipped&rdquo; panel covers the most recent week; this page is the durable archive of everything before that.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-16">
    {log.map((day) => (
      <div class="mb-10">
        <div class="flex items-baseline gap-4 mb-4 pb-2 border-b border-[color:var(--color-border)]">
          <h2 class="text-xl font-semibold tracking-tight font-mono text-[color:var(--color-text)]">{fmtDate(day.date)}</h2>
          {day.note && <span class="text-xs text-[color:var(--color-text-dim)] italic">{day.note}</span>}
        </div>
        <div class="space-y-4">
          {day.ships.map((s) => {
            const style = tagStyles[s.tag] || { color: '#9ca3af', label: s.tag.toUpperCase() };
            return (
              <div class="changelog-card" style={`--tag-color: ${style.color};`}>
                <div class="changelog-card-stripe" aria-hidden="true"></div>
                <div class="changelog-card-body">
                  <div class="flex items-center gap-3 mb-2 flex-wrap">
                    <span class="changelog-tag" style={`color: ${style.color}; border-color: ${style.color}40; background-color: ${style.color}10;`}>{style.label}</span>
                    <h3 class="text-base sm:text-lg font-semibold text-[color:var(--color-text)] leading-tight">{s.title}</h3>
                  </div>
                  <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed mb-3">{s.body}</p>
                  {s.links && s.links.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {s.links.map((l) => (
                        <a href={l.href} target={l.href.startsWith('http') ? '_blank' : null} rel={l.href.startsWith('http') ? 'noreferrer' : null}
                           class="changelog-link">{l.label} &rarr;</a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}

    <div class="mt-10 p-5 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/50 text-sm text-[color:var(--color-text-muted)]">
      <p class="mb-2">
        <strong class="text-[color:var(--color-text)]">Want a feed?</strong> This page is plain markup; scrape it. If you want a real RSS/Atom feed, open an issue at <a class="text-[color:var(--color-accent-bright)] hover:underline" href="https://github.com/agentpki/web/issues" target="_blank" rel="noreferrer">github.com/agentpki/web/issues</a> &mdash; we&rsquo;ll add it.
      </p>
      <p>
        Earlier history (pre-2026-05-20 prototype era) lives in the commit graph at <a class="text-[color:var(--color-accent-bright)] hover:underline" href="https://github.com/agentpki" target="_blank" rel="noreferrer">github.com/agentpki</a>.
      </p>
    </div>
  </section>

  <Footer />
</Base>

<style is:global>
  .changelog-card {
    display: flex;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border-bright);
    background: rgba(15, 15, 24, 0.45);
    overflow: hidden;
    transition: border-color 0.15s, background 0.15s;
  }
  .changelog-card:hover {
    border-color: var(--tag-color, var(--color-accent));
    background: rgba(15, 15, 24, 0.7);
  }
  .changelog-card-stripe {
    width: 5px;
    background: var(--tag-color, var(--color-accent));
    flex-shrink: 0;
    box-shadow: 0 0 14px var(--tag-color, var(--color-accent));
  }
  .changelog-card-body {
    padding: 1.1rem 1.3rem;
    flex: 1;
  }
  .changelog-tag {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    padding: 0.2rem 0.55rem;
    border-radius: 0.3rem;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .changelog-link {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    color: var(--color-accent-bright);
    background: rgba(167, 139, 250, 0.08);
    border: 1px solid rgba(167, 139, 250, 0.18);
    padding: 0.35rem 0.6rem;
    border-radius: 0.35rem;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .changelog-link:hover {
    background: rgba(167, 139, 250, 0.15);
    border-color: rgba(167, 139, 250, 0.4);
  }
</style>
