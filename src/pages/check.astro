<script is:inline>
(function () {
  const VERIFIER = 'https://verify.agentpki.dev';
  const DEMO_ISSUER = 'https://demo.agentpki.dev';

  const $ = (id) => document.getElementById(id);
  const fmt = (n) => typeof n === 'number' ? n.toFixed(2) : String(n);

  // ═══════════════════ INSTALLATION UUID (Phase 4) ═══════════════════
  // A random UUID generated once per browser, used as the `reporter` on
  // any abuse report. No PII, no cross-site identifier — just an
  // anonymous handle so the verifier can rate-limit a single reporter
  // and reject duplicates.
  const INSTALL_KEY = 'agentpki:install_id';
  function getInstallId() {
    let v;
    try { v = localStorage.getItem(INSTALL_KEY); } catch { v = null; }
    if (v && /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(v)) return v;
    v = (crypto && crypto.randomUUID) ? crypto.randomUUID()
        : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
            const r = Math.random() * 16 | 0;
            return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
          });
    try { localStorage.setItem(INSTALL_KEY, v); } catch {}
    return v;
  }

  // ═══════════════════ EXAMPLE LINKS (mint live tokens against demo) ═══════════════════
  async function mintExample(kind) {
    try {
      if (kind === 'verified') {
        const r = await (await fetch(DEMO_ISSUER + '/mint?sub=anthropic')).json();
        return r.token;
      } else if (kind === 'revoked') {
        const r = await (await fetch(DEMO_ISSUER + '/mint?sub=anthropic&revoked=1')).json();
        return r.token;
      } else if (kind === 'unverified') {
        // A plausible identifier that won't have a passport
        return 'agent:example.com/some-unregistered-bot';
      }
    } catch (e) {
      console.warn('[check] mintExample failed', e);
    }
    return '';
  }

  // ═══════════════════ VERIFY FLOW ═══════════════════
  let lastResultSnapshot = null;     // for sharing
  let lastInputUsed     = '';

  function renderSkeleton() {
    $('resultArea').innerHTML =
      '<div class="skeleton">' +
      '<div class="skel"></div><div class="skel"></div><div class="skel"></div><div class="skel"></div>' +
      '</div>';
  }

  function escape(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
  }

  function formatTs(unixSec) {
    if (!unixSec) return '—';
    try {
      const d = new Date(unixSec * 1000);
      return d.toLocaleString();
    } catch { return '—'; }
  }

  // Build a single labelled field (label-on-top, value-below — boxed)
  function field(k, v) {
    return (
      '<div class="result-field">' +
        '<span class="result-field-label">' + escape(k) + '</span>' +
        '<span class="result-field-value">' + v + '</span>' +
      '</div>'
    );
  }

  // Build a header band: icon + title (+ optional perf badge)
  function header(icon, title, ms) {
    const perf = (typeof ms === 'number' && ms > 0)
      ? '<span class="perf-badge"><span class="perf-icon" aria-hidden="true"></span>' + ms + 'ms</span>'
      : '';
    return (
      '<header class="result-header">' +
        '<span class="result-icon" aria-hidden="true">' + icon + '</span>' +
        '<h2 class="result-title">' + escape(title) + '</h2>' +
        perf +
      '</header>'
    );
  }

  function buildVerifiedCard(input, result, shareUrl) {
    const p = result.passport || {};
    const scopes = Array.isArray(p.scopes) && p.scopes.length ? p.scopes.join(', ') : '(none declared)';
    const abuse = typeof result.abuse_score === 'number' ? fmt(result.abuse_score) : '—';
    const tier = typeof p.tier === 'number' ? p.tier : '—';
    const issuerLine = p.issuer_name
      ? '<code>' + escape(p.issuer) + '</code> &middot; ' + escape(p.issuer_name)
      : '<code>' + escape(p.issuer || '—') + '</code>';
    const elapsed = typeof result.elapsed_ms === 'number' ? result.elapsed_ms : null;
    return (
      '<div class="result-card verified">' +
        header('&#9989;', 'Verified', elapsed) +
        '<div class="result-body">' +
          field('Issuer', issuerLine) +
          field('Tier', escape(String(tier))) +
          field('Identity', '<code>' + escape(p.agent_id || '—') + '</code>') +
          field('Scopes', '<code>' + escape(scopes) + '</code>') +
          field('Reputation', 'abuse score: <strong>' + escape(String(abuse)) + '</strong> &middot; ' +
            (typeof p.expires_at === 'number' ? 'expires ' + formatTs(p.expires_at) : 'TTL unknown')) +
          field('Last verified', formatTs(Math.floor(Date.now() / 1000)) + ' (just now)') +
        '</div>' +
        '<div class="result-actions">' +
          (shareUrl
            ? '<button type="button" class="action-btn btn-primary" data-action="copy-url" data-url="' + escape(shareUrl) + '"><span aria-hidden="true">&#128203;</span> Copy verification URL</button>' +
              '<button type="button" class="action-btn btn-secondary" data-action="share" data-url="' + escape(shareUrl) + '"><span aria-hidden="true">&#8599;</span> Share this verification</button>'
            : '<button type="button" class="action-btn btn-secondary" data-action="share-this"><span aria-hidden="true">&#8599;</span> Share this verification</button>') +
          '<button type="button" class="action-btn btn-danger" data-action="report"><span aria-hidden="true">&#9873;</span> Report concern</button>' +
        '</div>' +
        '<div class="result-footer">' +
          '<p>Verified means the agent operator has cryptographically proven its identity to AgentPKI. ' +
          'It does <strong>not</strong> mean the agent is endorsed or recommended — only that its identity ' +
          'is real and traceable. <a href="/how-verification-works">Learn more →</a></p>' +
        '</div>' +
      '</div>'
    );
  }

  function buildRevokedCard(input, result, shareUrl) {
    const p = result.passport || {};
    const reason = result.failure_reason || 'unknown';
    const detail = result.failure_detail || '';
    return (
      '<div class="result-card revoked">' +
        header('&#9940;', 'Do Not Trust') +
        '<div class="result-body">' +
          field('Status', '<strong>REVOKED</strong>') +
          field('Reason', '<code>' + escape(reason) + '</code>' + (detail ? ' &middot; ' + escape(detail) : '')) +
          (p.issuer ? field('Issuer', '<code>' + escape(p.issuer) + '</code>') : '') +
          (p.agent_id ? field('Identity', '<code>' + escape(p.agent_id) + '</code>') : '') +
          field('What to do', 'Do not share information with this agent. If you have already interacted, review your account activity.') +
        '</div>' +
        '<div class="result-actions">' +
          (shareUrl
            ? '<button type="button" class="action-btn btn-primary" data-action="copy-url" data-url="' + escape(shareUrl) + '"><span aria-hidden="true">&#128203;</span> Share this warning</button>'
            : '<button type="button" class="action-btn btn-secondary" data-action="share-this"><span aria-hidden="true">&#8599;</span> Share this warning</button>') +
          '<button type="button" class="action-btn btn-danger" data-action="report"><span aria-hidden="true">&#9873;</span> Report incident</button>' +
        '</div>' +
        '<div class="result-footer">' +
          '<p>Revocation means a previously verified identity has been canceled — usually because of fraud, abuse, ' +
          'or security compromise. This is the strongest "do not trust" signal AgentPKI provides. ' +
          '<a href="/how-verification-works">Learn more →</a></p>' +
        '</div>' +
      '</div>'
    );
  }

  function buildUnverifiedCard(input) {
    return (
      '<div class="result-card unverified">' +
        header('&#9888;', 'Unverified') +
        '<div class="result-body">' +

          // Plain-English explanation (boxed prose)
          '<div class="result-prose">' +
            '<p><strong>We could not find an AgentPKI passport for this identifier.</strong></p>' +
            '<p>Most AI agents have not yet registered with AgentPKI. "Unverified" means we could not find ' +
            'a cryptographic identity for this agent — <strong>not that it is necessarily dangerous</strong>. ' +
            'But trust has not been established yet.</p>' +
          '</div>' +

          // Safety checklist (boxed bullet list)
          '<div class="result-checklist">' +
            '<p class="result-checklist-title">Safety steps</p>' +
            '<ul>' +
              '<li>Do not share passwords, account numbers, or social security numbers.</li>' +
              '<li>Verify the identity directly through the company&rsquo;s official channels.</li>' +
              '<li>Be skeptical of urgency or payment requests.</li>' +
            '</ul>' +
          '</div>' +

          // Heuristic checks block
          '<div class="heuristic-block" id="heuristicBlock">' +
            '<p class="heuristic-title">Heuristic checks we ran <span class="signal-tag">signal not proof</span></p>' +
            '<div id="heuristicRows" class="heuristic-list">' +
              '<div class="heuristic-row row-inc">' +
                '<span class="status-pill status-inc">RUNNING</span>' +
                '<div class="h-info">' +
                  '<div class="h-name">Checking domain, phone, and community signals…</div>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>' +

        '</div>' +
        '<div class="result-actions">' +
          '<button type="button" class="action-btn btn-danger" data-action="report"><span aria-hidden="true">&#9873;</span> Report this as a scam</button>' +
          '<a href="/how-verification-works" class="action-btn btn-tertiary"><span aria-hidden="true">&#9432;</span> How verification works</a>' +
        '</div>' +
        '<div class="result-footer">' +
          '<p>AgentPKI is a brand-new open standard. As issuers register, fewer checks will return Unverified. ' +
          '<a href="/how-verification-works">Learn more →</a></p>' +
        '</div>' +
      '</div>'
    );
  }

  function buildErrorCard(message) {
    return (
      '<div class="result-card error">' +
        header('&#10006;', 'Error') +
        '<div class="result-body">' +
          '<div class="result-prose"><p>' + escape(message) + '</p></div>' +
        '</div>' +
      '</div>'
    );
  }

  // Decide which card to render based on verifier response
  function classifyResult(result) {
    if (!result) return 'unverified';
    if (result.verdict === 'allow') return 'verified';
    if (result.verdict === 'deny') {
      const r = result.failure_reason || '';
      if (r === 'revoked' || r === 'revoked_key' || r === 'no_issuer_key' || /revok/i.test(r)) return 'revoked';
      if (r === 'expired' || r === 'malformed' || r === 'signature_invalid' || r === 'sig_invalid') return 'revoked';
      // Other denies (e.g. no_passport_found) → unverified
      return 'unverified';
    }
    return 'unverified';
  }

  async function runVerify(input) {
    lastInputUsed = input;
    renderSkeleton();
    const btn = $('checkSubmit');
    btn.classList.add('loading'); btn.disabled = true;

    // Decide whether the input is a token (starts with v4.public.) or an identifier
    let verifyResult = null;
    let verifyError  = null;
    const looksLikeToken = /^v4\.public\.[A-Za-z0-9._-]+$/.test(input.trim());

    if (looksLikeToken) {
      try {
        const r = await fetch(VERIFIER + '/v1/verify', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ token: input.trim() }),
        });
        verifyResult = await r.json();
      } catch (e) {
        verifyError = e && e.message ? e.message : String(e);
      }
    }

    let cardHtml;
    let shareUrl = null;
    let kind;

    if (verifyError) {
      cardHtml = buildErrorCard("Couldn't reach verify.agentpki.dev: " + verifyError);
      kind = 'error';
    } else if (verifyResult) {
      kind = classifyResult(verifyResult);
      // Try to store a snapshot for sharing (best-effort; UI works either way)
      try {
        const storeRes = await fetch(VERIFIER + '/v1/verification/store', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ input: input, result: verifyResult, ttl_seconds: 86400 }),
        });
        if (storeRes.ok) {
          const stored = await storeRes.json();
          shareUrl = window.location.origin + '/check/result/' + stored.id;
          lastResultSnapshot = { id: stored.id, kind: kind, url: shareUrl };
        }
      } catch { /* swallow */ }

      if (kind === 'verified') cardHtml = buildVerifiedCard(input, verifyResult, shareUrl);
      else if (kind === 'revoked') cardHtml = buildRevokedCard(input, verifyResult, shareUrl);
      else cardHtml = buildUnverifiedCard(input);
    } else {
      // Input wasn't a recognizable token — go straight to unverified + heuristics
      kind = 'unverified';
      cardHtml = buildUnverifiedCard(input);
    }

    $('resultArea').innerHTML = cardHtml;

    // Run heuristic checks for unverified-style results
    if (kind === 'unverified') {
      await runHeuristics(input);
    }

    btn.classList.remove('loading'); btn.disabled = false;
  }

  async function runHeuristics(input) {
    const rowsHost = $('heuristicRows');
    if (!rowsHost) return;
    try {
      const res = await fetch(VERIFIER + '/v1/check-heuristic', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ input: input }),
      });
      const body = await res.json();
      // Render the overall verdict banner at the top — gives the user ONE
      // clear summary so they don't have to read three rows to know.
      let overallHtml = '';
      if (body.overall && body.overall_summary) {
        const ovIcon = body.overall === 'flagged' ? '&#9888;'         // ⚠
                     : body.overall === 'clean'   ? '&#10003;'        // ✓
                                                  : '&#8505;';        // ℹ
        const ovTitle = body.overall === 'flagged' ? 'Caution — heuristic flag'
                      : body.overall === 'clean'   ? 'No heuristic flags'
                      :                              'Inconclusive';
        overallHtml =
          '<div class="heuristic-overall overall-' + escape(body.overall) + '">' +
            '<span class="ov-icon" aria-hidden="true">' + ovIcon + '</span>' +
            '<div class="ov-text">' +
              '<span class="ov-title">' + escape(ovTitle) + '</span>' +
              escape(body.overall_summary) +
            '</div>' +
          '</div>';
      }

      if (!body.checks || body.checks.length === 0) {
        rowsHost.innerHTML = overallHtml +
          '<div class="heuristic-row row-na"><span class="status-pill status-na">none</span><div class="h-info"><div class="h-name">' + escape(body.note || 'No domain or phone extracted from the input.') + '</div></div></div>';
        return;
      }
      const SOURCE_LABEL = {
        agentpki_curated_phishing_list: 'AgentPKI curated phishing list',
        agentpki_phishing_lists: 'AgentPKI phishing lists (curated + 5k aggregated)',
        internal: 'AgentPKI community reports',
        google_safe_browsing: 'Google Safe Browsing',
      };
      const NAME_LABEL = {
        domain_reputation: 'Domain reputation',
        phone_reputation: 'Phone reputation',
        community_reputation: 'Community reputation',
      };
      const rowsHtml = body.checks.map((c) => {
        const isFlagged = c.status === 'flagged';
        const isClean = c.status === 'clean';
        const isNa = c.status === 'not_available';
        const rowClass = isFlagged ? 'row-flagged' : isClean ? 'row-clean' : isNa ? 'row-na' : 'row-inc';
        const stClass = isFlagged ? 'status-flagged' : isClean ? 'status-clean' : isNa ? 'status-na' : 'status-inc';
        const stLabel = isNa ? 'N/A' : c.status.toUpperCase();
        const niceName = NAME_LABEL[c.name] || c.name;
        const niceSource = SOURCE_LABEL[c.source] || c.source;
        return (
          '<div class="heuristic-row ' + rowClass + '">' +
            '<span class="status-pill ' + stClass + '">' + escape(stLabel) + '</span>' +
            '<div class="h-info">' +
              '<div class="h-name">' + escape(niceName) + '</div>' +
              '<div class="h-source">via ' + escape(niceSource) + '</div>' +
            '</div>' +
            (c.detail ? '<div class="h-detail">' + escape(c.detail) + '</div>' : '') +
          '</div>'
        );
      }).join('');
      rowsHost.innerHTML =
        overallHtml +
        '<p class="heuristic-detail-label">Per-source breakdown</p>' +
        rowsHtml;
    } catch (e) {
      rowsHost.innerHTML = '<div class="heuristic-row row-inc"><span class="status-pill status-inc">ERROR</span><div class="h-info"><div class="h-name">Heuristic checks unavailable.</div></div></div>';
    }
  }

  // ═══════════════════ ACTION BUTTONS DELEGATION ═══════════════════
  document.addEventListener('click', async (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;
    const btn = target.closest('[data-action]');
    if (!btn) return;
    const action = btn.dataset.action;

    if (action === 'copy-url' || action === 'share') {
      const url = btn.dataset.url || '';
      if (!url) return;
      // Remember the button's original HTML so we restore THE SAME label
      // afterwards — works for both verified ('Copy verification URL') and
      // revoked ('Share this warning') cards.
      const original = btn.innerHTML;
      if (action === 'share' && navigator.share) {
        try {
          await navigator.share({ title: 'AgentPKI verification', url });
        } catch {}
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = '✓ Copied';
        setTimeout(() => { btn.innerHTML = original; }, 1600);
      } catch {}
    } else if (action === 'share-this') {
      const original = btn.innerHTML;
      try {
        await navigator.clipboard.writeText(window.location.origin + '/check?q=' + encodeURIComponent(lastInputUsed));
        btn.textContent = '✓ Copied URL';
        setTimeout(() => { btn.innerHTML = original; }, 1800);
      } catch {}
    } else if (action === 'report') {
      openReportModal();
    }
  });

  // Curl-snippet copy button
  const copyCurlBtn = $('copyCurl');
  if (copyCurlBtn) {
    copyCurlBtn.addEventListener('click', async () => {
      const text = "curl -X POST https://verify.agentpki.dev/v1/verify \\\n    -H 'content-type: application/json' \\\n    -d '{\"token\":\"v4.public.eyJpc3M...\"}'";
      try {
        await navigator.clipboard.writeText(text);
        copyCurlBtn.textContent = '✓ Copied';
        setTimeout(() => { copyCurlBtn.textContent = 'Copy'; }, 1500);
      } catch {}
    });
  }

  // ═══════════════════ INPUT + EXAMPLE LINKS ═══════════════════
  document.querySelectorAll('[data-example]').forEach((el) => {
    el.addEventListener('click', async () => {
      const kind = el.dataset.example;
      el.disabled = true;
      try {
        const token = await mintExample(kind);
        $('checkInput').value = token;
        $('checkInput').focus();
        // User clicks Verify themselves — do NOT auto-run.
      } finally {
        el.disabled = false;
      }
    });
  });

  $('checkForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const v = $('checkInput').value.trim();
    if (!v) return;
    runVerify(v);
  });

  // Pre-fill from query string ?q= (used by Share-this fallback)
  try {
    const q = new URL(window.location.href).searchParams.get('q');
    if (q) {
      $('checkInput').value = q;
      setTimeout(() => runVerify(q), 200);
    }
  } catch {}

  // ═══════════════════ REPORT MODAL (Phase 4) ═══════════════════
  const modal = $('reportModal');
  const ctxEl = $('reportContext');
  const charCount = $('reportCharCount');
  const consentEl = $('reportShotConsent');
  const picker = $('shotPicker');
  const shotInput = $('reportShot');
  const shotPreview = $('shotPreview');
  const shotPreviewWrap = $('shotPreviewWrap');
  const shotClear = $('shotClear');
  let shotDataUrl = null;

  function openReportModal() {
    if (!modal) return;
    modal.hidden = false;
    setTimeout(() => ctxEl && ctxEl.focus(), 50);
  }
  function closeReportModal() {
    if (!modal) return;
    modal.hidden = true;
    // Reset state
    if (ctxEl) ctxEl.value = '';
    if (charCount) charCount.textContent = '0';
    if (consentEl) consentEl.checked = false;
    picker.hidden = true;
    shotPreviewWrap.hidden = true;
    if (shotInput) shotInput.value = '';
    shotDataUrl = null;
    $('reportForm').hidden = false;
    $('reportResult').hidden = true;
  }

  document.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeReportModal));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal && !modal.hidden) closeReportModal(); });

  if (ctxEl && charCount) {
    ctxEl.addEventListener('input', () => { charCount.textContent = String(ctxEl.value.length); });
  }
  if (consentEl) {
    consentEl.addEventListener('change', () => {
      picker.hidden = !consentEl.checked;
      if (!consentEl.checked) {
        shotInput.value = '';
        shotPreviewWrap.hidden = true;
        shotDataUrl = null;
      }
    });
  }
  if (shotInput) {
    shotInput.addEventListener('change', () => {
      const file = shotInput.files && shotInput.files[0];
      if (!file) return;
      if (file.size > 500 * 1024) {
        alert('Please choose an image under 500 KB.');
        shotInput.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        shotDataUrl = String(reader.result || '');
        shotPreview.src = shotDataUrl;
        shotPreviewWrap.hidden = false;
      };
      reader.readAsDataURL(file);
    });
  }
  if (shotClear) {
    shotClear.addEventListener('click', () => {
      shotInput.value = '';
      shotPreviewWrap.hidden = true;
      shotDataUrl = null;
    });
  }

  $('reportForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const ctx = ctxEl.value.trim();
    if (ctx.length < 10) return;
    const category = $('reportCategory').value;
    const severity = $('reportSeverity').value;
    const reporter = getInstallId();
    const submit = $('reportSubmit');
    submit.disabled = true; submit.textContent = 'Submitting…';

    const payload = {
      v: 1,
      reporter: reporter,
      reporter_kind: 'web',
      agent_id: lastInputUsed.slice(0, 256),
      category: category,
      severity: severity,
      occurred_at: Math.floor(Date.now() / 1000),
      description: ctx + (shotDataUrl ? '\n\n[screenshot attached, ' + Math.round(shotDataUrl.length * 3 / 4 / 1024) + ' KB base64]' : ''),
      evidence_urls: shotDataUrl ? [shotDataUrl] : undefined,
    };

    // Safeguard: if we don't have a non-empty input to attach the report
    // to, the verifier will reject for missing identifier. Fail with a
    // friendly message instead of a network round-trip.
    if (!lastInputUsed || lastInputUsed.length < 1) {
      const out = $('reportResult');
      $('reportForm').hidden = true;
      out.hidden = false;
      out.className = 'report-result error';
      out.innerHTML = '<h3 style="margin:0 0 0.5rem;">Cannot file report</h3>' +
        '<p style="font-size:0.85rem;">No agent identifier was attached to your verification result. Run a verification first, then report.</p>' +
        '<button type="button" class="btn-ghost" data-close style="margin-top:1.5rem;">Close</button>';
      out.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeReportModal));
      submit.disabled = false; submit.textContent = 'Submit report';
      return;
    }

    try {
      const res = await fetch(VERIFIER + '/v1/abuse/report', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      let body;
      try { body = await res.json(); } catch { body = null; }
      $('reportForm').hidden = true;
      const out = $('reportResult');
      out.hidden = false;
      if (res.ok && body && body.accepted) {
        out.className = 'report-result success';
        out.innerHTML = '<div style="font-size:2.5rem; margin-bottom:0.5rem;">&#9989;</div>' +
          '<h3 style="margin:0 0 0.5rem; font-size:1.05rem;">Report received</h3>' +
          '<p style="margin:0 0 1rem; font-size:0.85rem; color:var(--color-text-muted);">Thank you. Your report has been logged anonymously.</p>' +
          '<p style="font-size:0.7rem; color:var(--color-text-dim);">Report ID: <code>' + escape(body.report_id || 'unknown') + '</code></p>' +
          '<button type="button" class="btn-ghost" data-close style="margin-top:1.5rem;">Close</button>';
        out.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeReportModal));
      } else {
        out.className = 'report-result error';
        const errSummary = body && (body.detail || body.error)
          ? escape(String(body.detail || body.error))
          : 'HTTP ' + res.status + ' from verifier';
        out.innerHTML = '<h3 style="margin:0 0 0.5rem;">Report failed</h3>' +
          '<p style="font-size:0.85rem; color:var(--color-text-muted);">' + errSummary + '</p>' +
          '<details style="margin-top:0.65rem; font-size:0.7rem; color:var(--color-text-dim);">' +
            '<summary style="cursor:pointer;">Show raw response (debug)</summary>' +
            '<pre style="margin-top:0.4rem; background:#0a0a0f; padding:0.6rem; border-radius:4px; overflow-x:auto; font-size:0.65rem; max-height:160px;">' +
              escape(JSON.stringify(body || { status: res.status, statusText: res.statusText }, null, 2)) +
            '</pre>' +
          '</details>' +
          '<button type="button" class="btn-ghost" data-close style="margin-top:1.25rem;">Close</button>';
        out.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeReportModal));
      }
    } catch (e) {
      $('reportForm').hidden = true;
      const out = $('reportResult');
      out.hidden = false;
      out.className = 'report-result error';
      out.innerHTML = '<h3 style="margin:0 0 0.5rem;">Network error</h3>' +
        '<p style="font-size:0.85rem;">' + escape(e && e.message ? e.message : String(e)) + '</p>' +
        '<button type="button" class="btn-ghost" data-close style="margin-top:1.5rem;">Close</button>';
      out.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeReportModal));
    } finally {
      submit.disabled = false; submit.textContent = 'Submit report';
    }
  });
})();
</script>
