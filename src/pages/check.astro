---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <main class="max-w-none px-2 sm:px-3 lg:px-4 pt-10 pb-16">

    <!-- Hero -->
    <section class="text-center mb-7">
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">
        Is this AI agent <span class="hero-accent-text">legitimate</span>?
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[color:var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto">
        Paste an agent ID, passport token, or URL. We'll check it against the AgentPKI network in under a second.
      </p>
    </section>

    <!-- Banner: adoption disclosure -->
    <div class="banner-adoption mb-4" role="note">
      <p class="text-xs sm:text-sm">
        AgentPKI is in early days. Most AI agents have not yet registered.
        We expect "Unverified" to be the most common result today and become rarer over time.
        <a href="/how-verification-works" class="underline hover:text-[color:var(--color-accent-bright)]">How does this work?</a>
      </p>
    </div>

    <!-- Example links — ABOVE the input. Click any to auto-fill + verify. -->
    <div class="example-wrap" role="group" aria-label="Example checks">
      <p class="example-instruction">
        New here? <strong>Click one of these to try it now &mdash; no typing required.</strong>
      </p>
      <div class="example-row">
        <button type="button" class="example-link" data-example="verified">
          <span class="dot dot-green"></span>
          Try a verified agent
        </button>
        <button type="button" class="example-link" data-example="unverified">
          <span class="dot dot-yellow"></span>
          Try an unverified agent
        </button>
        <button type="button" class="example-link" data-example="revoked">
          <span class="dot dot-red"></span>
          Try a revoked agent
        </button>
      </div>
    </div>

    <!-- Input + verify (manual) -->
    <p class="manual-or">&mdash; or paste your own &mdash;</p>
    <form id="checkForm" class="check-form" novalidate>
      <label for="checkInput" class="sr-only">Agent identifier or passport token</label>
      <div class="input-group">
        <textarea
          id="checkInput"
          name="check-input"
          placeholder="Paste agent ID, passport token, or URL"
          rows="3"
          required
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          aria-describedby="inputHelp"
        ></textarea>
        <button type="submit" id="checkSubmit">
          <span class="btn-label">Verify</span>
          <svg class="btn-spinner" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="40 60"/>
          </svg>
        </button>
      </div>
      <p id="inputHelp" class="text-xs text-[color:var(--color-text-dim)] mt-2">
        Examples: <code>v4.public.eyJpc3M&hellip;</code> (passport token) &middot; <code>agent:anthropic/research-bot-v3</code> &middot; <code>example.com</code>
      </p>
    </form>

    <!-- Prominent helper callout right below the input -->
    <div class="helper-callout">
      <p class="helper-callout-eyebrow">No passport? No problem.</p>
      <p class="helper-callout-body">
        Paste any <strong class="helper-callout-strong">domain</strong> or <strong class="helper-callout-strong">URL</strong> &mdash; we'll check it against our community-aggregated
        <strong class="helper-callout-num">5,000+ known phishing domains</strong>, community-reported abuse, and (when configured) <strong>Google Safe Browsing</strong>.
      </p>
    </div>

    <!-- Always-visible developer curl box (no collapse) -->
    <div class="dev-curl">
      <div class="dev-curl-head">
        <span class="dev-curl-icon">&lt;/&gt;</span>
        <span>For developers &mdash; verify via curl in 1 line</span>
        <span class="dev-curl-tag">no API key required</span>
      </div>
      <div class="dev-curl-body">
        <p class="dev-curl-line">Run this against the public verifier:</p>
        <pre id="curlSample"><span class="curl-prompt">$</span> curl -X POST <span class="curl-flag">https://verify.agentpki.dev/v1/verify</span> \
    -H <span class="curl-arg">'content-type: application/json'</span> \
    -d <span class="curl-arg">'&#123;"token":"v4.public.eyJpc3M..."&#125;'</span></pre>
        <button type="button" class="dev-curl-copy" id="copyCurl">Copy</button>
        <p class="dev-curl-foot">
          <strong class="dev-curl-foot-strong">Try the heuristic endpoint too:</strong>
          <code>POST /v1/check-heuristic</code> with <code>&#123;"input":"&lt;anything&gt;"&#125;</code>.
          Full API at <a href="/spec/v0.1">/spec/v0.1</a>, source at <a href="https://github.com/agentpki/verifier">github.com/agentpki/verifier</a>.
        </p>
      </div>
    </div>

    <!-- Result container -->
    <div id="resultArea" class="result-area" aria-live="polite"></div>

    <!-- Report modal (hidden until invoked) -->
    <div id="reportModal" class="report-modal" hidden role="dialog" aria-modal="true" aria-labelledby="reportModalTitle">
      <div class="report-modal-backdrop" data-close></div>
      <div class="report-modal-content">
        <header class="report-modal-head">
          <h2 id="reportModalTitle">Report a scam or abuse</h2>
          <button type="button" class="report-modal-close" data-close aria-label="Close">&#10005;</button>
        </header>
        <form id="reportForm">
          <div class="field">
            <label for="reportContext">What happened? <span class="text-[color:var(--color-text-dim)]">(10–1000 chars)</span></label>
            <textarea id="reportContext" rows="4" minlength="10" maxlength="1000" required placeholder="e.g. The agent claimed to be Stripe billing support and asked for my credit card number to 'verify identity'."></textarea>
            <div class="char-count"><span id="reportCharCount">0</span>/1000</div>
          </div>

          <div class="field">
            <label for="reportCategory">Category</label>
            <select id="reportCategory" required>
              <option value="impersonation">Impersonation — pretending to be a known brand</option>
              <option value="fraud" selected>Fraud / phishing / scam</option>
              <option value="harm">Harmful or unsafe behavior</option>
              <option value="scope-violation">Acting outside its declared scopes</option>
              <option value="rate-abuse">Rate abuse / scraping</option>
              <option value="spam">Spam</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="field">
            <label for="reportSeverity">Severity</label>
            <select id="reportSeverity" required>
              <option value="low">Low — annoyance</option>
              <option value="medium" selected>Medium — meaningful harm</option>
              <option value="high">High — material damage</option>
              <option value="critical">Critical — fraud, safety, large-scale</option>
            </select>
          </div>

          <div class="field">
            <label class="checkbox-row">
              <input type="checkbox" id="reportShotConsent" />
              <span>
                I want to attach a screenshot as evidence.
                <span class="text-[color:var(--color-text-dim)] text-xs block mt-1">
                  Screenshots may contain personal info. <strong>Only attach if the screenshot
                  contains no passwords, account numbers, or other private data.</strong>
                  By checking this you confirm you've reviewed the image.
                </span>
              </span>
            </label>
            <div id="shotPicker" class="shot-picker" hidden>
              <input type="file" id="reportShot" accept="image/png,image/jpeg,image/webp" />
              <div id="shotPreviewWrap" class="shot-preview-wrap" hidden>
                <img id="shotPreview" alt="Screenshot preview" />
                <button type="button" id="shotClear">Remove</button>
              </div>
            </div>
          </div>

          <div class="field privacy-note">
            Your report is sent with an anonymous UUID generated once per browser, never tied to your identity.
            No email, no IP retention. <a href="/privacy">Privacy policy</a>.
          </div>

          <div class="report-actions">
            <button type="button" class="btn-ghost" data-close>Cancel</button>
            <button type="submit" class="btn-danger" id="reportSubmit">Submit report</button>
          </div>
        </form>

        <div id="reportResult" class="report-result" hidden></div>
      </div>
    </div>

    <p class="text-center mt-6 text-xs text-[color:var(--color-text-dim)]">
      Want to integrate verification into your own app? Read the <a href="/spec/v0.1" class="underline">v0.1 spec</a> or grab the <a href="https://github.com/agentpki/extension" class="underline">Chrome extension</a>.
    </p>
  </main>

  <Footer />
</Base>

<style is:global>
  /* `is:global` so the CSS still matches HTML injected by the inline
     <script> via innerHTML — Astro's default scoping adds a hashed
     [data-astro-cid-…] attribute selector that dynamic DOM doesn't have. */
  :root { --bg-card: rgba(15, 15, 18, 0.6); }

  .hero-accent-text {
    background: linear-gradient(135deg, var(--color-accent-bright), var(--color-accent));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .banner-adoption {
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 0.6rem;
    padding: 0.85rem 1rem;
    color: rgba(253, 224, 167, 0.95);
  }
  .banner-adoption a { color: #fcd34d; }

  /* Input */
  .check-form { margin-bottom: 0; }
  .input-group {
    display: grid; grid-template-columns: 1fr auto; gap: 0.65rem;
    align-items: start;
  }
  @media (max-width: 640px) {
    .input-group { grid-template-columns: 1fr; }
  }
  .input-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 0.6rem;
    border: 1.5px solid var(--color-border-bright);
    background: var(--bg-card);
    color: var(--color-text);
    font: inherit; font-size: 1rem;
    font-family: ui-monospace, monospace;
    resize: vertical;
    min-height: 78px;
    transition: border-color 0.2s;
  }
  .input-group textarea:focus { outline: none; border-color: var(--color-accent); }
  .input-group textarea::placeholder { color: var(--color-text-dim); }

  .input-group button {
    padding: 0 1.5rem;
    border-radius: 0.6rem;
    background: var(--color-accent);
    color: black;
    border: 0;
    font: inherit; font-weight: 600;
    cursor: pointer;
    min-height: 60px;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    transition: background 0.2s;
  }
  .input-group button:hover:not(:disabled) { background: var(--color-accent-bright); }
  .input-group button:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-spinner { display: none; animation: spin 0.9s linear infinite; }
  .input-group button.loading .btn-spinner { display: inline-block; }
  .input-group button.loading .btn-label { opacity: 0.7; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* Helper callout under the input — prominent so users notice */
  .helper-callout {
    margin: 0.85rem 0 0;
    background: linear-gradient(135deg, rgba(167, 139, 250, 0.10), rgba(167, 139, 250, 0.04));
    border: 1.5px solid rgba(167, 139, 250, 0.35);
    border-left: 4px solid var(--color-accent);
    border-radius: 0.65rem;
    padding: 0.95rem 1.15rem;
  }
  .helper-callout-eyebrow {
    margin: 0 0 0.4rem;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-bright);
  }
  .helper-callout-body {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.6;
  }
  .helper-callout-strong { color: var(--color-text); font-weight: 700; }
  .helper-callout-num {
    color: var(--color-accent-bright);
    font-weight: 700;
    background: rgba(167, 139, 250, 0.15);
    padding: 0.05em 0.4em;
    border-radius: 4px;
  }

  /* Developer curl box — always visible, prominent */
  .dev-curl {
    margin: 0.85rem 0 0;
    background: #0a0a0f;
    border: 1.5px solid rgba(74, 222, 128, 0.3);
    border-radius: 0.65rem;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(74, 222, 128, 0.06);
  }
  .dev-curl-head {
    background: linear-gradient(90deg, rgba(74, 222, 128, 0.12), rgba(167, 139, 250, 0.08));
    padding: 0.7rem 1.05rem;
    display: flex; align-items: center; gap: 0.65rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text);
    border-bottom: 1px solid rgba(74, 222, 128, 0.2);
    letter-spacing: 0.01em;
  }
  .dev-curl-icon {
    font-family: ui-monospace, monospace;
    background: rgba(74, 222, 128, 0.25);
    color: #bbf7d0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    border: 1px solid rgba(74, 222, 128, 0.4);
  }
  .dev-curl-tag {
    margin-left: auto;
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #86efac;
    background: rgba(74, 222, 128, 0.18);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(74, 222, 128, 0.4);
  }
  .dev-curl-body {
    padding: 1rem 1.05rem 1.05rem;
    position: relative;
  }
  .dev-curl-line {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .dev-curl-body pre {
    margin: 0 0 0.65rem;
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    background: rgba(0, 0, 0, 0.6);
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.45rem;
    overflow-x: auto;
    line-height: 1.6;
    color: #e5e7eb;
    white-space: pre;
  }
  .curl-prompt { color: #71717a; }
  .curl-flag   { color: #c4b5fd; font-weight: 600; }
  .curl-arg    { color: #86efac; }
  .dev-curl-copy {
    position: absolute; top: 2.7rem; right: 1.55rem;
    background: rgba(74, 222, 128, 0.18);
    color: #86efac;
    border: 1.5px solid rgba(74, 222, 128, 0.5);
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
    font: inherit; font-size: 0.7rem; font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer !important;
    transition: all 0.15s;
  }
  .dev-curl-copy:hover {
    background: rgba(74, 222, 128, 0.3);
    color: #bbf7d0;
    transform: translateY(-1px);
  }
  .dev-curl-foot {
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .dev-curl-foot-strong { color: var(--color-text); font-weight: 700; }
  .dev-curl-foot code {
    color: var(--color-accent-bright);
    background: rgba(167, 139, 250, 0.15);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
  }
  .dev-curl-foot a {
    color: #86efac;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2px;
    font-weight: 600;
  }
  .dev-curl-foot a:hover { color: #bbf7d0; }

  /* Performance badge inside the verified card */
  .perf-badge {
    display: inline-flex; align-items: center; gap: 0.35rem;
    margin-left: auto;
    padding: 0.2rem 0.55rem;
    background: rgba(74, 222, 128, 0.18);
    border: 1px solid rgba(74, 222, 128, 0.5);
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: #bbf7d0;
    letter-spacing: 0.05em;
  }
  .perf-badge .perf-icon {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: #4ade80;
    animation: perf-pulse 1.4s ease-in-out infinite;
  }
  @keyframes perf-pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; box-shadow: 0 0 6px #4ade80; }
  }

  /* Example links — prominent, above textarea */
  .example-wrap {
    margin: 0 0 0.65rem;
    padding: 0.85rem 1.1rem;
    background: rgba(167, 139, 250, 0.08);
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 0.75rem;
  }
  .example-instruction {
    margin: 0 0 0.65rem;
    font-size: 0.9rem;
    color: var(--color-text);
    text-align: center;
    line-height: 1.45;
  }
  .example-instruction strong { color: var(--color-accent-bright); font-weight: 600; }
  .example-row {
    display: grid; gap: 0.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 560px) {
    .example-row { grid-template-columns: repeat(3, 1fr); }
  }
  .example-link {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border-radius: 0.5rem;
    border: 1.5px solid var(--color-border-bright);
    background: var(--bg-card);
    color: var(--color-text);
    font: inherit; font-size: 0.85rem; font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .example-link:hover:not(:disabled) {
    border-color: var(--color-accent);
    background: rgba(167, 139, 250, 0.12);
    transform: translateY(-1px);
  }
  .example-link:disabled { opacity: 0.6; cursor: wait; }
  .manual-or {
    text-align: center;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-dim);
    margin: 0.25rem 0 0.55rem;
    font-family: ui-monospace, monospace;
  }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; display: inline-block; flex-shrink: 0; }
  .dot-green { background: #4ade80; box-shadow: 0 0 6px rgba(74, 222, 128, 0.5); }
  .dot-yellow { background: #fbbf24; box-shadow: 0 0 6px rgba(251, 191, 36, 0.5); }
  .dot-red { background: #f87171; box-shadow: 0 0 6px rgba(248, 113, 113, 0.5); }

  /* ═══════════════════════════════════════════════════════════════════
     RESULT CARD — complete redesign as a stacked panel of distinct boxes.
     Card body is dark-tinted in the state colour. Inside, each field is
     its own bordered "data row" with a clear label-on-top, value-below
     layout. Buttons are in their own footer bar with distinct colours.
     ═══════════════════════════════════════════════════════════════════ */
  .result-area { margin-top: 1rem; }
  .result-area:empty { margin-top: 0; }

  /* The outermost card — solid coloured tint, thick border, no padding
     (each inner section sets its own). */
  .result-card {
    border-radius: 12px;
    border: 2px solid;
    overflow: hidden;
    margin-top: 0;
  }
  .result-card.verified   { border-color: #4ade80; background: #052e16; }
  .result-card.revoked    { border-color: #f87171; background: #450a0a; }
  .result-card.unverified { border-color: #fbbf24; background: #3a2a05; }
  .result-card.error      { border-color: #f87171; background: #450a0a; }

  /* HEADER — coloured banner at the top of the card */
  .result-header {
    display: flex; align-items: center; gap: 0.85rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 2px solid;
    font-family: ui-monospace, monospace;
  }
  .result-card.verified   .result-header { background: rgba(74, 222, 128, 0.18); border-bottom-color: #4ade80; }
  .result-card.revoked    .result-header { background: rgba(248, 113, 113, 0.20); border-bottom-color: #f87171; }
  .result-card.unverified .result-header { background: rgba(251, 191, 36, 0.18); border-bottom-color: #fbbf24; }
  .result-card.error      .result-header { background: rgba(248, 113, 113, 0.18); border-bottom-color: #f87171; }

  .result-icon {
    font-size: 1.85rem; line-height: 1; flex-shrink: 0;
  }
  .result-card.verified   .result-icon { color: #86efac; }
  .result-card.revoked    .result-icon { color: #fca5a5; }
  .result-card.unverified .result-icon { color: #fcd34d; }
  .result-card.error      .result-icon { color: #fca5a5; }

  .result-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .result-card.verified   .result-title { color: #bbf7d0; }
  .result-card.revoked    .result-title { color: #fecaca; }
  .result-card.unverified .result-title { color: #fde68a; }
  .result-card.error      .result-title { color: #fecaca; }

  /* BODY — holds the data rows and any prose. Padding lives here. */
  .result-body {
    padding: 1.25rem 1.4rem;
    display: flex; flex-direction: column; gap: 0.75rem;
  }

  /* Each labelled value is its own little box — un-mistakeable visual
     boundaries, so nothing reads as flowing prose. */
  .result-field {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.7rem 0.95rem 0.8rem;
  }
  .result-field-label {
    display: block;
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c4b5fd;
    margin-bottom: 0.35rem;
  }
  .result-field-value {
    display: block;
    font-size: 0.95rem;
    color: #f3f4f6;
    font-weight: 500;
    line-height: 1.45;
    word-break: break-word;
    overflow-wrap: anywhere;
  }
  .result-field-value strong { font-weight: 700; }
  .result-field-value code {
    color: #c4b5fd;
    background: rgba(167, 139, 250, 0.18);
    padding: 0.15em 0.5em;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.88em;
  }

  /* Prose box (for the Unverified message text, etc.) */
  .result-prose {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    color: #f3f4f6;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .result-prose p { margin: 0; }
  .result-prose p + p { margin-top: 0.6rem; }
  .result-prose strong { color: #ffffff; }

  /* Safety checklist (Unverified card) */
  .result-checklist {
