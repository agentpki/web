---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Pricing — AgentPKI" description="Free during alpha. Pay only when you scale. Hosted issuer, enterprise tiers, bot-defense vendor rev share.">
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <!-- ─────────── HERO STRIP ─────────── -->
  <section class="border-b border-[color:var(--color-border)]">
    <div class="max-w-6xl mx-auto px-6 pt-16 pb-12 lg:pt-20 lg:pb-16 text-center">
      <span class="inline-block px-3 py-1 mb-5 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 text-[10px] font-mono uppercase tracking-widest text-[color:var(--color-text-dim)]">pricing</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-balance">Free forever to start. Pay only as you scale.</h1>
      <p class="mt-5 text-lg text-[color:var(--color-text-muted)] max-w-2xl mx-auto leading-relaxed">
        The protocol, SDKs, reference verifier, and bot-defense middleware are Apache&nbsp;2.0 / MIT open source. We sell the hosted operational layer on top — pick the lane that matches your scale.
      </p>
    </div>
  </section>

  <!-- ─────────── ALPHA DISCLOSURE BANNER ─────────── -->
  <section>
    <div class="max-w-6xl mx-auto px-6 pt-10">
      <div class="px-5 py-4 rounded-xl border border-amber-500/30 bg-amber-500/[0.04] flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-400 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div class="text-sm text-[color:var(--color-text-muted)]">
          <strong class="text-[color:var(--color-text)]">Pricing preview · we're in alpha.</strong>
          Tiers below show our intended pricing model. Today everything is <strong class="text-amber-200">free for alpha customers</strong> — locked in at the alpha rate for 6 months after the paid tiers go live (target Q3&nbsp;2026). Email <a href="mailto:hello@agentpki.dev" class="text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-bright)]">hello@agentpki.dev</a> to be considered.
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── TIER CARDS ─────────── -->
  <section>
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="grid lg:grid-cols-3 gap-5">
        <!-- TIER 1: free / hobbyist -->
        <div class="relative rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-7 flex flex-col">
          <div class="flex items-baseline gap-2 mb-4">
            <span class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)]">tier · open</span>
          </div>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-4xl font-semibold tracking-tight">Free</span>
            <span class="text-sm text-[color:var(--color-text-muted)]">· forever</span>
          </div>
          <p class="text-sm text-[color:var(--color-text-muted)] mt-2 mb-6">For individual developers, OSS projects, and small teams self-serving.</p>

          <div class="space-y-2.5 text-sm flex-1">
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span><strong class="text-[color:var(--color-text)]">T1 DNS-verified issuer</strong> — 1 domain, unlimited passports</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Self-hosted reference verifier (open source)</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>SDKs (TS + Python), CLI, all spec docs</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Bot-defense reference middleware (30 LOC)</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-text-dim)] mt-0.5">—</span><span class="text-[color:var(--color-text-muted)]">Community support · best-effort uptime</span></div>
          </div>

          <a href="https://dashboard.agentpki.dev" class="mt-6 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg border border-[color:var(--color-border-bright)] text-sm font-medium hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg)]/40 transition">
            Sign up free &rarr;
          </a>
          <p class="mt-3 text-[11px] text-[color:var(--color-text-dim)] text-center">No credit card · 2-minute setup</p>
        </div>

        <!-- TIER 2: hosted issuer (featured) -->
        <div class="relative rounded-2xl border-2 border-[color:var(--color-accent)]/60 bg-gradient-to-b from-[color:var(--color-accent)]/[0.08] to-[color:var(--color-bg-elevated)] p-7 flex flex-col shadow-[0_24px_60px_-24px_rgba(167,139,250,0.4)]">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="inline-block px-3 py-1 rounded-full bg-[color:var(--color-accent)] text-black text-[10px] font-mono uppercase tracking-widest font-semibold">most popular</span>
          </div>
          <div class="flex items-baseline gap-2 mb-4">
            <span class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-accent-bright)]">tier · hosted</span>
          </div>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-4xl font-semibold tracking-tight">$99</span>
            <span class="text-sm text-[color:var(--color-text-muted)]">/mo · per issuer</span>
          </div>
          <p class="text-sm text-[color:var(--color-text-muted)] mt-2 mb-6">For SaaS teams shipping agents — hosted issuer, no Worker to run yourself.</p>

          <div class="space-y-2.5 text-sm flex-1">
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Everything in Free</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span><strong class="text-[color:var(--color-text)]">Hosted issuer</strong> — we run the Worker, rotate keys, ship the CRL</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>100k mints/mo included · $0.001/mint after</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Dashboard analytics, audit log, abuse pipeline</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>99.9% SLA · email support · 24h response</span></div>
          </div>

          <a href="mailto:hello@agentpki.dev?subject=AgentPKI%20alpha%20%E2%80%94%20Hosted%20tier%20interest&amp;body=Hi%20Sarvesh%2C%0A%0AOur%20team%20is%20interested%20in%20the%20Hosted%20tier%20once%20it%20launches.%20Here%27s%20a%20bit%20about%20us%3A%0A%0A%5BCompany%20%2F%20what%20you%27d%20use%20it%20for%5D%0A%5BExpected%20mint%20volume%5D%0A%5BTimeline%5D%0A" class="mt-6 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg bg-[color:var(--color-accent)] text-black text-sm font-semibold hover:bg-[color:var(--color-accent-bright)] transition">
            Join alpha waitlist &rarr;
          </a>
          <p class="mt-3 text-[11px] text-[color:var(--color-text-dim)] text-center">Free for 6 months once paid tier ships</p>
        </div>

        <!-- TIER 3: enterprise -->
        <div class="relative rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-7 flex flex-col">
          <div class="flex items-baseline gap-2 mb-4">
            <span class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)]">tier · enterprise</span>
          </div>
          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-4xl font-semibold tracking-tight">Custom</span>
          </div>
          <p class="text-sm text-[color:var(--color-text-muted)] mt-2 mb-6">For banks, regulated industries, bot-defense vendors, and large agent fleets.</p>

          <div class="space-y-2.5 text-sm flex-1">
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Everything in Hosted</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span><strong class="text-[color:var(--color-text)]">T2 KYB</strong> + <strong class="text-[color:var(--color-text)]">T3 hardware</strong>-attested issuers</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Dedicated verifier with regional residency</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>SOC&nbsp;2 Type II · HIPAA · EU AI Act attestation</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>99.99% SLA · 24/7 on-call · dedicated CSM</span></div>
            <div class="flex items-start gap-2"><span class="text-[color:var(--color-accent)] mt-0.5">✓</span><span>Bot-defense vendor rev-share available</span></div>
          </div>

          <a href="mailto:hello@agentpki.dev?subject=AgentPKI%20enterprise%20inquiry" class="mt-6 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-lg border border-[color:var(--color-border-bright)] text-sm font-medium hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg)]/40 transition">
            Talk to the founder &rarr;
          </a>
          <p class="mt-3 text-[11px] text-[color:var(--color-text-dim)] text-center">48h response · NDAs available</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── CUSTOMER × USE-CASE MATRIX ─────────── -->
  <section class="border-t border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/20">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-2">Who uses which tier</h2>
      <p class="text-[color:var(--color-text-muted)] mb-8">A quick map of which lane fits which kind of customer.</p>
      <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-[color:var(--color-border)] text-left">
                <th class="px-5 py-4 font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)]">Customer type</th>
                <th class="px-5 py-4 font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)]">Typical scale</th>
                <th class="px-5 py-4 font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)]">Best-fit tier</th>
                <th class="px-5 py-4 font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)]">Outcome they get</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[color:var(--color-border)]">
              <tr class="hover:bg-[color:var(--color-bg)]/30 transition">
                <td class="px-5 py-4 font-medium">Solo dev / OSS project</td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">&lt; 10k mints/mo</td>
                <td class="px-5 py-4"><span class="px-2 py-1 rounded-md bg-[color:var(--color-text-dim)]/15 text-[color:var(--color-text-muted)] font-mono text-[11px]">Free</span></td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">Real cryptographic identity for their agent without running infrastructure</td>
              </tr>
              <tr class="hover:bg-[color:var(--color-bg)]/30 transition">
                <td class="px-5 py-4 font-medium">SaaS shipping AI agents</td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">10k–1M mints/mo</td>
                <td class="px-5 py-4"><span class="px-2 py-1 rounded-md bg-[color:var(--color-accent)]/20 text-[color:var(--color-accent-bright)] font-mono text-[11px]">Hosted $99/mo</span></td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">Issue + rotate keys + audit, no Worker to operate. Customers' bot-defense vendors stop blocking their agent traffic.</td>
              </tr>
              <tr class="hover:bg-[color:var(--color-bg)]/30 transition">
                <td class="px-5 py-4 font-medium">Website / API operator</td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">any</td>
                <td class="px-5 py-4"><span class="px-2 py-1 rounded-md bg-[color:var(--color-text-dim)]/15 text-[color:var(--color-text-muted)] font-mono text-[11px]">Free verifier</span></td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">Distinguish legit AI agents from scrapers at the edge, set a per-route policy</td>
              </tr>
              <tr class="hover:bg-[color:var(--color-bg)]/30 transition">
                <td class="px-5 py-4 font-medium">Bot-defense vendor</td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">100M+ verifies/mo</td>
                <td class="px-5 py-4"><span class="px-2 py-1 rounded-md bg-[color:var(--color-accent)]/10 text-[color:var(--color-accent-bright)] font-mono text-[11px]">Enterprise · rev share</span></td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">Native AgentPKI signal in their decision pipeline, false-positive reduction, co-marketing as "AgentPKI inside"</td>
              </tr>
              <tr class="hover:bg-[color:var(--color-bg)]/30 transition">
                <td class="px-5 py-4 font-medium">Bank / regulated enterprise</td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">10–500 issuers</td>
                <td class="px-5 py-4"><span class="px-2 py-1 rounded-md bg-[color:var(--color-accent)]/10 text-[color:var(--color-accent-bright)] font-mono text-[11px]">Enterprise · T2/T3</span></td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">KYB-verified issuance, SOC&nbsp;2 / EU AI Act paper trail, hardware-attested keys, residency control</td>
              </tr>
              <tr class="hover:bg-[color:var(--color-bg)]/30 transition">
                <td class="px-5 py-4 font-medium">Agent marketplace / federation</td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">multi-tenant</td>
                <td class="px-5 py-4"><span class="px-2 py-1 rounded-md bg-[color:var(--color-accent)]/10 text-[color:var(--color-accent-bright)] font-mono text-[11px]">Enterprise · federation</span></td>
                <td class="px-5 py-4 text-[color:var(--color-text-muted)]">Cross-org passport scoping (vendor A's agents allowed at vendor B's API under negotiated terms)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-5 text-xs text-[color:var(--color-text-dim)]">Mints/verifies/issuers numbers are guidance, not hard caps. Need something different? <a href="mailto:hello@agentpki.dev" class="text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-bright)]">Email us</a> — we tailor.</p>
    </div>
  </section>

  <!-- ─────────── FAQ ─────────── -->
  <section class="border-t border-[color:var(--color-border)]">
    <div class="max-w-3xl mx-auto px-6 py-16">
      <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mb-8">Common questions</h2>
      <div class="space-y-6">
        <details class="group rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-5 open:bg-[color:var(--color-bg-elevated-2)]">
          <summary class="cursor-pointer font-medium flex items-center justify-between">
            <span>What's truly free, forever?</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor"><path d="M2 4l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">The spec, both SDKs, the reference verifier, and the bot-defense middleware are open source (Apache&nbsp;2.0 for the spec, MIT for the code) and free forever. The Free tier of the hosted dashboard is also free forever — you can run an issuer + mint passports without ever paying.</p>
        </details>
        <details class="group rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-5">
          <summary class="cursor-pointer font-medium flex items-center justify-between">
            <span>When do paid tiers actually go live?</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor"><path d="M2 4l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">Target Q3&nbsp;2026 (paid Hosted tier with Stripe billing). Alpha customers — anyone who emails us before that — get the alpha rate locked in for 6 months after paid tiers ship.</p>
        </details>
        <details class="group rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-5">
          <summary class="cursor-pointer font-medium flex items-center justify-between">
            <span>How does the bot-defense vendor rev share work?</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor"><path d="M2 4l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">A bot-defense vendor (Cloudflare, DataDome, hCaptcha, Arkose, Castle, etc.) embeds AgentPKI verification as a signal in their decision pipeline. When their customers benefit, we share the upside: typically $0.01–0.10 per verify or a fixed quarterly fee. Specifics negotiated per deal.</p>
        </details>
        <details class="group rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-5">
          <summary class="cursor-pointer font-medium flex items-center justify-between">
            <span>What's the deal with T1 / T2 / T3?</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor"><path d="M2 4l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">Three trust tiers, in increasing strength: <strong>T1 — DNS-verified</strong> (you proved control of your domain; free), <strong>T2 — KYB-verified</strong> (we manually verified your business identity; Enterprise tier), <strong>T3 — hardware-attested</strong> (your signing key lives in a TPM/HSM with attestation; Enterprise tier). T1 launches with the platform. T2/T3 ship alongside paid tiers.</p>
        </details>
        <details class="group rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)] p-5">
          <summary class="cursor-pointer font-medium flex items-center justify-between">
            <span>Can I self-host everything?</span>
            <svg class="w-4 h-4 transition-transform group-open:rotate-180" viewBox="0 0 12 12" fill="currentColor"><path d="M2 4l4 4 4-4"/></svg>
          </summary>
          <p class="mt-3 text-sm text-[color:var(--color-text-muted)] leading-relaxed">Yes — completely. The <a href="https://github.com/agentpki/real-issuer" class="text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-bright)]">real-issuer</a> repo is a production-grade Worker template. The <a href="https://github.com/agentpki/verifier" class="text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-bright)]">verifier</a> repo is the same Worker we run at verify.agentpki.dev. Fork either or both, deploy to your own Cloudflare account, never depend on us. The protocol is the product; we just sell convenience on top.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- ─────────── FINAL CTA ─────────── -->
  <section class="border-t border-[color:var(--color-border)] aurora-glow relative">
    <div class="max-w-4xl mx-auto px-6 py-24 text-center relative">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight">Pick a lane, or talk to us.</h2>
      <p class="mt-5 text-lg text-[color:var(--color-text-muted)] max-w-2xl mx-auto">
        Free tier is self-serve from the dashboard. Hosted + Enterprise tiers go through us — fastest path is email.
      </p>
      <div class="mt-10 flex flex-wrap gap-3 justify-center">
        <a href="https://dashboard.agentpki.dev" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-[color:var(--color-accent)] text-black font-medium text-base hover:bg-[color:var(--color-accent-bright)] transition">
          Sign up free
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="mailto:hello@agentpki.dev?subject=AgentPKI%20pricing%20chat" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Email the founder
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Base>
