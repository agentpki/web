---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Provenance Explorer — AgentPKI"
  description="Sign or verify any piece of content with an agent-issued cryptographic provenance manifest. Sample article, sample image, or your own bytes. Walks back the chain from content to issuer."
>
  <Nav />

  <section class="max-w-none px-2 sm:px-3 lg:px-4 pt-14 pb-6">
    <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">
      AgentPKI Provenance v0.1 &middot; live demo
    </p>
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4">
      Sign content. Verify content. Walk the chain.
    </h1>
    <p class="text-base sm:text-lg text-[color:var(--color-text-muted)] max-w-3xl leading-relaxed">
      Drop or paste any bytes into the <strong class="text-[color:var(--color-text)]">Sign</strong> panel — we mint a passport and sign a provenance manifest using the demo issuer's keys. Paste content + manifest into the <strong class="text-[color:var(--color-text)]">Verify</strong> panel — the verifier confirms signature, content hash, and walks back through the passport to the issuer. Same protocol used by the SDK and CLI.
    </p>
    <p class="text-sm text-[color:var(--color-text-muted)] mt-3">
      Spec: <a href="/spec/provenance-v0.1" class="underline text-[color:var(--color-accent-bright)]">/spec/provenance-v0.1</a> &middot;
      API: <a href="https://provenance.agentpki.dev" class="underline text-[color:var(--color-accent-bright)]">provenance.agentpki.dev</a>
    </p>
  </section>

  <!-- Two-column workflow -->
  <section class="max-w-none px-2 sm:px-3 lg:px-4 pb-12">
    <div class="grid lg:grid-cols-2 gap-6">

      <!-- ─── LEFT: SIGN ─── -->
      <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 p-5">
        <div class="flex items-baseline justify-between mb-3">
          <h2 class="text-2xl font-semibold">Sign</h2>
          <span class="text-xs font-mono uppercase text-[color:var(--color-text-muted)]">via demo issuer</span>
        </div>

        <label class="block text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mb-1">Content</label>
        <textarea id="pv-sign-content" rows="8" placeholder="Type or paste any text… (we'll sign these exact bytes)"
          class="pv-input pv-textarea font-mono text-sm"
        ># Hello from Claude

This article was generated by an AI agent. Its provenance is cryptographically attestable.</textarea>

        <div class="grid grid-cols-2 gap-2 mt-3">
          <div>
            <label class="block text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mb-1">Content type</label>
            <input id="pv-sign-type" type="text" value="text/markdown" class="pv-input font-mono text-sm" />
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mb-1">Transformation</label>
            <select id="pv-sign-trans" class="pv-input font-mono text-sm">
              <option>generated</option>
              <option>edited</option>
              <option>translated</option>
              <option>summarized</option>
              <option>transcribed</option>
              <option>composed</option>
              <option>reviewed</option>
            </select>
          </div>
        </div>

        <div class="flex gap-2 mt-3">
          <button id="pv-sign-btn" class="pv-btn pv-btn-primary">Sign &amp; mint manifest</button>
          <button id="pv-sign-copy-manifest" class="pv-btn pv-btn-ghost" disabled>Copy manifest</button>
          <button id="pv-sign-copy-header" class="pv-btn pv-btn-ghost" disabled>Copy header</button>
        </div>

        <div id="pv-sign-output" class="hidden mt-4 space-y-3">
          <div>
            <p class="text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mb-1">content_hash</p>
            <code id="pv-sign-hash" class="block text-xs font-mono break-all p-2 rounded bg-[color:var(--color-bg)] border border-[color:var(--color-border)]"></code>
          </div>
          <div>
            <p class="text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mb-1">Content-Provenance header</p>
            <pre id="pv-sign-header" class="text-xs font-mono break-all p-2 rounded bg-[color:var(--color-bg)] border border-[color:var(--color-border)] max-h-32 overflow-auto"></pre>
          </div>
          <details>
            <summary class="text-xs text-[color:var(--color-text-muted)] cursor-pointer">View full manifest JSON</summary>
            <pre id="pv-sign-manifest" class="mt-2 text-xs font-mono p-2 rounded bg-[#0a0a14] border border-[color:var(--color-border)] max-h-48 overflow-auto"></pre>
          </details>
        </div>
      </div>

      <!-- ─── RIGHT: VERIFY ─── -->
      <div class="rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 p-5">
        <div class="flex items-baseline justify-between mb-3">
          <h2 class="text-2xl font-semibold">Verify</h2>
          <span class="text-xs font-mono uppercase text-[color:var(--color-text-muted)]">live verifier round-trip</span>
        </div>

        <label class="block text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mb-1">Content (must match the original bytes)</label>
        <textarea id="pv-verify-content" rows="6" placeholder="Paste the original content here…"
          class="pv-input pv-textarea font-mono text-sm"></textarea>

        <label class="block text-xs uppercase tracking-wider text-[color:var(--color-text-muted)] mt-3 mb-1">Manifest (JSON) <span class="text-[color:var(--color-text-muted)] normal-case">— or paste a Content-Provenance header</span></label>
        <textarea id="pv-verify-manifest" rows="6" placeholder='Paste the manifest JSON, or paste "v=1; manifest=...; sha256=..."'
          class="pv-input pv-textarea font-mono text-xs"></textarea>

        <div class="flex gap-2 mt-3">
          <button id="pv-verify-btn" class="pv-btn pv-btn-primary">Verify</button>
          <button id="pv-load-from-sign" class="pv-btn pv-btn-ghost">Copy from Sign panel ⇐</button>
        </div>

        <div id="pv-verify-banner" class="hidden mt-4 pv-banner pv-banner-idle">
          <span class="pv-banner-icon">?</span>
          <span class="pv-banner-text">Verifier returns the chain here…</span>
        </div>

        <div id="pv-verify-chain" class="hidden mt-3 space-y-2"></div>

        <details class="mt-3 hidden" id="pv-verify-raw-details">
          <summary class="text-xs text-[color:var(--color-text-muted)] cursor-pointer">Raw verifier response</summary>
          <pre id="pv-verify-raw" class="mt-2 text-xs font-mono p-2 rounded bg-[#0a0a14] border border-[color:var(--color-border)] max-h-48 overflow-auto"></pre>
        </details>
      </div>

    </div>
  </section>

  <Footer />

  <style is:global>
    .pv-input {
      width: 100%;
      padding: 0.5rem 0.7rem;
      border-radius: 0.4rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      color: var(--color-text);
    }
    .pv-input:focus { outline: none; border-color: var(--color-accent); }
    .pv-textarea { resize: vertical; min-height: 5rem; }
    .pv-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.55rem 1rem;
      border-radius: 0.4rem;
      font-weight: 600; font-size: 0.85rem;
      border: 1px solid;
      cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
    }
    .pv-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .pv-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .pv-btn-primary {
      background: var(--color-accent); color: white; border-color: var(--color-accent);
    }
    .pv-btn-ghost {
      background: transparent; color: var(--color-text-muted); border-color: var(--color-border-bright);
    }

    .pv-banner {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.85rem 1rem; border-radius: 0.5rem;
      border: 1px solid; font-weight: 600;
    }
    .pv-banner-icon { font-size: 1.4rem; }
    .pv-banner-idle    { border-color: var(--color-border); background: rgba(20,20,30,0.4); color: var(--color-text-muted); }
    .pv-banner-allow   { border-color: rgba(34,197,94,0.4); background: rgba(34,197,94,0.08); color: #4ade80; }
    .pv-banner-deny    { border-color: rgba(239,68,68,0.5); background: rgba(239,68,68,0.1); color: #f87171; }
    .pv-banner-loading { border-color: rgba(167,139,250,0.4); background: rgba(167,139,250,0.08); color: var(--color-accent-bright); }

    .pv-chain-entry {
      border: 1px solid var(--color-border);
      border-radius: 0.4rem;
      padding: 0.7rem 0.85rem;
      background: rgba(20,20,30,0.4);
      font-size: 0.85rem;
    }
    .pv-chain-row { display: flex; gap: 0.6rem; padding: 0.1rem 0; }
    .pv-chain-key { color: var(--color-text-muted); width: 8.5rem; font-family: ui-monospace, monospace; font-size: 0.75rem; flex-shrink: 0; }
    .pv-chain-val { color: var(--color-text); font-family: ui-monospace, monospace; font-size: 0.78rem; word-break: break-all; }
  </style>

  <script is:inline>
    (function () {
      var PROV = 'https://provenance.agentpki.dev';
      var signedState = null;

      function b64uEncodeUtf8(text) {
        var bytes = new TextEncoder().encode(text);
        var bin = '';
        for (var i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      }

      // ── SIGN ──
      document.getElementById('pv-sign-btn').addEventListener('click', async function () {
        var content = document.getElementById('pv-sign-content').value;
        var contentType = document.getElementById('pv-sign-type').value || 'text/plain';
        var transformation = document.getElementById('pv-sign-trans').value || 'generated';
        var btn = this;
        btn.disabled = true;
        var prev = btn.textContent;
        btn.textContent = 'Signing…';
        try {
          var r = await fetch(PROV + '/v1/sign-demo', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              content_b64: b64uEncodeUtf8(content),
              content_type: contentType,
              transformation: transformation,
            }),
          });
          var body = await r.json();
          if (!r.ok) throw new Error(body.detail || body.error || ('HTTP ' + r.status));
          signedState = body;
          document.getElementById('pv-sign-output').classList.remove('hidden');
          document.getElementById('pv-sign-hash').textContent = body.content_hash;
          document.getElementById('pv-sign-header').textContent = body.header_value;
          document.getElementById('pv-sign-manifest').textContent = JSON.stringify(body.manifest, null, 2);
          document.getElementById('pv-sign-copy-manifest').disabled = false;
          document.getElementById('pv-sign-copy-header').disabled = false;
        } catch (e) {
          alert('Sign failed: ' + (e.message || 'unknown'));
        } finally {
          btn.disabled = false;
          btn.textContent = prev;
        }
      });

      document.getElementById('pv-sign-copy-manifest').addEventListener('click', function () {
        if (!signedState) return;
        navigator.clipboard.writeText(JSON.stringify(signedState.manifest, null, 2));
        flashLabel(this, 'Copied');
      });
      document.getElementById('pv-sign-copy-header').addEventListener('click', function () {
        if (!signedState) return;
        navigator.clipboard.writeText(signedState.header_value);
        flashLabel(this, 'Copied');
      });

      document.getElementById('pv-load-from-sign').addEventListener('click', function () {
        if (!signedState) { alert('Sign something first on the left.'); return; }
        document.getElementById('pv-verify-content').value = document.getElementById('pv-sign-content').value;
        document.getElementById('pv-verify-manifest').value = JSON.stringify(signedState.manifest, null, 2);
      });

      function flashLabel(btn, msg) {
        var prev = btn.textContent;
        btn.textContent = '✓ ' + msg;
        setTimeout(function () { btn.textContent = prev; }, 1200);
      }

      // ── VERIFY ──
      document.getElementById('pv-verify-btn').addEventListener('click', async function () {
        var content = document.getElementById('pv-verify-content').value;
        var manifestText = document.getElementById('pv-verify-manifest').value.trim();
        if (!manifestText) { alert('Paste a manifest JSON or Content-Provenance header.'); return; }
        var btn = this;
        btn.disabled = true;
        var prev = btn.textContent;
        btn.textContent = 'Verifying…';

        var banner = document.getElementById('pv-verify-banner');
        banner.className = 'mt-4 pv-banner pv-banner-loading';
        banner.querySelector('.pv-banner-icon').textContent = '⟳';
        banner.querySelector('.pv-banner-text').textContent = 'Calling provenance.agentpki.dev…';
        banner.classList.remove('hidden');
        document.getElementById('pv-verify-chain').classList.add('hidden');

        // Detect header form vs JSON form
        var isHeader = /^v\s*=\s*1\s*;/.test(manifestText);
        var url, body;
        try {
          if (isHeader) {
            url = PROV + '/v1/verify-header';
            body = JSON.stringify({ header_value: manifestText, content_b64: b64uEncodeUtf8(content) });
          } else {
            var parsedManifest = JSON.parse(manifestText);
            url = PROV + '/v1/verify';
            body = JSON.stringify({ manifest: parsedManifest, content_b64: b64uEncodeUtf8(content) });
          }
        } catch (e) {
          banner.className = 'mt-4 pv-banner pv-banner-deny';
          banner.querySelector('.pv-banner-icon').textContent = '✗';
          banner.querySelector('.pv-banner-text').textContent = 'Manifest is not valid JSON: ' + e.message;
          btn.disabled = false; btn.textContent = prev;
          return;
        }

        try {
          var r = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: body });
          var data = await r.json();
          document.getElementById('pv-verify-raw').textContent = JSON.stringify(data, null, 2);
          document.getElementById('pv-verify-raw-details').classList.remove('hidden');

          if (data.verified) {
            banner.className = 'mt-4 pv-banner pv-banner-allow';
            banner.querySelector('.pv-banner-icon').textContent = '✓';
            banner.querySelector('.pv-banner-text').textContent =
              'Verified · signature ' + (data.manifest_signature_valid ? 'valid' : 'invalid') +
              ' · content ' + (data.content_hash_match ? 'matches' : 'unchecked') +
              ' · passport ' + (data.passport_verdict || '?');
            renderChain(data.chain || []);
          } else {
            banner.className = 'mt-4 pv-banner pv-banner-deny';
            banner.querySelector('.pv-banner-icon').textContent = '✗';
            banner.querySelector('.pv-banner-text').textContent =
              'Verification failed: ' + (data.failure_reason || 'unknown') +
              (data.failure_detail ? ' — ' + data.failure_detail : '');
            document.getElementById('pv-verify-chain').classList.add('hidden');
          }
        } catch (e) {
          banner.className = 'mt-4 pv-banner pv-banner-deny';
          banner.querySelector('.pv-banner-icon').textContent = '✗';
          banner.querySelector('.pv-banner-text').textContent = 'Network error: ' + e.message;
        } finally {
          btn.disabled = false; btn.textContent = prev;
        }
      });

      function renderChain(chain) {
        var box = document.getElementById('pv-verify-chain');
        box.classList.remove('hidden');
        box.innerHTML = '';
        for (var i = 0; i < chain.length; i++) {
          var e = chain[i];
          var div = document.createElement('div');
          div.className = 'pv-chain-entry';
          div.innerHTML =
            '<div class="pv-chain-row"><span class="pv-chain-key">seq</span><span class="pv-chain-val">#' + e.seq + '</span></div>' +
            '<div class="pv-chain-row"><span class="pv-chain-key">agent_id</span><span class="pv-chain-val">' + escapeHtml(e.agent_id) + '</span></div>' +
            '<div class="pv-chain-row"><span class="pv-chain-key">issuer</span><span class="pv-chain-val">' + escapeHtml(e.issuer) + ' (tier ' + (e.issuer_tier ?? '?') + ')</span></div>' +
            '<div class="pv-chain-row"><span class="pv-chain-key">produced_at</span><span class="pv-chain-val">' + new Date(e.produced_at * 1000).toISOString() + '</span></div>' +
            '<div class="pv-chain-row"><span class="pv-chain-key">transformation</span><span class="pv-chain-val">' + escapeHtml(e.transformation) + '</span></div>' +
            '<div class="pv-chain-row"><span class="pv-chain-key">content_type</span><span class="pv-chain-val">' + escapeHtml(e.content_type) + '</span></div>' +
            (e.parent_hash ? '<div class="pv-chain-row"><span class="pv-chain-key">parent_hash</span><span class="pv-chain-val">' + escapeHtml(e.parent_hash) + '</span></div>' : '');
          box.appendChild(div);
        }
      }

      function escapeHtml(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
    })();
  </script>
</Base>
