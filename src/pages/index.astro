---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Base
  title="AgentPKI — cryptographic identity for AI agents on the public internet"
  description="An open passport-based identity system for AI agents on the public internet. Edge-verified in sub-50ms. Vendor-neutral, chain-agnostic, Apache 2.0. Built so legitimate agents pass bot defense, the rest stay blocked, and AI-generated content is cryptographically attributable."
>
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <!-- ═══════════════════════════════════════════════════════════════
       HERO — infrastructure framing, kept from the prior site
       ═══════════════════════════════════════════════════════════════ -->
  <section class="aurora-glow relative overflow-hidden">
    <div class="max-w-none px-2 sm:px-3 lg:px-4 pt-24 pb-14 lg:pt-32 lg:pb-16 text-center">

      <a href="/for-developers" class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-8 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur text-xs text-[color:var(--color-text-muted)] hover:border-[color:var(--color-accent)]/50 hover:text-[color:var(--color-text)] transition group">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-green-400"></span>
        </span>
        <span class="font-mono">live</span>
        <span class="text-[color:var(--color-text-dim)]">·</span>
        <span><strong class="text-[color:var(--color-text)] font-medium">agentpki.dev</strong> — reference issuer + verifier + provenance</span>
        <span class="text-[color:var(--color-text-dim)]">·</span>
        <span class="font-mono">v0.3 + Provenance v0.1</span>
        <svg class="w-3 h-3 ml-1 transition-transform group-hover:translate-x-0.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2.5l3 3.5-3 3.5"/></svg>
      </a>

      <h1 class="text-5xl sm:text-6xl lg:text-[5rem] font-semibold tracking-[-0.025em] leading-[1.02] text-balance">
        Cryptographic identity for<br />
        <span class="hero-accent-text">AI agents.</span>
      </h1>

      <p class="mt-7 text-xl sm:text-2xl lg:text-[1.6rem] text-[color:var(--color-text-muted)] leading-snug max-w-5xl mx-auto lg:whitespace-nowrap">
        A passport-based identity system for AI agents on the public internet.
      </p>
      <p class="mt-5 text-base sm:text-lg lg:text-xl text-[color:var(--color-text-dim)] leading-relaxed max-w-2xl mx-auto text-balance">
        Open protocol, edge-verified, sub-50&nbsp;ms, vendor-neutral, chain-agnostic — built so legitimate agents pass bot defense, the rest stay blocked, and AI-generated content is cryptographically attributable.
      </p>

      <div class="mt-9 flex flex-wrap gap-3 justify-center">
        <a href="/demo"
           class="group inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition">
          <span class="relative flex w-2 h-2">
            <span class="absolute inset-0 rounded-full bg-black/40 animate-ping"></span>
            <span class="relative w-2 h-2 rounded-full bg-black"></span>
          </span>
          Watch the live demo
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/spec"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Read the spec
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/keys"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Get API key — free
        </a>
        <a href="/pricing"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Pricing
        </a>
      </div>

      <p class="mt-6 text-xs text-[color:var(--color-text-dim)] tracking-wide">
        Apache 2.0 &middot; open spec &middot; interop with C2PA, MCP, A2A, Kite, SPIFFE, OWASP ANS
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       STATS STRIP — proof of "built" not "planned"
       ═══════════════════════════════════════════════════════════════ -->
  <div class="max-w-none px-2 sm:px-3 lg:px-4 py-10 grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-b border-[color:var(--color-border)]">
    <div class="text-center">
      <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">3</div>
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Spec versions live</div>
    </div>
    <div class="text-center">
      <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">~50ms</div>
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Edge verify p50</div>
    </div>
    <div class="text-center">
      <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">2</div>
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Product lines shipped</div>
    </div>
    <div class="text-center">
      <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">$0</div>
      <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">To self-host</div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       NARRATIVE BRIDGE — one paragraph that explains the
       infrastructure framing before showing the 6 personas
       ═══════════════════════════════════════════════════════════════ -->
  <section class="border-b border-[color:var(--color-border)]">
    <div class="max-w-none px-2 sm:px-3 lg:px-4 py-14">
      <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">
        Infrastructure for the agent layer of the internet
      </p>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-balance leading-[1.15]">
        AgentPKI is one open protocol with <span class="hero-accent-text">six audiences.</span>
      </h2>
      <p class="mt-5 text-base sm:text-lg text-[color:var(--color-text-muted)] leading-relaxed max-w-3xl">
        Bot operators get their agents accepted. Sites publish what bots may do. Bot-defense vendors get a verified-bot signal. Publishers sign their content. Compliance teams get machine-readable AI attribution. Everyone else gets a cleaner internet. Same protocol from every side — pick yours.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       SIX PERSONA CARDS — compact, equal weight
       ═══════════════════════════════════════════════════════════════ -->
  <section id="audiences">
    <div class="max-w-none px-2 sm:px-3 lg:px-4 py-16 lg:py-20">

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">

        <!-- A. Bot operators -->
        <a href="/for-agents" class="audience-card group">
          <div class="audience-tag-row">
            <span class="audience-letter">A</span>
            <span class="audience-tag">Bot operators</span>
          </div>
          <h3 class="audience-title">Get your agents accepted everywhere.</h3>
          <p class="audience-desc">
            Stand up a tier-1 issuer in 5 minutes. Your bots present a passport; sites that recognize the protocol let them through. Anthropic, OpenAI, Cursor, Replit, Perplexity, Microsoft Copilot — anyone shipping agentic AI.
          </p>
          <span class="audience-arrow">For agent builders →</span>
        </a>

        <!-- B. Sites -->
        <a href="/for-sites" class="audience-card group">
          <div class="audience-tag-row">
            <span class="audience-letter">B</span>
            <span class="audience-tag">Sites &amp; platforms</span>
          </div>
          <h3 class="audience-title">Honest bots through. Scalpers out.</h3>
          <p class="audience-desc">
            Publish a policy at a well-known URL. Honest shopping assistants pass; scrapers and engagement farms don't. Marketplaces, ticket platforms, review sites, dating apps, social platforms.
          </p>
          <span class="audience-arrow">For site operators →</span>
        </a>

        <!-- C. Bot-defense vendors -->
        <a href="/for-bot-defense" class="audience-card group">
          <div class="audience-tag-row">
            <span class="audience-letter">C</span>
            <span class="audience-tag">Bot-defense vendors</span>
          </div>
          <h3 class="audience-title">A new positive signal alongside your heuristics.</h3>
          <p class="audience-desc">
            Your detection engine gains "verified bot with declared intent" as a distinct class. Cloudflare, Akamai, HUMAN, DataDome, Arkose, Kasada — partner channel for the verifier.
          </p>
          <span class="audience-arrow">For bot-defense vendors →</span>
        </a>

        <!-- D. Publishers -->
        <a href="/for-publishers" class="audience-card group">
          <div class="audience-tag-row">
            <span class="audience-letter">D</span>
            <span class="audience-tag">Content publishers</span>
          </div>
          <h3 class="audience-title">Defensible attribution against AI cloning.</h3>
          <p class="audience-desc">
            Sign your article, image, video at publication. AI clones can't fake the signature; readers, search engines, and courts can verify. NYT, BBC, Reuters, Substack writers, photographers, news agencies.
          </p>
          <span class="audience-arrow">For publishers →</span>
        </a>

        <!-- E. AI compliance -->
        <a href="/for-compliance" class="audience-card group">
          <div class="audience-tag-row">
            <span class="audience-letter">E</span>
            <span class="audience-tag">AI compliance</span>
          </div>
          <h3 class="audience-title">Machine-readable AI Act &amp; state-law attribution.</h3>
          <p class="audience-desc">
            EU AI Act Article 50, China AIGC, US state labeling laws. AgentPKI Provenance turns disclosure obligations into cryptographic proof. AI labs, regulated enterprises, platforms operating in regulated jurisdictions.
          </p>
          <span class="audience-arrow">For compliance teams →</span>
        </a>

        <!-- F. Everyone else -->
        <a href="/for-everyone" class="audience-card group">
          <div class="audience-tag-row">
            <span class="audience-letter">F</span>
            <span class="audience-tag">Everyone else</span>
          </div>
          <h3 class="audience-title">What this means when you're just reading the internet.</h3>
          <p class="audience-desc">
            You don't deploy anything. The internet you use just becomes cleaner: bot intent gets declared, AI content gets attributed, scams and impersonations get cryptographically visible.
          </p>
          <span class="audience-arrow">For everyone →</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       CLOSING CTA
       ═══════════════════════════════════════════════════════════════ -->
  <section class="border-t border-[color:var(--color-border)]">
    <div class="max-w-none px-2 sm:px-3 lg:px-4 py-20 lg:py-24 text-center">
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight mb-5 text-balance">
        If your situation isn't in those six, write to me.
      </h2>
      <p class="text-[color:var(--color-text-muted)] mb-9 text-lg leading-relaxed">
        AgentPKI is open protocol with a hosted reference implementation. Issuers, verifiers, policy holders, content publishers, regulators, agent builders, vendors — if you have a use case, I want to talk.
      </p>
      <button type="button" data-contact-modal data-contact-source="home / closing CTA"
              class="inline-flex items-center gap-2 px-7 py-3.5 rounded-lg bg-[color:var(--color-accent)] text-black font-semibold hover:bg-[color:var(--color-accent-bright)] transition">
        Talk to founder
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <p class="mt-6 text-sm text-[color:var(--color-text-muted)]">
        Or email <a href="mailto:hello@agentpki.dev" class="underline hover:text-[color:var(--color-text)]">hello@agentpki.dev</a> directly.
      </p>
    </div>
  </section>

  <Footer />
  <ContactModal />

  <style is:global>
    /* Audience cards — equal weight, compact, infrastructure-grade */
    .audience-card {
      display: flex; flex-direction: column;
      padding: 1.5rem 1.4rem 1.5rem;
      border-radius: 0.7rem;
      border: 1px solid var(--color-border);
      background: rgba(20, 20, 30, 0.4);
      transition: border-color 0.2s, background 0.2s, transform 0.2s;
      cursor: pointer;
      min-height: 18rem;
    }
    .audience-card:hover {
      border-color: var(--color-accent);
      background: rgba(167, 139, 250, 0.04);
      transform: translateY(-2px);
    }
    .audience-tag-row {
      display: flex; align-items: center; gap: 0.55rem;
      margin-bottom: 0.9rem;
    }
    .audience-letter {
      display: inline-flex; align-items: center; justify-content: center;
      width: 1.5rem; height: 1.5rem;
      border-radius: 0.3rem;
      background: rgba(167,139,250,0.15);
      color: var(--color-accent-bright);
      font-family: ui-monospace, monospace;
      font-weight: 700;
      font-size: 0.78rem;
    }
    .audience-tag {
      font-size: 0.72rem;
      font-family: ui-monospace, monospace;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      font-weight: 600;
    }
    .audience-title {
      font-size: 1.1rem;
      font-weight: 600;
      line-height: 1.3;
      color: var(--color-text);
      margin-bottom: 0.7rem;
      text-wrap: balance;
    }
    .audience-desc {
      color: var(--color-text-muted);
      line-height: 1.55;
      font-size: 0.875rem;
      margin-bottom: 1.2rem;
      flex: 1;
    }
    .audience-arrow {
      color: var(--color-accent-bright);
      font-weight: 600;
      font-size: 0.85rem;
    }
    .audience-card:hover .audience-arrow {
      color: var(--color-text);
    }
  </style>
</Base>
