---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <!-- ──────────── PAGE-LEVEL ANIMATED BACKGROUND ──────────── -->
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <!-- ──────────── HERO — single-column centered text ──────────── -->
  <section class="aurora-glow relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 pt-24 pb-16 lg:pt-32 lg:pb-20 text-center">
      <a href="#try-it-live" class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-8 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur text-xs text-[color:var(--color-text-muted)] hover:border-[color:var(--color-accent)]/50 hover:text-[color:var(--color-text)] transition group">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-green-400"></span>
        </span>
        <span class="font-mono">live</span>
        <span class="text-[color:var(--color-text-dim)]">·</span>
        <span><strong class="text-[color:var(--color-text)] font-medium">agentpki.dev</strong> — live reference issuer &amp; verifier</span>
        <span class="text-[color:var(--color-text-dim)]">·</span>
        <span class="font-mono">v0.1 alpha</span>
        <svg class="w-3 h-3 ml-1 transition-transform group-hover:translate-x-0.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2.5l3 3.5-3 3.5"/></svg>
      </a>

      <h1 class="text-5xl sm:text-6xl lg:text-[5rem] font-semibold tracking-[-0.025em] leading-[1.02] text-balance">
        Cryptographic identity for<br />
        <span class="hero-accent-text">AI agents.</span>
      </h1>

      <p class="mt-7 text-lg lg:text-xl text-[color:var(--color-text-muted)] leading-relaxed max-w-2xl mx-auto text-balance">
        An open protocol and edge-verified PKI for the agentic web. Stateless,
        sub-50&nbsp;ms, vendor-neutral, chain-agnostic — built so legitimate
        agents pass bot-defense and the rest stay blocked.
      </p>

      <div class="mt-9 flex flex-wrap gap-3 justify-center">
        <a href="/demo?run=1"
           class="group inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition">
          <span class="relative flex w-2 h-2">
            <span class="absolute inset-0 rounded-full bg-black/40 animate-ping"></span>
            <span class="relative w-2 h-2 rounded-full bg-black"></span>
          </span>
          Watch the live demo
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/spec/v0.1"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Read the spec
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://dashboard.agentpki.dev"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Sign up free
        </a>
      </div>

      <p class="mt-6 text-xs text-[color:var(--color-text-dim)] tracking-wide">
        Apache 2.0 &middot; open spec &middot; interop with MCP, A2A, Kite, SPIFFE, OWASP ANS
      </p>
    </div>
  </section>

  <!-- ──────────── TRUST FLOW — 2-column: diagram left, narrative right ──────────── -->
  <section class="relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 pt-16 pb-24 lg:pt-20 lg:pb-32">
      <!-- Section header (left-aligned, replaces the old centered caption) -->
      <div class="max-w-3xl mb-12">
        <p class="inline-flex items-center gap-2 mb-4 text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)]">
          <span class="relative flex w-1.5 h-1.5">
            <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>
            <span class="relative w-1.5 h-1.5 rounded-full bg-green-400"></span>
          </span>
          The trust flow &middot; live
        </p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-balance">
          One signature. Three actors. Verified at the edge in <span class="hero-accent-text">under 50 ms</span>.
        </h2>
      </div>

      <!-- Two-column: diagram on the left, "how to read this" on the right -->
      <div class="grid lg:grid-cols-[1.5fr_1fr] gap-10 lg:gap-12 items-center">

        <!-- LEFT: animated diagram with ambient glow -->
        <div class="relative">
          <!-- Ambient glow behind the diagram -->
          <div class="absolute inset-0 -m-8 lg:-m-12 bg-[color:var(--color-accent)]/10 blur-[100px] rounded-[3rem] pointer-events-none" aria-hidden="true"></div>

          <!-- Diagram container with subtle border + backdrop -->
          <div class="relative rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/40 backdrop-blur-sm p-4 sm:p-6 lg:p-7">

          <svg viewBox="0 0 900 480" class="hero-diagram w-full h-auto" xmlns="http://www.w3.org/2000/svg" aria-label="AgentPKI trust flow: issuer mints, agent presents, verifier validates">
            <defs>
              <pattern id="diagGrid" x="0" y="0" width="28" height="28" patternUnits="userSpaceOnUse">
                <circle cx="14" cy="14" r="0.8" fill="rgba(167,139,250,0.18)"/>
              </pattern>
              <linearGradient id="nodeFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"  stop-color="rgba(167,139,250,0.20)"/>
                <stop offset="100%" stop-color="rgba(167,139,250,0.04)"/>
              </linearGradient>
              <linearGradient id="centerFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"  stop-color="rgba(167,139,250,0.36)"/>
                <stop offset="100%" stop-color="rgba(124,58,237,0.12)"/>
              </linearGradient>
              <filter id="centerGlow" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur stdDeviation="8" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <radialGradient id="ambient" cx="0.5" cy="0.5" r="0.5">
                <stop offset="0%"  stop-color="rgba(167,139,250,0.22)"/>
                <stop offset="60%" stop-color="rgba(167,139,250,0.05)"/>
                <stop offset="100%" stop-color="rgba(167,139,250,0.00)"/>
              </radialGradient>
            </defs>

            <!-- Background grid + central glow -->
            <rect width="900" height="480" fill="url(#diagGrid)" />
            <circle cx="450" cy="240" r="200" fill="url(#ambient)" />

            <!-- Flow lines (animated dashes) -->
            <line class="flow-line"       x1="225" y1="240" x2="370" y2="240" stroke="rgba(167,139,250,0.6)" stroke-width="1.8"/>
            <line class="flow-line delay" x1="530" y1="240" x2="675" y2="240" stroke="rgba(167,139,250,0.6)" stroke-width="1.8"/>

            <!-- Pulse dots traveling along flow lines -->
            <circle r="5" fill="#c4b5fd" opacity="0.9">
              <animateMotion dur="2.4s" repeatCount="indefinite" path="M 225 240 L 370 240" />
              <animate attributeName="opacity" values="0;1;1;0" dur="2.4s" repeatCount="indefinite"/>
            </circle>
            <circle r="5" fill="#c4b5fd" opacity="0.9">
              <animateMotion dur="2.4s" repeatCount="indefinite" begin="0.9s" path="M 530 240 L 675 240" />
              <animate attributeName="opacity" values="0;1;1;0" dur="2.4s" repeatCount="indefinite" begin="0.9s"/>
            </circle>

            <!-- ── ISSUER node (left) ── -->
            <g transform="translate(70, 195)">
              <rect width="155" height="90" rx="12" fill="url(#nodeFill)" stroke="rgba(167,139,250,0.6)" stroke-width="1.2"/>
              <text x="77" y="32" text-anchor="middle" fill="#c4b5fd" font-family="ui-monospace,monospace" font-size="13" font-weight="700" letter-spacing="1.5">ISSUER</text>
              <text x="77" y="54" text-anchor="middle" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="11">anthropic.com</text>
              <text x="77" y="72" text-anchor="middle" fill="#6b6b78" font-family="ui-monospace,monospace" font-size="10">Ed25519 &middot; T2 KYB</text>
            </g>

            <!-- ── AGENT / Passport (center, glowing, much bigger) ── -->
            <g transform="translate(370, 130)" filter="url(#centerGlow)">
              <rect class="pulse-ring" x="-6" y="-6" width="172" height="222" rx="20" fill="none" stroke="rgba(167,139,250,0.5)" stroke-width="1.2"/>
              <rect class="passport-glow" width="160" height="210" rx="16" fill="url(#centerFill)" stroke="rgba(167,139,250,0.95)" stroke-width="2"/>

              <text x="80" y="30" text-anchor="middle" fill="#c4b5fd" font-family="ui-monospace,monospace" font-size="13" font-weight="700" letter-spacing="1.5">PASSPORT</text>

              <!-- Stylized passport card -->
              <g transform="translate(20, 50)">
                <rect width="120" height="80" rx="8" fill="rgba(8,8,11,0.7)" stroke="rgba(167,139,250,0.75)" stroke-width="1.2"/>
                <!-- Avatar circle -->
                <circle cx="20" cy="22" r="10" fill="none" stroke="rgba(196,181,253,0.9)" stroke-width="1.4"/>
                <circle cx="20" cy="19" r="3.5" fill="rgba(196,181,253,0.4)"/>
                <path d="M 12 28 Q 20 22 28 28" fill="none" stroke="rgba(196,181,253,0.4)" stroke-width="1"/>
                <!-- Header lines -->
                <line x1="38" y1="16" x2="106" y2="16" stroke="rgba(196,181,253,0.7)" stroke-width="1.2"/>
                <line x1="38" y1="24" x2="92" y2="24" stroke="rgba(196,181,253,0.45)" stroke-width="1"/>
                <!-- Separator -->
                <line x1="10" y1="42" x2="110" y2="42" stroke="rgba(167,139,250,0.3)" stroke-width="0.7" stroke-dasharray="3 3"/>
                <!-- Token preview -->
                <text x="10" y="56" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="8">v4.public.eyJpc3MiOi</text>
                <text x="10" y="68" fill="#7c7c8a" font-family="ui-monospace,monospace" font-size="8">JhbnRocm9waWMuY29t</text>
              </g>

              <!-- Scope chips inside passport node -->
              <g transform="translate(15, 145)">
                <rect width="62" height="20" rx="10" fill="rgba(167,139,250,0.14)" stroke="rgba(167,139,250,0.4)"/>
                <text x="31" y="14" text-anchor="middle" fill="#c4b5fd" font-family="ui-monospace,monospace" font-size="9">read:*</text>
              </g>
              <g transform="translate(83, 145)">
                <rect width="62" height="20" rx="10" fill="rgba(167,139,250,0.14)" stroke="rgba(167,139,250,0.4)"/>
                <text x="31" y="14" text-anchor="middle" fill="#c4b5fd" font-family="ui-monospace,monospace" font-size="9">tier: 2</text>
              </g>

              <text x="80" y="190" text-anchor="middle" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="10">Ed25519 &middot; 24h max</text>
            </g>

            <!-- ── VERIFIER node (right) ── -->
            <g transform="translate(675, 195)">
              <rect width="155" height="90" rx="12" fill="url(#nodeFill)" stroke="rgba(167,139,250,0.6)" stroke-width="1.2"/>
              <text x="77" y="32" text-anchor="middle" fill="#c4b5fd" font-family="ui-monospace,monospace" font-size="13" font-weight="700" letter-spacing="1.5">VERIFIER</text>
              <text x="77" y="54" text-anchor="middle" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="11">verify.agentpki.dev</text>
              <text x="77" y="72" text-anchor="middle" fill="#6b6b78" font-family="ui-monospace,monospace" font-size="10">&lt; 50ms p99 &middot; edge</text>
            </g>

            <!-- Flow labels -->
            <text x="297" y="225" text-anchor="middle" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="11" font-weight="600">mint</text>
            <text x="297" y="262" text-anchor="middle" fill="#6b6b78" font-family="ui-monospace,monospace" font-size="9">PASETO v4.public</text>

            <text x="602" y="225" text-anchor="middle" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="11" font-weight="600">verify</text>
            <text x="602" y="262" text-anchor="middle" fill="#6b6b78" font-family="ui-monospace,monospace" font-size="9">RFC 9421 Mode B</text>

            <!-- Verdict callout (bottom right, under verifier) -->
            <g transform="translate(675, 320)">
              <rect width="155" height="80" rx="10" fill="rgba(34,197,94,0.08)" stroke="rgba(74,222,128,0.5)" stroke-width="1.2"/>
              <circle cx="20" cy="20" r="6" fill="rgba(74,222,128,0.25)" stroke="rgba(74,222,128,0.9)" stroke-width="1.2"/>
              <path d="M 17 20 l 2.5 2.5 L 24 17" fill="none" stroke="rgba(134,239,172,1)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <text x="34" y="24" fill="#86efac" font-family="ui-monospace,monospace" font-size="11" font-weight="700">verdict: allow</text>
              <line x1="12" y1="38" x2="143" y2="38" stroke="rgba(255,255,255,0.06)" stroke-width="0.7"/>
              <text x="12" y="54" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="9">tier: 2 &middot; abuse: 0.02</text>
              <text x="12" y="68" fill="#6b6b78" font-family="ui-monospace,monospace" font-size="9">cached_until: +60s</text>
            </g>

            <!-- Issuer key/cert callout (bottom left, under issuer) -->
            <g transform="translate(70, 320)">
              <rect width="155" height="80" rx="10" fill="rgba(167,139,250,0.06)" stroke="rgba(167,139,250,0.35)" stroke-width="1.2"/>
              <g transform="translate(12, 14)">
                <rect width="14" height="18" rx="2" fill="none" stroke="rgba(196,181,253,0.85)" stroke-width="1.2"/>
                <circle cx="7" cy="9" r="3" fill="rgba(196,181,253,0.35)"/>
                <line x1="7" y1="13" x2="7" y2="16" stroke="rgba(196,181,253,0.85)" stroke-width="1.2"/>
              </g>
              <text x="34" y="22" fill="#c4b5fd" font-family="ui-monospace,monospace" font-size="11" font-weight="700">issuer key</text>
              <line x1="12" y1="36" x2="143" y2="36" stroke="rgba(255,255,255,0.06)" stroke-width="0.7"/>
              <text x="12" y="52" fill="#9c9cab" font-family="ui-monospace,monospace" font-size="9">kid: anthropic-2026-q2</text>
              <text x="12" y="66" fill="#6b6b78" font-family="ui-monospace,monospace" font-size="9">HSM-resident · rotates 90d</text>
            </g>

          </svg>
        </div>
        </div>
        <!-- End LEFT column -->

        <!-- RIGHT: how to read this -->
        <div>
          <h3 class="font-mono text-[10px] uppercase tracking-widest text-[color:var(--color-text-dim)] mb-5">How to read this</h3>

          <ol class="space-y-5">
            <li class="flex gap-4">
              <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold border border-[color:var(--color-accent)]/30">01</span>
              <div>
                <h4 class="font-semibold tracking-tight">Issuer signs</h4>
                <p class="mt-1 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
                  An agent platform (e.g., <code class="text-xs">anthropic.com</code>) signs a short-lived PASETO v4 passport with their Ed25519 private key. The key lives in an HSM and rotates every 90 days. The signed passport carries the agent's identity, capability scope, and trust tier.
                </p>
              </div>
            </li>

            <li class="flex gap-4">
              <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold border border-[color:var(--color-accent)]/30">02</span>
              <div>
                <h4 class="font-semibold tracking-tight">Agent presents</h4>
                <p class="mt-1 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
                  The SDK attaches the passport to every outbound HTTPS request — either as a bearer header (Mode A) or via RFC 9421 HTTP Message Signatures bound to the request body (Mode B). One-line integration for the agent platform.
                </p>
              </div>
            </li>

            <li class="flex gap-4">
              <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent-bright)] font-mono text-xs font-semibold border border-[color:var(--color-accent)]/30">03</span>
              <div>
                <h4 class="font-semibold tracking-tight">Verifier validates</h4>
                <p class="mt-1 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
                  The receiving site/API runs the verifier at the edge: fetches the issuer's public key from <code class="text-xs">/.well-known/agentpki-issuer.json</code> (cached in Workers KV), verifies the Ed25519 signature, consults the revocation list, applies site policy, returns a verdict — under 50 ms p99, globally.
                </p>
              </div>
            </li>
          </ol>

          <div class="mt-8 pt-6 border-t border-[color:var(--color-border)]">
            <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
              No shared secrets. No blockchain. No callout to a vendor's API. The site that's deciding doesn't have to trust any single bot-defense vendor — only the issuer's published public key.
            </p>
            <a href="/demo?run=1" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[color:var(--color-accent)] hover:text-[color:var(--color-accent-bright)] transition group">
              Watch it run live
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
        <!-- End RIGHT column -->
      </div>
    </div>
  </section>

  <!-- ──────────── STATS STRIP (NEW) ──────────── -->
  <section class="border-y border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]/30">
    <div class="max-w-6xl mx-auto px-6 py-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="stat-card p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl sm:text-5xl font-semibold tracking-tight text-[color:var(--color-accent-bright)]">&lt;50</span>
            <span class="text-base text-[color:var(--color-text-muted)]">ms</span>
          </div>
          <p class="mt-2 text-xs text-[color:var(--color-text-muted)] tracking-wide uppercase">p99 verify · edge global</p>
        </div>
        <div class="stat-card p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl sm:text-5xl font-semibold tracking-tight text-[color:var(--color-accent-bright)]">Ed25519</span>
          </div>
          <p class="mt-2 text-xs text-[color:var(--color-text-muted)] tracking-wide uppercase">RFC 8032 signing throughout</p>
        </div>
        <div class="stat-card p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl sm:text-5xl font-semibold tracking-tight text-[color:var(--color-accent-bright)]">24</span>
            <span class="text-base text-[color:var(--color-text-muted)]">h max</span>
          </div>
          <p class="mt-2 text-xs text-[color:var(--color-text-muted)] tracking-wide uppercase">passport lifetime · short-lived</p>
        </div>
        <div class="stat-card p-6 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-bg-elevated)]">
          <div class="flex items-baseline gap-2">
            <span class="text-4xl sm:text-5xl font-semibold tracking-tight text-[color:var(--color-accent-bright)]">3</span>
            <span class="text-base text-[color:var(--color-text-muted)]">tiers</span>
          </div>
          <p class="mt-2 text-xs text-[color:var(--color-text-muted)] tracking-wide uppercase">DNS · KYB · hardware-attested</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── PROBLEM ─────────── -->
  <section>
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="max-w-3xl">
        <span class="inline-block px-3 py-1 mb-5 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 text-[10px] font-mono uppercase tracking-widest text-[color:var(--color-text-dim)]">The problem</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-balance">
          The agentic web needs an identity layer it doesn't have yet.
        </h2>
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-4">
        <!-- Problem card 1: bot defense -->
        <div class="rounded-xl border border-red-500/25 bg-red-500/[0.03] p-7 relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-32 h-32 bg-red-500/10 blur-3xl rounded-full pointer-events-none"></div>
          <div class="relative">
            <div class="flex items-center gap-2 mb-4">
              <svg class="w-5 h-5 text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              <span class="font-mono text-[10px] uppercase tracking-widest text-red-400">false positives</span>
            </div>
            <h3 class="font-semibold tracking-tight text-lg">Bot defense can't tell agents apart from scrapers.</h3>
