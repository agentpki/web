    padding: 1.25rem;
  }
  .reason-num {
    font-family: ui-monospace, monospace;
    font-size: 1.8rem; font-weight: 800;
    background: linear-gradient(135deg, var(--color-accent-bright), var(--color-accent));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* ══════ Layer 05+ teaser — must stand out from the four shipped layers ══════ */
  .layer-five-plus {
    background:
      linear-gradient(135deg, rgba(124, 58, 237, 0.20), rgba(167, 139, 250, 0.08) 40%, rgba(167, 139, 250, 0.02));
    border: 2px solid rgba(167, 139, 250, 0.55);
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.1),
      0 12px 40px -10px rgba(124, 58, 237, 0.3);
    animation: lfp-pulse 3.4s ease-in-out infinite;
  }
  @keyframes lfp-pulse {
    0%, 100% {
      border-color: rgba(167, 139, 250, 0.55);
      box-shadow:
        0 0 0 1px rgba(167, 139, 250, 0.1),
        0 12px 40px -10px rgba(124, 58, 237, 0.3);
    }
    50% {
      border-color: rgba(196, 181, 253, 0.85);
      box-shadow:
        0 0 0 2px rgba(196, 181, 253, 0.2),
        0 18px 60px -8px rgba(124, 58, 237, 0.5);
    }
  }
  .layer-five-plus-glow {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 60% at 0% 50%, rgba(167, 139, 250, 0.15), transparent 70%);
    pointer-events: none;
  }
  .layer-five-plus-pulse-dot {
    display: inline-block;
    width: 8px; height: 8px; border-radius: 50%;
    background: #c4b5fd;
    box-shadow: 0 0 0 0 rgba(196, 181, 253, 0.7);
    animation: lfp-dot-pulse 1.6s ease-in-out infinite;
  }
  @keyframes lfp-dot-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(196, 181, 253, 0.7); transform: scale(1); }
    50%      { box-shadow: 0 0 0 8px rgba(196, 181, 253, 0); transform: scale(1.15); }
  }

  /* ══════ Flashing 'Coming soon' tag on the Chrome-extension section ══════ */
  .coming-soon-flash {
    animation: coming-soon-flash 1.8s ease-in-out infinite;
  }
  @keyframes coming-soon-flash {
    0%, 100% {
      background-color: rgba(120, 53, 15, 0.4);
      border-color: rgba(251, 191, 36, 0.5);
      box-shadow: 0 0 0 0 rgba(251, 191, 36, 0);
    }
    50% {
      background-color: rgba(180, 83, 9, 0.5);
      border-color: rgba(252, 211, 77, 0.9);
      box-shadow: 0 0 24px 2px rgba(251, 191, 36, 0.35);
    }
  }

  /* ── Faux Chrome browser frame (animated extension demo) ── */
  .browser-frame {
    background: #18181b;
    border-radius: 12px;
    border: 1px solid var(--color-border-bright);
    box-shadow:
      0 50px 80px -20px rgba(0, 0, 0, 0.5),
      0 30px 60px -30px rgba(124, 58, 237, 0.3);
    overflow: hidden;
  }
  .browser-titlebar {
    background: #27272a; padding: 10px 14px;
    display: flex; align-items: center; gap: 10px;
    border-bottom: 1px solid #3f3f46;
  }
  .browser-dot { width: 12px; height: 12px; border-radius: 50%; }
  .browser-tab {
    background: #18181b; color: #d4d4d8;
    padding: 6px 16px 6px 12px;
    border-radius: 8px 8px 0 0;
    font-size: 11px;
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid #3f3f46; border-bottom: none;
    margin-bottom: -1px;
  }
  .browser-toolbar {
    background: #1f1f23; padding: 8px 14px;
    display: flex; align-items: center; gap: 10px;
    border-bottom: 1px solid #3f3f46;
  }
  .browser-addressbar {
    flex: 1; background: #0f0f12;
    border: 1px solid #3f3f46;
    border-radius: 18px; padding: 6px 14px;
    font-size: 11px; color: #d4d4d8;
    font-family: ui-monospace, monospace;
    display: flex; align-items: center; gap: 6px;
  }
  .browser-page {
    background: #ffffff; min-height: 320px;
    padding: 24px; color: #18181b;
    position: relative;
  }

  /* Extension icon + animated badge */
  .ext-icon {
    width: 32px; height: 32px;
    background: linear-gradient(135deg, #a78bfa, #7c3aed);
    border-radius: 6px; position: relative;
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 700; font-size: 14px;
    box-shadow: 0 2px 6px rgba(124, 58, 237, 0.3);
    cursor: pointer;
  }
  .ext-badge {
    position: absolute; bottom: -3px; right: -3px;
    min-width: 16px; height: 16px; border-radius: 8px;
    background: #6b6b78; color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 9px; font-weight: 800; line-height: 1;
    border: 2px solid #1f1f23;
    transition: all 0.25s ease;
  }
  .ext-badge[data-color="gray"]   { background: #6b6b78; color: transparent; }
  .ext-badge[data-color="white"]  { background: #9c9cab; }
  .ext-badge[data-color="green"]  { background: #22c55e; box-shadow: 0 0 12px rgba(34, 197, 94, 0.6); }
  .ext-badge[data-color="yellow"] { background: #fbbf24; box-shadow: 0 0 12px rgba(251, 191, 36, 0.6); }
  .ext-badge[data-color="red"]    { background: #ef4444; box-shadow: 0 0 12px rgba(239, 68, 68, 0.6); }

  /* Popup that appears on the verified stage */
  .ext-popup {
    position: absolute; top: 100%; right: -2px; margin-top: 6px;
    width: 320px; background: #09090b;
    border: 1px solid #27272a; border-radius: 8px;
    padding: 14px; color: #e7e7ea;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    opacity: 0; transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
    z-index: 50;
  }
  .ext-popup.open { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 6px 10px; border-radius: 5px;
    font-family: ui-monospace, monospace; font-size: 12px;
  }
  .pill-green { background: rgba(34, 197, 94, 0.15); color: #86efac; border: 1px solid rgba(34, 197, 94, 0.3); }
  .pill-trusted {
    background: rgba(34, 197, 94, 0.15); color: #86efac;
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 1px 6px; border-radius: 3px; font-size: 10px;
  }

  /* Stage progress dots above the browser */
  .stage-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #3f3f46; transition: all 0.3s ease;
    display: inline-block;
  }
  .stage-dot.active {
    background: var(--color-accent);
    transform: scale(1.4);
    box-shadow: 0 0 8px var(--color-accent);
  }
  .stage-label {
    font-family: ui-monospace, monospace; font-size: 10px;
    color: var(--color-text-dim);
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .stage-label.active { color: var(--color-accent-bright); }

  /* Pulsing dot inside the fake AI chat */
  .pulse-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #fbbf24;
    animation: ext-pulse 1.5s ease infinite;
    display: inline-block;
  }
  @keyframes ext-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; box-shadow: 0 0 10px #fbbf24; }
  }
</style>

<script is:inline>
  // ── 4-stage browser-demo loop on the homepage ──
  (function () {
    const stages = [
      { color: 'gray', symbol: '', labelIdx: 1, caption: 'You open a banking site. The agent on the page hasn’t been examined yet — badge is gray.', pageCaption: 'Page just loaded…', popupOpen: false },
      { color: 'yellow', symbol: '!', labelIdx: 2, caption: 'The extension detects an AI agent framework on the page (e.g. LangChain.js) — badge turns yellow.', pageCaption: 'AI agent is responding…', popupOpen: false },
      { color: 'white',  symbol: '?', labelIdx: 3, caption: 'A passport token is found. The extension calls verify.agentpki.dev for a verdict (~100 ms).', pageCaption: 'AI agent is responding…', popupOpen: false },
      { color: 'green',  symbol: '✓', labelIdx: 4, caption: 'Verified ✓ — the passport is real, from a trusted issuer, with the scopes the agent claims.', pageCaption: 'AI agent is responding…', popupOpen: true },
    ];
    let cur = 0;
    const badge = document.getElementById('extBadge');
    const popup = document.getElementById('extPopup');
    const caption = document.getElementById('stageCaption');
    const pageCaption = document.getElementById('pageCaption');
    const dots = [1,2,3,4].map(n => document.getElementById('dot-' + n));
    const labels = [1,2,3,4].map(n => document.getElementById('label-' + n));
    if (!badge || !popup || !caption) return;
    function paint(idx) {
      const s = stages[idx];
      badge.setAttribute('data-color', s.color);
      badge.textContent = s.symbol;
      caption.textContent = s.caption;
      if (pageCaption) pageCaption.textContent = s.pageCaption;
      popup.classList.toggle('open', s.popupOpen);
      dots.forEach((d, i) => { if (d) d.classList.toggle('active', i + 1 === s.labelIdx); });
      labels.forEach((l, i) => { if (l) l.classList.toggle('active', i + 1 === s.labelIdx); });
    }
    paint(0);
    setInterval(() => { cur = (cur + 1) % stages.length; paint(cur); }, 3000);
    // Click the toolbar icon to manually toggle the popup
    const icon = document.getElementById('extIcon');
    if (icon) icon.addEventListener('click', (e) => { e.stopPropagation(); popup.classList.toggle('open'); });
  })();
</script>

