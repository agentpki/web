---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---
<Base>
  <!-- ──────────── PAGE-LEVEL ANIMATED BACKGROUND ──────────── -->
  <div class="bg-layer bg-mesh" aria-hidden="true"></div>
  <div class="bg-layer bg-grid" aria-hidden="true"></div>

  <Nav />

  <!-- ──────────── HERO — single-column centered text ──────────── -->
  <section class="aurora-glow relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 pt-24 pb-16 lg:pt-32 lg:pb-20 text-center">
      <a href="/demo" class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-8 rounded-full border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/60 backdrop-blur text-xs text-[color:var(--color-text-muted)] hover:border-[color:var(--color-accent)]/50 hover:text-[color:var(--color-text)] transition group">
        <span class="relative flex w-1.5 h-1.5">
          <span class="absolute inset-0 rounded-full bg-green-400 opacity-75 animate-ping"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-green-400"></span>
        </span>
        <span class="font-mono">live</span>
        <span class="text-[color:var(--color-text-dim)]">·</span>
        <span><strong class="text-[color:var(--color-text)] font-medium">agentpki.dev</strong> — live reference issuer &amp; verifier</span>
        <span class="text-[color:var(--color-text-dim)]">·</span>
        <span class="font-mono">v0.1 alpha</span>
        <svg class="w-3 h-3 ml-1 transition-transform group-hover:translate-x-0.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2.5l3 3.5-3 3.5"/></svg>
      </a>

      <h1 class="text-5xl sm:text-6xl lg:text-[5rem] font-semibold tracking-[-0.025em] leading-[1.02] text-balance">
        Cryptographic identity for<br />
        <span class="hero-accent-text">AI agents.</span>
      </h1>

      <p class="mt-7 text-xl sm:text-2xl lg:text-[1.6rem] text-[color:var(--color-text-muted)] leading-snug max-w-5xl mx-auto lg:whitespace-nowrap">
        A passport-based identity system for AI agents on the public internet.
      </p>
      <p class="mt-5 text-base sm:text-lg lg:text-xl text-[color:var(--color-text-dim)] leading-relaxed max-w-2xl mx-auto text-balance">
        Open protocol, edge-verified, sub-50&nbsp;ms, vendor-neutral, chain-agnostic — built so legitimate agents pass bot-defense and the rest stay blocked.
      </p>

      <div class="mt-9 flex flex-wrap gap-3 justify-center">
        <a href="/demo?run=1"
           class="group inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition">
          <span class="relative flex w-2 h-2">
            <span class="absolute inset-0 rounded-full bg-black/40 animate-ping"></span>
            <span class="relative w-2 h-2 rounded-full bg-black"></span>
          </span>
          Watch the live demo
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/spec/v0.1"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Read the spec
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M7.5 3.5l5 6.5-5 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="https://dashboard.agentpki.dev"
           class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-[color:var(--color-border-bright)] hover:border-[color:var(--color-accent)]/50 hover:bg-[color:var(--color-bg-elevated)]/60 transition">
          Sign up free
        </a>
      </div>

      <p class="mt-6 text-xs text-[color:var(--color-text-dim)] tracking-wide">
        Apache 2.0 &middot; open spec &middot; interop with MCP, A2A, Kite, SPIFFE, OWASP ANS
      </p>
    </div>
  </section>

  <!-- ══════════════ BUILT ACROSS THE STACK — 4 audiences, all shipped ══════════════ -->
  <section id="shipped" class="relative">

    <!-- Top stats strip -->
    <div class="max-w-5xl mx-auto px-6 py-10 grid grid-cols-2 sm:grid-cols-4 gap-4 border-t border-b border-[color:var(--color-border)]">
      <div class="text-center">
        <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">60</div>
        <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Days to v0.1</div>
      </div>
      <div class="text-center">
        <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">8</div>
        <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Public repos</div>
      </div>
      <div class="text-center">
        <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">&lt;50ms</div>
        <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Edge verify p99</div>
      </div>
      <div class="text-center">
        <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">$0</div>
        <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">To self-host</div>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-6 pt-14 pb-20">

      <!-- Section header -->
      <div class="max-w-3xl mb-10">
        <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">Built across the stack</p>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight">
          One open protocol. <span class="hero-accent-text">Four audiences.</span> All live today.
        </h2>
      </div>

      <!-- 4 layer cards -->
      <div class="grid lg:grid-cols-2 gap-6">

        <!-- LAYER 1 — Protocol -->
        <div class="layer-card layer-protocol">
          <div class="layer-card-head mb-3">
            <div>
              <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-accent-bright)] mb-1">Layer 01</p>
              <h3 class="text-xl font-semibold text-[color:var(--color-text)]">The open protocol</h3>
              <p class="text-sm text-[color:var(--color-text-muted)] mt-1.5">Cryptographic identity for AI agents, as an open standard.</p>
            </div>
            <span class="ship-pill">&#10003; shipped</span>
          </div>
          <div class="ship-list">
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>AgentPKI Protocol v0.1 specification</strong> &middot; Apache 2.0
                <div class="ship-item-meta">PASETO v4 + Ed25519 + RFC 9421 &middot; <a href="/spec/v0.1">/spec/v0.1</a></div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>TypeScript SDK</strong> on npm
                <div class="ship-item-meta">@agentpki/sdk &middot; runs in Node, Workers, browsers</div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Python SDK</strong> on PyPI
                <div class="ship-item-meta">agentpki &middot; Django/Flask/FastAPI compatible</div>
              </div>
            </div>
          </div>
        </div>

        <!-- LAYER 2 — Edge security -->
        <div class="layer-card layer-edge">
          <div class="layer-card-head mb-3">
            <div>
              <p class="text-xs font-mono tracking-widest uppercase text-blue-300 mb-1">Layer 02</p>
              <h3 class="text-xl font-semibold text-[color:var(--color-text)]">For edge security</h3>
              <p class="text-sm text-[color:var(--color-text-muted)] mt-1.5">Distinguish legitimate agents from abuse, at the edge, in milliseconds.</p>
            </div>
            <span class="ship-pill">&#10003; shipped</span>
          </div>
          <div class="ship-list">
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Public verification API</strong> at verify.agentpki.dev
                <div class="ship-item-meta">Sub-50ms p99, free + open source, no API key required</div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>30-line drop-in middleware</strong> for any HTTP framework
                <div class="ship-item-meta">Express, Hono, Cloudflare Workers, Fastify recipes shipped</div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Open-source reference verifier</strong>
                <div class="ship-item-meta">Run your own &middot; <a href="https://github.com/agentpki/verifier">github.com/agentpki/verifier</a></div>
              </div>
            </div>
          </div>
        </div>

        <!-- LAYER 3 — Agent operators -->
        <div class="layer-card layer-ops">
          <div class="layer-card-head mb-3">
            <div>
              <p class="text-xs font-mono tracking-widest uppercase text-green-300 mb-1">Layer 03</p>
              <h3 class="text-xl font-semibold text-[color:var(--color-text)]">For agent operators</h3>
              <p class="text-sm text-[color:var(--color-text-muted)] mt-1.5">Issue, manage, and revoke identities for the agents you operate.</p>
            </div>
            <span class="ship-pill">&#10003; shipped</span>
          </div>
          <div class="ship-list">
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Self-serve issuer onboarding</strong> at dashboard.agentpki.dev
                <div class="ship-item-meta">Magic-link auth, DNS-verified domain ownership</div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Production-grade issuer template</strong>
                <div class="ship-item-meta">Cloudflare Worker, fork-and-deploy &middot; <a href="https://github.com/agentpki/real-issuer">github.com/agentpki/real-issuer</a></div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Issuer dashboard with key management</strong>
                <div class="ship-item-meta">Key rotation, CRL publishing, issuer health</div>
              </div>
            </div>
          </div>
        </div>

        <!-- LAYER 4 — Consumers -->
        <div class="layer-card layer-consumer">
          <div class="layer-card-head mb-3">
            <div>
              <p class="text-xs font-mono tracking-widest uppercase text-amber-300 mb-1">Layer 04</p>
              <h3 class="text-xl font-semibold text-[color:var(--color-text)]">For consumers</h3>
              <p class="text-sm text-[color:var(--color-text-muted)] mt-1.5">See whether the AI agents you encounter are verified, on any device.</p>
            </div>
            <span class="ship-pill">&#10003; shipped</span>
          </div>
          <div class="ship-list">
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>AgentPKI Guardian</strong> &mdash; Chrome extension
                <div class="ship-item-meta">Pending Chrome Web Store approval &middot; the HTTPS padlock for AI</div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Web verifier</strong> at <a href="/check" class="underline text-[color:var(--color-accent-bright)]">agentpki.dev/check</a>
                <div class="ship-item-meta">No install &middot; 5,000+ phishing domains tracked &middot; abuse-report flow</div>
              </div>
            </div>
            <div class="ship-item">
              <span class="ship-item-mark">&check;</span>
              <div class="ship-item-text">
                <strong>Free, open source, no tracking</strong>
                <div class="ship-item-meta">MIT licensed &middot; anonymous UUID for abuse reports &middot; no telemetry</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- LAYER 05+ teaser — VC / investor inbound hook, intentionally attention-grabbing -->
      <div class="layer-five-plus mt-10 relative rounded-2xl p-6 sm:p-8 overflow-hidden">
        <!-- Animated border glow -->
        <div class="layer-five-plus-glow" aria-hidden="true"></div>
        <div class="relative flex items-start gap-5 flex-wrap">
          <div class="flex-1 min-w-[16rem]">
            <div class="inline-flex items-center gap-2 px-3 py-1 mb-3 rounded-full bg-violet-500/15 border border-violet-400/40">
              <span class="layer-five-plus-pulse-dot" aria-hidden="true"></span>
              <span class="text-[11px] font-mono tracking-widest uppercase font-bold text-violet-200">
                For investors &amp; partners &middot; Layer 05+
              </span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-semibold mb-3 leading-tight">
              We&rsquo;ve built more layers.<br />
              <span class="text-[color:var(--color-text-muted)]">We&rsquo;re not talking about them yet.</span>
            </h3>
            <p class="text-base text-[color:var(--color-text-muted)] leading-relaxed">
              The four shipped above are the open, public, no-strings-attached stack &mdash; everything anyone needs to verify AI agents today. We have additional layers in development that compound on these and form the next chapters. Get in touch for the brief.
            </p>
          </div>
          <a href="mailto:hello@agentpki.dev?subject=Roadmap%20brief" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-[color:var(--color-accent)] text-black font-semibold hover:bg-[color:var(--color-accent-bright)] transition flex-shrink-0 shadow-lg shadow-violet-500/30">
            Ask for the brief &rarr;
          </a>
        </div>
      </div>

      <!-- Why now / TAM (no "billion dollar wedge" line, no funding posture) -->
      <div class="mt-16 max-w-3xl">
        <p class="text-xs font-mono tracking-widest uppercase text-[color:var(--color-text-muted)] mb-3">Why now</p>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-semibold tracking-tight">
          AI agents are <span class="hero-accent-text">the next 10 billion users</span>. They need identity infrastructure.
        </h2>
      </div>

      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="reason-card">
          <div class="reason-num">01</div>
          <h4 class="text-base font-semibold mt-2 mb-2">2026 = the agent year</h4>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
            Anthropic, OpenAI, Google all shipped autonomous browsing in 2025. Most websites cannot yet distinguish a real agent from a scraper or scammer. The trust gap widens daily.
          </p>
        </div>
        <div class="reason-card">
          <div class="reason-num">02</div>
          <h4 class="text-base font-semibold mt-2 mb-2">HTTPS in 1995</h4>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
            Same shape: a new cryptographic primitive solving the next layer of trust on the internet. Adoption took a decade; the protocol owner shaped the next 20 years of the web.
          </p>
        </div>
        <div class="reason-card">
          <div class="reason-num">03</div>
          <h4 class="text-base font-semibold mt-2 mb-2">Two-sided network</h4>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
            Every issuer makes the consumer side more valuable. Every consumer install makes the issuer side more valuable. Classic compounding flywheel.
          </p>
        </div>
        <div class="reason-card">
          <div class="reason-num">04</div>
          <h4 class="text-base font-semibold mt-2 mb-2">Open beats proprietary</h4>
          <p class="text-sm text-[color:var(--color-text-muted)] leading-relaxed">
            The standard wins. Apache-licensed protocol means every other player is a potential customer of the reference infra, not a competitor.
          </p>
        </div>
      </div>

      <!-- Market sizing — just two stats, no funding posture -->
      <div class="mt-10 rounded-xl border border-[color:var(--color-border-bright)] bg-[color:var(--color-bg-elevated)]/40 p-6 sm:p-8">
        <div class="grid sm:grid-cols-2 gap-6 items-center text-center sm:text-left">
          <div>
            <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">$30B+</div>
            <p class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Bot-defense market today</p>
          </div>
          <div>
            <div class="big-stat text-3xl sm:text-4xl font-semibold hero-accent-text">10x</div>
            <p class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)] mt-1">Projected agent traffic 2026 &rarr; 2028</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════ CHROME EXTENSION SHOWCASE — pending CWS review ══════════════ -->
  <section id="extension" class="relative overflow-hidden pb-24">
    <!-- ambient violet glow behind section -->
    <div class="absolute inset-0 -m-10 lg:-m-16 bg-[color:var(--color-accent)]/8 blur-[120px] pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-16">

      <!-- Section header -->
      <div class="max-w-3xl mb-12">
        <div class="coming-soon-flash inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border mb-4 text-xs font-mono tracking-widest uppercase font-bold">
          <span class="relative flex w-1.5 h-1.5">
            <span class="absolute inset-0 rounded-full bg-amber-400 opacity-75 animate-ping"></span>
            <span class="relative w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          </span>
          <span class="text-amber-200">Coming soon</span>
          <span class="text-amber-200/60">&middot;</span>
          <span class="text-amber-100">The Chrome extension &mdash; pending Chrome Web Store review</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight">
          See whether an AI agent on the page is who it claims to be &mdash; <span class="hero-accent-text">in your toolbar</span>.
        </h2>
        <p class="mt-5 text-base sm:text-lg text-[color:var(--color-text-muted)] leading-relaxed">
          The AgentPKI Chrome extension is the consumer end of the standard. It detects AI agents on any page, verifies their cryptographic passport, and surfaces a one-glance trust badge. Free, open source, zero telemetry. <strong class="text-[color:var(--color-text)]">Pending Chrome Web Store review &mdash; install link will go here as soon as it ships.</strong>
        </p>
      </div>

      <!-- ── Animated browser demo + side narration ── -->
      <div class="grid lg:grid-cols-5 gap-8 items-center mb-12">

        <!-- Stage indicator + browser mock (3/5 of width) -->
        <div class="lg:col-span-3 relative">

          <!-- Stage indicator dots above the browser -->
          <div class="flex items-center justify-center gap-4 mb-4">
            <div class="flex items-center gap-2">
              <span id="dot-1" class="stage-dot active"></span>
              <span id="label-1" class="stage-label active">Load</span>
            </div>
            <span class="text-[color:var(--color-text-dim)]">&rarr;</span>
            <div class="flex items-center gap-2">
              <span id="dot-2" class="stage-dot"></span>
              <span id="label-2" class="stage-label">Detect</span>
            </div>
            <span class="text-[color:var(--color-text-dim)]">&rarr;</span>
            <div class="flex items-center gap-2">
              <span id="dot-3" class="stage-dot"></span>
              <span id="label-3" class="stage-label">Verify</span>
            </div>
            <span class="text-[color:var(--color-text-dim)]">&rarr;</span>
            <div class="flex items-center gap-2">
              <span id="dot-4" class="stage-dot"></span>
              <span id="label-4" class="stage-label">Trust</span>
            </div>
          </div>

          <!-- Faux Chrome window -->
          <div class="browser-frame">
            <div class="browser-titlebar">
              <span class="browser-dot" style="background:#ef4444"></span>
              <span class="browser-dot" style="background:#fbbf24"></span>
              <span class="browser-dot" style="background:#22c55e"></span>
              <div class="ml-3 browser-tab">
                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                support.acme-bank.example
              </div>
            </div>

            <div class="browser-toolbar">
              <span class="text-[color:#71717a] text-xs">&larr;</span>
              <span class="text-[color:#71717a] text-xs">&rarr;</span>
              <span class="text-[color:#71717a] text-xs">&#10227;</span>
              <div class="browser-addressbar">
                <span class="text-green-400">&#128274;</span>
                <span>https://support.acme-bank.example</span>
              </div>
              <div class="relative">
                <div id="extIcon" class="ext-icon">
                  A
                  <div id="extBadge" class="ext-badge" data-color="gray">!</div>
                </div>
                <!-- Popup that opens on the 'verified' stage -->
                <div id="extPopup" class="ext-popup">
                  <div class="flex items-center gap-2 mb-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-violet-400"></span>
                    <span class="text-sm font-semibold">AgentPKI</span>
                    <span class="text-xs text-zinc-500 ml-auto">AI Agent Verification</span>
                  </div>
                  <div id="popupPill" class="pill pill-green">&#10003; Verified</div>
                  <div class="mt-3 space-y-2 text-xs">
                    <div>
                      <div class="text-[10px] uppercase tracking-widest text-zinc-500">Issuer</div>
                      <div class="text-violet-300 font-mono">acme-bank.example <span class="pill-trusted">&#10003; Verified</span></div>
                    </div>
                    <div>
                      <div class="text-[10px] uppercase tracking-widest text-zinc-500">Agent</div>
                      <div class="text-zinc-200 font-mono">agent:acme/support-v2</div>
                    </div>
                    <div>
                      <div class="text-[10px] uppercase tracking-widest text-zinc-500">Scopes</div>
                      <div class="text-zinc-300 font-mono">read:account, send:message</div>
                    </div>
                    <div>
                      <div class="text-[10px] uppercase tracking-widest text-zinc-500">Reputation</div>
                      <div class="flex items-center gap-2"><span class="text-green-300">Clean</span><span class="text-zinc-500">&middot; 0 reports filed</span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="browser-page">
              <div class="text-2xl font-semibold mb-4" style="color: #18181b;">Acme Bank &middot; Support</div>
              <div class="bg-zinc-100 rounded-lg p-4 max-w-md">
                <div class="flex items-start gap-3 mb-3">
                  <div class="w-8 h-8 rounded-full bg-violet-100 flex items-center justify-center text-violet-600 font-semibold">A</div>
                  <div class="flex-1">
