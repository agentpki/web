      <p class="mt-4 text-lg lg:text-xl text-[color:var(--color-text-muted)]">
        We're working with a small set of agent platforms, bot-defense vendors, and design partners on the
        v0.1 spec and reference implementations. Tell us who you are.
      </p>

      <form action="mailto:hello@agentpki.dev"
            method="POST"
            enctype="text/plain"
            class="mt-10 max-w-xl mx-auto grid sm:grid-cols-[1fr_auto] gap-3">
        <input
          name="email"
          type="email"
          required
          placeholder="you@company.com"
          class="px-4 py-3 rounded-lg bg-[color:var(--color-bg-elevated)] border border-[color:var(--color-border-bright)] focus:border-[color:var(--color-accent)] outline-none transition"
        />
        <select
          name="role"
          required
          class="px-4 py-3 rounded-lg bg-[color:var(--color-bg-elevated)] border border-[color:var(--color-border-bright)] focus:border-[color:var(--color-accent)] outline-none transition"
        >
          <option value="">I am a/an…</option>
          <option value="agent-platform">Agent platform</option>
          <option value="site">Website or API operator</option>
          <option value="bot-defense">Bot-defense vendor</option>
          <option value="enterprise">Enterprise agent fleet</option>
          <option value="other">Other</option>
        </select>
        <button
          type="submit"
          class="sm:col-span-2 px-5 py-3 rounded-lg bg-[color:var(--color-accent)] text-black font-medium hover:bg-[color:var(--color-accent-bright)] transition">
          Request early access
        </button>
      </form>

      <p class="mt-4 text-xs text-[color:var(--color-text-muted)]">
        We'll respond personally within 48&nbsp;hours.
      </p>
    </div>
  </section>

