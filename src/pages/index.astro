        </div>

        <!-- Problem card 3: blockchain trade-offs -->
        <div class="rounded-xl border border-blue-500/25 bg-blue-500/[0.03] p-7 relative overflow-hidden">
          <div class="absolute -top-12 -right-12 w-32 h-32 bg-blue-500/10 blur-3xl rounded-full pointer-events-none"></div>
