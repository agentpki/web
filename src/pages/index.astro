  .layer-card.layer-ops      { border-color: rgba(74, 222, 128, 0.4); background: linear-gradient(135deg, rgba(34, 197, 94, 0.08), rgba(74, 222, 128, 0.02)); }
  .layer-card.layer-consumer { border-color: rgba(251, 191, 36, 0.4); background: linear-gradient(135deg, rgba(245, 158, 11, 0.08), rgba(251, 191, 36, 0.02)); }

  .ship-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .ship-item {
    display: flex; align-items: flex-start; gap: 0.55rem;
    padding: 0.55rem 0.75rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 0.45rem;
    font-size: 0.875rem;
  }
  .ship-item-mark {
    color: #86efac; font-weight: 800;
