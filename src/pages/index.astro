  }
  .ship-item-text { flex: 1; color: var(--color-text); line-height: 1.4; }
  .ship-item-text strong { color: #ffffff; }
  .ship-item-meta {
    font-size: 0.7rem; color: var(--color-text-dim);
    font-family: ui-monospace, monospace;
